      "id": "a1",
      "name": "Webhook Lemon Squeezy",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "celebra-lemon-squeezy"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Verifica la firma de Lemon Squeezy y prepara los datos del pedido.\n// Requiere en el VPS: NODE_FUNCTION_ALLOW_BUILTIN=crypto\nconst crypto = require('crypto');\nconst SECRET = $env.LEMON_SIGNING_SECRET; // variable de entorno del VPS (no la pegues en el workflow)\n\nconst raw = await this.helpers.getBinaryDataBuffer(0, 'data');\nconst signature = String($input.first().json.headers['x-signature'] || '');\nconst digest = crypto.createHmac('sha256', SECRET).update(raw).digest('hex');\nconst valid = signature.length === digest.length &&\n  crypto.timingSafeEqual(Buffer.from(digest, 'utf8'), Buffer.from(signature, 'utf8'));\nif (!valid) {\n  // Firma inválida: se descarta sin procesar.\n  return [];\n}\n\nconst body = JSON.parse(raw.toString('utf8'));\nconst event = body.meta?.event_name;\nconst a = body.data?.attributes || {};\nif (event !== 'order_created' || a.status !== 'paid') {\n  return []; // solo pedidos pagados\n}\n\nconst email = String(a.user_email || '').trim().toLowerCase();\nconst custom = body.meta?.custom_data || {};\nreturn [{\n  json: {\n    fecha: a.created_at,\n    pedido: a.order_number,\n    identificador: a.identifier,\n    referencia: custom.ref || '',\n    pais: custom.country || '',\n    cliente: a.user_name || '',\n    email,\n    producto: a.first_order_item?.product_name || '',\n    variante: a.first_order_item?.variant_name || '',\n    total_usd: (a.total_usd ?? a.total ?? 0) / 100,\n    moneda: a.currency || 'USD',\n    metodo: 'Lemon Squeezy',\n    descuento_usd: (a.discount_total_usd ?? a.discount_total ?? 0) / 100,\n    email_hash: crypto.createHash('sha256').update(email).digest('hex'),\n    event_time: Math.floor(new Date(a.created_at || Date.now()).getTime() / 1000),\n  },\n}];"
      },
      "id": "a2",
      "name": "Verificar firma y preparar pedido",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        260,
        0
      ]
    },
