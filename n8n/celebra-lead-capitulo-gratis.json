    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Valida el formulario, filtra bots y prepara el lead con su código único.\n// Requiere en el VPS: NODE_FUNCTION_ALLOW_BUILTIN=crypto\nconst crypto = require('crypto');\nconst req = $input.first().json;\nconst body = req.body || {};\nconst key = String(req.headers?.['x-celebra-key'] || '');\nconst fail = (motivo) => [{ json: { valido: false, motivo } }];\n\nif (!$env.CELEBRA_FORM_KEY || key !== $env.CELEBRA_FORM_KEY) return fail('clave');\nif (body.empresa) return fail('bot'); // campo trampa oculto en el formulario\n\nconst email = String(body.email || '').trim().toLowerCase();\nconst nombre = String(body.nombre || '').trim().slice(0, 60);\nif (!/^[^\\s@]+@[^\\s@]+\\.[a-z]{2,}$/i.test(email) || email.length > 120) return fail('email');\nconst desechables = ['mailinator.com','tempmail.com','10minutemail.com','guerrillamail.com','yopmail.com','trashmail.com','temp-mail.org','getnada.com','sharklasers.com','dispostable.com'];\nif (desechables.includes(email.split('@')[1])) return fail('email_desechable');\n\n// Código: solo mayúsculas y números (regla de Lemon Squeezy), sin letras que se confunden.\nconst abc = 'ABCDEFGHJKMNPQRSTUVWXYZ23456789';\nconst bytes = crypto.randomBytes(6);\nlet sufijo = '';\nfor (const b of bytes) sufijo += abc[b % abc.length];\nconst codigo = 'FIESTA' + sufijo;\n\nconst horas = Number($env.LEAD_CODE_HOURS || 48);\nconst vence = new Date(Date.now() + horas * 3600 * 1000).toISOString();\nconst pais = ['VE', 'CL'].includes(body.pais) ? body.pais : 'OT';\nconst zona = { VE: 'America/Caracas', CL: 'America/Santiago' }[pais] || 'UTC';\n\nreturn [{ json: {\n  valido: true,\n  fecha: new Date().toISOString(),\n  nombre, email, pais, zona,\n  codigo,\n  descuento_usd: Number($env.LEAD_DISCOUNT_CENTS || 200) / 100,\n  vence,\n  origen: String(body.utm || '').slice(0, 120),\n  event_id: String(body.event_id || ('lead-' + crypto.randomUUID())),\n  email_hash: crypto.createHash('sha256').update(email).digest('hex'),\n} }];"
      },
