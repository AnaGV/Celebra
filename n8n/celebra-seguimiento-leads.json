    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Decide qué email le toca a cada lead. Corre cada hora.\n// seguimiento: 0 = recibió el capítulo · 1 = recibió el tip de la piñata · 2 = recibió el aviso de vencimiento\nconst ahora = Date.now();\nconst out = [];\nfor (const it of $input.all()) {\n  const r = it.json;\n  if (!r.email || r.compro === 'sí' || r.baja === 'sí') continue;\n  const horas = (ahora - new Date(r.fecha).getTime()) / 3600000;\n  const quedan = (new Date(r.vence).getTime() - ahora) / 3600000;\n  const paso = Number(r.seguimiento || 0);\n  if (r.estado === 'emitido' && quedan <= 0) {\n    out.push({ json: { ...r, accion: 'vencer', estado: 'vencido', enviar: false } });\n  } else if (r.estado === 'emitido' && paso === 0 && horas >= 20 && quedan > 10) {\n    out.push({ json: { ...r, accion: 'tip', seguimiento: '1', enviar: true } });\n  } else if (r.estado === 'emitido' && paso <= 1 && quedan > 0 && quedan <= 8) {\n    out.push({ json: { ...r, accion: 'vence', seguimiento: '2', enviar: true } });\n  }\n}\nreturn out;"
      },
      "id": "s3",
      "name": "¿Qué le toca a cada uno?",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
