    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// A quién pedirle opinión hoy: compraron hace 7 días o más y todavía no se les pidió.\n// Se le pide a TODAS las clientas, no solo a las contentas (regla de Google).\nconst ahora = Date.now();\nconst out = [];\nfor (const it of $input.all()) {\n  const r = it.json;\n  if (!r.email || r.opinion_pedida === 'sí') continue;\n  const dias = (ahora - new Date(r.fecha).getTime()) / 86400000;\n  if (dias >= 7 && dias < 30) out.push({ json: { ...r, nombre: String(r.cliente || '').split(' ')[0] } });\n}\nreturn out;"
      },
