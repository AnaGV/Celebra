{
  // Cloudflare Workers: página estática (dist) + API en worker/index.ts
  "name": "celebra",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/ref/*"]
  },
  "observability": { "enabled": true },
  // Fotos de referencia del formulario: se borran al abrirlas o a las 72 horas.
  "r2_buckets": [{ "binding": "FOTOS", "bucket_name": "celebra-fotos" }]
  // Los secretos (N8N_BASE_URL, CELEBRA_FORM_KEY, TURNSTILE_SECRET) se cargan en
  // Cloudflare > Workers > celebra > Configuración > Variables y secretos. Nunca aquí.
}
