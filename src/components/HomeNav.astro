---
import { site } from '../config/site';
const c = site.contact;
const star = 'M12 3v3M12 18v3M3 12h3M18 12h3M5.6 5.6l2.1 2.1M16.3 16.3l2.1 2.1M5.6 18.4l2.1-2.1M16.3 7.7l2.1-2.1';
const waPedido = `https://wa.me/${c.localWhatsapp}?text=${encodeURIComponent('¡Hola Celebra! Quiero cotizar para una fiesta.')}`;
const path = Astro.url.pathname;
const links = [
  ['/#fiestas', 'Fiestas'],
  ['/packs/', 'Packs'],
  ['/servicios/', 'Servicios'],
  ['/salones/', 'Salones'],
  ['/club/', 'Club'],
  ['/libro/', 'El libro'],
  ['/contacto/', 'Contacto'],
];
---

<script is:inline>if(!matchMedia('(prefers-reduced-motion: reduce)').matches)document.documentElement.classList.add('rvjs')</script>
<div class="rainbow" aria-hidden="true"></div>
<header class="h-nav">
  <div class="h-wrap h-nav-in">
    <a class="h-brand" href="/" aria-label="Celebra, inicio"><img src="/img/marca/logo.webp" width="1000" height="437" alt="Celebra · Artículos de fiesta" /></a>
    <nav class="h-links" aria-label="Secciones">
      {links.map(([href, label]) => <a href={href} aria-current={path === href ? 'page' : undefined}>{label}</a>)}
    </nav>
    <a class="h-btn h-btn-sm" href="/#reservar">Reservar fecha</a>
  </div>
  <nav class="h-chips" aria-label="Secciones">
    {links.map(([href, label]) => <a href={href}>{label}</a>)}
  </nav>
</header>
<a class="h-wa" href={waPedido} target="_blank" rel="noopener" aria-label="Escríbenos por WhatsApp">
  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20l1.3-4A8 8 0 1112 20a8 8 0 01-4-1.1z"></path></svg>
</a>

<script>
  // Aparecen suavemente al bajar (respeta "reducir movimiento").
  const els = document.querySelectorAll<HTMLElement>('.rv');
  if (!('IntersectionObserver' in window) || matchMedia('(prefers-reduced-motion: reduce)').matches) {
    els.forEach((e) => e.classList.add('in'));
  } else {
    const io = new IntersectionObserver((ents) => ents.forEach((en) => { if (en.isIntersecting) { en.target.classList.add('in'); io.unobserve(en.target); } }), { rootMargin: '0px 0px -8% 0px' });
    els.forEach((e) => io.observe(e));
  }
  // Oculta el botón flotante de WhatsApp mientras se ve un formulario (no tapa el botón de enviar).
  const wa = document.querySelector('.h-wa');
  const forms = document.querySelectorAll('.h-form');
  if (wa && forms.length && 'IntersectionObserver' in window) {
    const vis = new Set();
    const fo = new IntersectionObserver((ents) => { ents.forEach((en) => (en.isIntersecting ? vis.add(en.target) : vis.delete(en.target))); wa.classList.toggle('off', vis.size > 0); });
    forms.forEach((f) => fo.observe(f));
  }
</script>
