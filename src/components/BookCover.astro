---
/* Portada de EJEMPLO dibujada en SVG. Reemplázala por la portada real:
   <img src="/portada.webp" width="600" height="840" alt="Portada de ..." /> */
interface Props { class?: string }
const { class: className } = Astro.props;
const flags = Array.from({ length: 9 }, (_, i) => i);
const flagColors = ['#e8326e', '#f2b33d', '#2fa68a', '#4b6fd6', '#e8326e', '#f2b33d', '#2fa68a', '#4b6fd6', '#e8326e'];
---

<svg
  class={className}
  viewBox="0 0 300 420"
  role="img"
  aria-label="Portada de ejemplo del libro Fiestas que se recuerdan"
>
  <defs>
    <linearGradient id="cover-bg" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#1f5a4a" />
      <stop offset="1" stop-color="#143c32" />
    </linearGradient>
  </defs>
  <rect width="300" height="420" rx="6" fill="url(#cover-bg)" />
  <rect x="0" y="0" width="12" height="420" fill="#0f2e26" />

  <!-- guirnalda -->
  <path d="M12 46 Q156 92 300 46" fill="none" stroke="#f5efe0" stroke-width="1.5" />
  {
    flags.map((i) => {
      const x = 24 + i * 31;
      const t = (x - 12) / 288;
      const y = 46 + 4 * 23 * t * (1 - t);
      return <path d={`M${x - 11} ${y} L${x + 11} ${y} L${x} ${y + 24} Z`} fill={flagColors[i]} />;
    })
  }

  <!-- piñata estrella -->
  <g transform="translate(150 205)">
    <line x1="0" y1="-112" x2="0" y2="-62" stroke="#f5efe0" stroke-width="1.5" />
    <polygon
      points="0,-62 14,-22 56,-22 22,2 34,42 0,18 -34,42 -22,2 -56,-22 -14,-22"
      fill="#f2b33d"
    />
    <circle cx="0" cy="-6" r="16" fill="#e8326e" />
    <path d="M-30 42 l-6 26 M-14 46 l-2 24 M14 46 l2 24 M30 42 l6 26" stroke="#e8326e" stroke-width="5" stroke-linecap="round" />
  </g>

  <text x="150" y="318" text-anchor="middle" fill="#f5efe0" font-family="'Young Serif', Georgia, serif" font-size="27">Fiestas que</text>
  <text x="150" y="350" text-anchor="middle" fill="#f5efe0" font-family="'Young Serif', Georgia, serif" font-size="27">se recuerdan</text>
  <text x="150" y="376" text-anchor="middle" fill="#f2b33d" font-family="'IBM Plex Mono', monospace" font-size="10" letter-spacing="1.5">GUÍA PRÁCTICA PARA CELEBRAR</text>
  <text x="150" y="402" text-anchor="middle" fill="#cfe3db" font-family="'Atkinson Hyperlegible', sans-serif" font-size="11">Nombre de la autora</text>
</svg>
