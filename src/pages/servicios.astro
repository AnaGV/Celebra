---
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';
import HomeNav from '../components/HomeNav.astro';
import '../styles/home.css';
import { site } from '../config/site';
import { servicios } from '../config/celebra';
import { CATEGORIAS } from '../config/directorio';
const c = site.contact;
const wa = (t: string) => `https://wa.me/${c.localWhatsapp}?text=${encodeURIComponent(t)}`;
const propios = servicios.filter((s) => s.kind === 'propio');
const aliados = servicios.filter((s) => s.kind === 'aliado');
---

<Base image="/img/og-celebra.jpg" title="Servicios para fiestas en Caripe · Celebra" description="Piñatas, chupeteras, decoración, invitaciones digitales y recuerdos hechos en el taller Celebra, más tortas, sonido y mobiliario de proveedores aliados de Caripe.">
  <div class="home">
    <HomeNav />
    <main>
      <section class="h-wrap h-top">
        <div class="h-top-head rv">
          <span class="h-kicker">Servicios</span>
          <h1>Todo para tu fiesta, <em>en un solo lugar</em></h1>
          <p class="h-lead">Lo que hacemos a mano en el taller, y los proveedores de Caripe que trabajan con nosotras para que no tengas que buscar por todos lados.</p>
        </div>
      </section>

      <section class="h-sec h-wrap" style="padding-top:24px" aria-labelledby="t-prop">
        <div class="h-head rv"><span class="h-kicker">Hecho en el taller</span><h2 id="t-prop">Lo hacemos nosotras</h2></div>
        <div class="h-servs">
          {propios.map((s, i) => (
            <div class="h-serv rv" style={`--d:${(i % 4) * 60}ms`}>
              <span class="h-serv-ico"><svg viewBox="0 0 24 24" aria-hidden="true"><path d={s.icon}></path></svg></span>
              <div><b>{s.name}</b><p>{s.desc}</p><a class="h-link" style="font-size:14px" href={wa(`¡Hola Celebra! Quiero cotizar: ${s.name.toLowerCase()}.`)} target="_blank" rel="noopener">Cotizar</a></div>
            </div>
          ))}
        </div>
      </section>

      <section class="h-sec h-wrap" aria-labelledby="t-ali">
        <div class="h-head rv"><span class="h-kicker" style="color:#0f6fa3">Proveedores aliados</span><h2 id="t-ali">Con nuestros aliados de Caripe</h2><p id="ali-intro">Te ponemos en contacto con proveedores de confianza. Escríbenos y te recomendamos según tu fecha.</p></div>
        <!-- Aliados reales (los mismos del Directorio): se cargan de /api/aliados. Si hay, reemplazan la lista genérica. -->
        <ul class="h-dir-grid" id="ali-list" hidden></ul>
        <p class="h-ali-mas" id="ali-mas" hidden>¿Buscas otro servicio? Mira el <a class="h-link" href="/directorio/">directorio de Caripe</a> o <a class="h-link" href={wa('¡Hola Celebra! Busco un proveedor para una fiesta.')} target="_blank" rel="noopener">pídenos una recomendación</a>.</p>
        <script type="application/json" id="ali-cats" set:html={JSON.stringify(CATEGORIAS)}></script>

<script>
  // Aliados con reserva en línea: los mismos que salen en el Directorio.
  type Cat = { id: string; nombre: string; icono: string };
  const cats: Record<string, Cat> = Object.fromEntries((JSON.parse(document.getElementById('ali-cats')!.textContent || '[]') as Cat[]).map((k) => [k.id, k]));
  const el = <K extends keyof HTMLElementTagNameMap>(tag: K, cls?: string, txt?: string) => { const e = document.createElement(tag); if (cls) e.className = cls; if (txt != null) e.textContent = txt; return e; };
  function tarjeta(a: any) {
    const li = el('li', 'h-dir-card');
    const tags = el('div', 'h-dir-tags');
    for (const id of a.categorias || []) { const k = cats[id]; if (k) tags.append(el('span', 'h-dir-tag', `${k.icono} ${k.nombre}`)); }
    tags.append(el('span', 'h-dir-tag h-dir-al', '✓ Aliado · reserva en línea'));
    let titulo: HTMLElement = el('h3', '', a.nombre);
    if (a.fotos && a.fotos[0]) { const im = el('img', 'h-dir-foto') as HTMLImageElement; im.src = a.fotos[0]; im.alt = ''; im.loading = 'lazy'; const h = el('div', 'h-dir-head'); h.append(im, titulo); titulo = h; }
    li.append(tags, titulo, el('p', 'h-dir-desc', a.descripcion || ''));
    if (a.zona) li.append(el('p', 'h-dir-zona', '📍 ' + a.zona));
    const acc = el('div', 'h-dir-acc');
    const r = el('a', 'h-btn h-dir-wa', 'Ver disponibilidad y reservar') as HTMLAnchorElement;
    r.href = '/reservar/?a=' + encodeURIComponent(a.id); acc.append(r);
    if (a.instagram) { const i = el('a', 'h-btn h-btn-line', 'Instagram') as HTMLAnchorElement; i.href = `https://instagram.com/${String(a.instagram).replace('@', '')}`; i.target = '_blank'; i.rel = 'noopener'; acc.append(i); }
    if (a.placeId) { const m = el('a', 'h-dir-maps', 'Ver reseñas en Google Maps') as HTMLAnchorElement; m.href = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(a.nombre + ' Caripe')}&query_place_id=${a.placeId}`; m.target = '_blank'; m.rel = 'noopener'; acc.append(m); }
    li.append(acc);
    return li;
  }
  fetch('/api/aliados').then((r) => r.json()).then((d) => {
    const al = (d.aliados || []) as any[];
    if (!al.length) return; // sin aliados todavía: queda la lista genérica con "Pedir recomendación"
    const lista = document.getElementById('ali-list')!;
    lista.replaceChildren(...al.map(tarjeta));
    lista.hidden = false;
    document.getElementById('ali-generico')!.hidden = true;
    document.getElementById('ali-mas')!.hidden = false;
    document.getElementById('ali-intro')!.textContent = 'Proveedores de Caripe que trabajan con nosotras. Mira su disponibilidad y reserva en línea.';
  }).catch(() => {});
</script>
        <div class="h-servs" id="ali-generico">
          {aliados.map((s, i) => (
            <div class="h-serv rv" style={`--d:${(i % 4) * 60}ms`}>
              <span class="h-serv-ico aliado"><svg viewBox="0 0 24 24" aria-hidden="true"><path d={s.icon}></path></svg></span>
              <div><b>{s.name}</b><p>{s.desc}</p><a class="h-link" style="font-size:14px" href={wa(`¡Hola Celebra! Busco ${s.name.toLowerCase()} para una fiesta.`)} target="_blank" rel="noopener">Pedir recomendación</a></div>
            </div>
          ))}
        </div>
      </section>

      <section class="h-sec h-wrap" aria-labelledby="t-unete">
        <div class="h-res rv" style="background:#e3f5ff">
          <div class="h-res-info">
            <span class="h-kicker" style="color:#0f6fa3">Aliados Celebra</span>
            <h2 id="t-unete">¿Quieres ser aliado de Celebra?</h2>
            <p class="h-lead" style="font-size:18px">Si tienes un negocio de fiestas en Caripe o sus alrededores, únete a nuestros aliados. Te mandamos clientes con nuestra publicidad, ellos reservan contigo en línea según tu disponibilidad y te pagan directo a ti. Tú manejas tus reservas desde tu propio panel.</p>
            <ul class="h-ali-pts">
              <li>Reservas en línea con tu calendario</li>
              <li>El cliente te paga directo a ti</li>
              <li>Empezar es gratis</li>
            </ul>
            <p class="h-ali-nota">Las piñatas, arreglos, globos, cotillón y papelería los hacemos nosotras en el taller. Por eso buscamos aliados que complementen lo nuestro. Revisamos cada solicitud y te escribimos por WhatsApp.</p>
          </div>
          <form class="h-form" id="pub-form" novalidate>
            <label>Nombre del negocio<input type="text" name="negocio" required /></label>
            <label>Tipo de negocio
              <select name="tipo" required>
                <option value="">Elige uno</option>
                {CATEGORIAS.map((k) => <option value={k.nombre}>{k.id === 'decoracion' ? 'Decoración de eventos (montaje completo)' : k.nombre}</option>)}
                <option value="Otro servicio">Otro servicio</option>
              </select>
            </label>
            <label id="deco-tipo" hidden>¿Qué tipo de decoración haces?<input type="text" name="decoracion" placeholder="Ej. Montaje completo: mesas, telas, arcos, fondos" /></label>
            <label>Qué servicios ofreces<input type="text" name="servicio" placeholder="Ej. Sonido para 8 horas, luces, animador" /></label>
            <label>¿Dónde trabajas?<input type="text" name="zona" value="Caripe" placeholder="Ej. Caripe, Teresén, El Guácharo" required /></label>
            <fieldset class="h-ali-modo">
              <legend>¿Cómo atiendes al cliente?</legend>
              <label><input type="radio" name="modo" value="Voy a donde es la fiesta" required /><span>Voy a donde es la fiesta <small>(ej. sonido, animación)</small></span></label>
              <label><input type="radio" name="modo" value="El cliente retira en mi local" /><span>El cliente retira en mi local <small>(ej. tortas, pasapalos)</small></span></label>
              <label><input type="radio" name="modo" value="Las dos" /><span>Las dos</span></label>
            </fieldset>
            <label><span>Instagram <span class="h-opt">(opcional)</span></span><input type="text" name="instagram" placeholder="@tunegocio" autocapitalize="off" /></label>
            <label>Tu nombre<input type="text" name="nombre" autocomplete="name" required /></label>
            <button class="h-btn" type="submit">Quiero ser aliado</button>
            <p class="h-form-err" role="alert" hidden></p>
          </form>
        </div>
      </section>
    </main>
    <Footer />
  </div>
</Base>

<script define:vars={{ waNum: c.localWhatsapp }}>
  const f = document.getElementById('pub-form');
  const deco = document.getElementById('deco-tipo');
  f.tipo.addEventListener('change', () => { deco.hidden = f.tipo.value !== 'Decoración de eventos'; if (!deco.hidden) deco.querySelector('input').focus(); });
  f.addEventListener('submit', (e) => {
    e.preventDefault();
    const d = Object.fromEntries(new FormData(f));
    const err = f.querySelector('.h-form-err');
    const esDeco = d.tipo === 'Decoración de eventos';
    if (!String(d.negocio).trim() || !d.tipo || !String(d.nombre).trim() || (esDeco && !String(d.decoracion || '').trim()) || !String(d.zona || '').trim() || !d.modo) {
      err.textContent = esDeco && !String(d.decoracion || '').trim() ? 'Cuéntanos qué tipo de decoración haces.' : 'Completa el nombre del negocio, el tipo, dónde trabajas, cómo atiendes y tu nombre.';
      err.hidden = false; return;
    }
    err.hidden = true;
    const ig = String(d.instagram || '').trim();
    const txt = `¡Hola Celebra! Quiero ser aliado.\n• Negocio: ${d.negocio}\n• Tipo: ${d.tipo}${esDeco ? ' (' + String(d.decoracion).trim() + ')' : ''}\n• Servicios: ${String(d.servicio || '').trim() || '-'}\n• Dónde trabaja: ${String(d.zona).trim()}\n• Cómo atiende: ${d.modo}\n• Instagram: ${ig ? '@' + ig.replace(/^@/, '') : '-'}\n• Mi nombre: ${d.nombre}`;
    window.open(`https://wa.me/${waNum}?text=${encodeURIComponent(txt)}`, '_blank', 'noopener');
  });
</script>
