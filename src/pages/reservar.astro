---
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';
import HomeNav from '../components/HomeNav.astro';
import '../styles/home.css';
import TelInput from '../components/TelInput.astro';
---

<Base image="/img/og-celebra.jpg" title="Reservar con un aliado · Celebra" description="Mira la disponibilidad de los proveedores de fiestas de Caripe y reserva directo por WhatsApp.">
  <div class="home">
    <HomeNav />
    <main class="h-wrap h-rsv" id="res">
      <p class="h-res-load" id="res-load">Cargando…</p>

      <div id="res-app" hidden>
        <a class="h-link h-res-back" href="/salones/">← Volver al directorio</a>
        <section class="h-res-head">
          <div class="h-res-fotos" id="r-fotos"></div>
          <div>
            <span class="h-kicker" id="r-cat"></span>
            <h1 id="r-nombre"></h1>
            <p class="h-res-desc" id="r-desc"></p>
            <p class="h-res-zona" id="r-zona"></p>
            <p class="h-res-aviso">Celebra te conecta con este aliado. El pago y la confirmación los maneja directamente el aliado.</p>
          </div>
        </section>

        <form class="h-res-form" id="r-form" novalidate>
          <fieldset>
            <legend><span>1</span> ¿Qué necesitas?</legend>
            <ul class="h-res-serv" id="r-serv"></ul>
          </fieldset>

          <fieldset>
            <legend><span>2</span> ¿Qué día?</legend>
            <div class="h-cal" id="r-cal" hidden>
              <div class="h-cal-top"><button type="button" class="h-cal-nav" data-d="-1" aria-label="Mes anterior">‹</button><b id="r-mes"></b><button type="button" class="h-cal-nav" data-d="1" aria-label="Mes siguiente">›</button></div>
              <div class="h-cal-sem"><span>L</span><span>M</span><span>M</span><span>J</span><span>V</span><span>S</span><span>D</span></div>
              <div class="h-cal-grid" id="r-grid"></div>
              <p class="h-cal-ley"><i class="ok"></i> Disponible <i class="parcial"></i> Quedan pocas horas <i class="lleno"></i> Lleno <i class="no"></i> No trabaja</p>
            </div>
            <label class="h-res-fecha" id="r-fecha-libre" hidden>Fecha de la fiesta<input type="date" name="fecha" /></label>
            <p class="h-res-sel" id="r-sel" hidden></p>
          </fieldset>

          <fieldset id="r-horaset">
            <legend><span>3</span> ¿A qué hora empieza?</legend>
            <p class="h-res-fine" id="r-hora-ayuda">Primero elige el día.</p>
            <div class="h-res-horas" id="r-horas"></div>
            <p class="h-res-fin" id="r-fin" hidden></p>
            <div class="h-res-lleno" id="r-lleno" hidden>
              <p id="r-lleno-txt"></p>
            </div>
            <label class="h-res-extra" id="r-extra" hidden><input type="checkbox" id="r-consulta" /> <span id="r-extra-txt">Quiero pedirle una hora extra o un horario especial</span></label>
          </fieldset>

          <fieldset>
            <legend><span>4</span> Tus datos</legend>
            <div class="h-form-2">
              <label>Tu nombre<input type="text" name="nombre" autocomplete="name" required /></label>
              <TelInput name="whatsapp" label="Tu WhatsApp" id="r-tel" required />
            </div>
            <label id="r-dir">¿Dónde es la fiesta? <small>(dirección o sector y un punto de referencia)</small><input type="text" name="direccion" maxlength="160" autocomplete="street-address" placeholder="Ej. Urb. Los Pinos, casa 12, frente a la plaza" /></label>
            <div class="h-form-2">
              <label>Invitados (aprox.)<input type="number" name="invitados" min="0" inputmode="numeric" /></label>
              <label>Nota para el aliado <small>(opcional)</small><input type="text" name="nota" maxlength="300" placeholder="Tema, edad, detalles…" /></label>
            </div>
          </fieldset>

          <fieldset id="r-pagoset">
            <legend><span>5</span> Pago</legend>
            <p class="h-res-total">Total estimado: <b id="r-total">$0</b></p>
            <div class="h-res-metodos" id="r-metodos"></div>
            <div class="h-res-pago" id="r-pago" hidden></div>
            <div class="h-res-comprobante" id="r-comp" hidden>
              <label>Número de referencia<input type="text" name="referencia" maxlength="40" placeholder="Ej. 004512" /></label>
              <label class="h-res-file">Captura del pago <small>(se borra cuando el aliado la descarga, o a las 24 horas)</small>
                <input type="file" accept="image/*" id="r-file" />
              </label>
              <p class="h-res-fileok" id="r-fileok" hidden></p>
            </div>
          </fieldset>

          <input type="text" name="empresa" tabindex="-1" autocomplete="off" aria-hidden="true" class="h-hp" />
          <p class="h-form-err" role="alert" hidden></p>
          <button class="h-btn h-dir-wa h-res-go" type="submit">Enviar reserva por WhatsApp</button>
          <p class="h-res-fine" id="r-fine"></p>
        </form>

        <div class="h-res-ok" id="r-ok" hidden>
          <b>¡Listo! Tu solicitud está apartada 🎉</b>
          <p id="r-ok-txt"></p>
          <a class="h-btn h-dir-wa" id="r-ok-wa" href="#" target="_blank" rel="noopener">Enviar al aliado por WhatsApp</a>
          <p class="h-res-fine">Importante: toca el botón y luego <b>Enviar</b> en WhatsApp para que el aliado reciba tu solicitud.</p>
        </div>
      </div>

      <div id="res-404" hidden><h1>No encontramos este aliado</h1><p><a class="h-link" href="/salones/">Volver al directorio</a></p></div>
    </main>
    <Footer />
  </div>
</Base>

<script>
  import { montarTel } from '../lib/telefono';
  import { detectCountry } from '../lib/country';
  import { cabe, horasLibres, horaTxt, diaSemana, duracionDe, subtotal, pedidoMinimo, PASO, type ServicioAg, type Horario, type Ocupa, type Pedido } from '../lib/agenda';
  montarTel();
  if (detectCountry() === 'CL') { const s = document.querySelector<HTMLSelectElement>('#r-tel [data-tel-cc]'); if (s) s.value = '56'; }
  const $ = <T extends HTMLElement>(s: string) => document.querySelector<T>(s)!;
  const id = new URLSearchParams(location.search).get('a') || '';
  const MESES = ['enero', 'febrero', 'marzo', 'abril', 'mayo', 'junio', 'julio', 'agosto', 'septiembre', 'octubre', 'noviembre', 'diciembre'];
  let A: any, S: ServicioAg[] = [], HOR: Horario, ocupado: Record<string, Ocupa[]> = {}, bloqueados: string[] = [], hoy = '', mes = '', fecha = '', hora: number | null = null, metodo = '', captura = '';
  const sel: Record<string, Pedido> = {};
  const el = (t: string, c?: string, x?: string) => { const e = document.createElement(t); if (c) e.className = c; if (x != null) e.textContent = x; return e; };
  const usd = (n: number) => '$' + (Math.round(n * 100) / 100).toLocaleString('es-VE');
  const pedido = () => Object.values(sel).filter((p) => p.cant > 0);
  const consulta = () => $<HTMLInputElement>('#r-consulta').checked;

  async function cargarMes(m: string) {
    const r = await fetch(`/api/aliados/${encodeURIComponent(id)}?mes=${m}`);
    if (!r.ok) throw new Error('404');
    const d = await r.json(); A = d.aliado; S = A.servicios; HOR = A.horario; ocupado = d.ocupado || {}; bloqueados = d.bloqueados || []; hoy = d.hoy; mes = m;
  }

  /** no = no trabaja / pasado; lleno = trabaja pero no cabe lo elegido; parcial = ya tiene reservas; ok */
  function estadoDia(f: string) {
    if (f < hoy || bloqueados.includes(f) || !HOR.dias.includes(diaSemana(f))) return 'no';
    const occ = ocupado[f] || [];
    const ped = pedido();
    const libre = ped.length ? horasLibres(S, HOR, occ, ped).length > 0 : S.some((s) => horasLibres(S, HOR, occ, [pedidoMinimo(s)]).length > 0);
    if (!libre) return 'lleno';
    return occ.length ? 'parcial' : 'ok';
  }

  function pintarCal() {
    const [y, m] = mes.split('-').map(Number);
    $('#r-mes').textContent = `${MESES[m - 1]} ${y}`;
    const g = $('#r-grid'); g.replaceChildren();
    const primero = (new Date(Date.UTC(y, m - 1, 1)).getUTCDay() + 6) % 7;
    const dias = new Date(Date.UTC(y, m, 0)).getUTCDate();
    for (let i = 0; i < primero; i++) g.append(el('span'));
    for (let d = 1; d <= dias; d++) {
      const f = `${mes}-${String(d).padStart(2, '0')}`; const st = estadoDia(f);
      const b = el('button', `h-cal-d ${st}${f === fecha ? ' sel' : ''}`, String(d)) as HTMLButtonElement;
      b.type = 'button'; b.disabled = st === 'no';
      b.setAttribute('aria-label', `${d} de ${MESES[m - 1]}${st === 'no' ? ', no disponible' : st === 'lleno' ? ', lleno' : ''}`);
      b.addEventListener('click', () => { fecha = f; hora = null; pintarCal(); pintarSel(); pintarHoras(); });
      g.append(b);
    }
    (document.querySelector('.h-cal-nav[data-d="-1"]') as HTMLButtonElement).disabled = mes <= hoy.slice(0, 7);
  }
  function pintarSel() {
    const s = $('#r-sel');
    if (!fecha) { s.hidden = true; return; }
    const d = new Date(fecha + 'T12:00:00Z');
    s.hidden = false; s.textContent = `Día elegido: ${d.toLocaleDateString('es-VE', { weekday: 'long', day: 'numeric', month: 'long', timeZone: 'UTC' })}`;
  }

  function finDe(h: number) {
    const durs = pedido().map((p) => duracionDe(S.find((s) => s.id === p.id)!, p)).filter((x): x is number => x != null);
    return durs.length ? h + Math.max(...durs) : null;
  }
  function pintarHoras() {
    const box = $('#r-horas'), ayuda = $('#r-hora-ayuda'), lleno = $('#r-lleno'), extra = $('#r-extra'), fin = $('#r-fin');
    box.replaceChildren(); lleno.hidden = true; fin.hidden = true;
    if (!fecha) { ayuda.hidden = false; ayuda.textContent = 'Primero elige el día.'; extra.hidden = true; return; }
    const ped = pedido();
    if (!ped.length) { ayuda.hidden = false; ayuda.textContent = 'Primero elige qué necesitas (paso 1).'; extra.hidden = true; return; }
    ayuda.hidden = true; extra.hidden = false;
    const occ = A.calendario ? ocupado[fecha] || [] : [];
    const libres = new Set(A.calendario ? horasLibres(S, HOR, occ, ped) : []);
    let alguna = false;
    for (let h = HOR.desde; h < HOR.hasta; h += PASO) {
      const ok = A.calendario ? libres.has(h) : !cabe(S, HOR, [], ped, h);
      if (!A.calendario && !ok) continue;
      alguna ||= ok;
      const b = el('button', 'h-res-h' + (h === hora ? ' on' : ''), horaTxt(h)) as HTMLButtonElement; b.type = 'button'; b.disabled = !ok || consulta();
      if (!ok) b.title = 'Ocupado';
      b.addEventListener('click', () => { hora = h; pintarHoras(); });
      box.append(b);
    }
    if (hora != null && !libres.has(hora) && A.calendario) hora = null;
    if (hora != null) { const f = finDe(hora); if (f) { fin.hidden = false; fin.textContent = `Empieza a las ${horaTxt(hora)} y termina a las ${horaTxt(f)}`; } }
    if (!alguna) {
      lleno.hidden = false;
      $('#r-lleno-txt').textContent = `Ese día ${A.nombre} ya no tiene horarios libres para lo que elegiste.`;
      $('#r-extra-txt').textContent = `Quiero preguntarle a ${A.nombre} si puede hacer una hora extra para mí`;
    } else $('#r-extra-txt').textContent = '¿No ves la hora que necesitas? Quiero pedirle un horario especial';
  }

  function total() { return pedido().reduce((t, p) => t + subtotal(S.find((s) => s.id === p.id)!, p), 0); }
  function cambio() { $('#r-total').textContent = usd(total()); if (metodo) pintarPago(); if (A.calendario) pintarCal(); pintarHoras(); }

  function pintarServicios() {
    const ul = $('#r-serv'); ul.replaceChildren();
    for (const s of S) {
      const p: Pedido = (sel[s.id] ||= { id: s.id, cant: 0, horas: s.minHoras });
      const li = el('li', 'h-res-s');
      const info = el('div');
      const precio = s.tipo === 'hora' ? `${usd(s.precio)} por hora${s.minHoras > 1 ? ` · mínimo ${s.minHoras} horas` : ''}`
        : s.tipo === 'evento' ? `${usd(s.precio)} por evento · ${s.duracion} ${s.duracion === 1 ? 'hora' : 'horas'}`
        : `${usd(s.precio)} por ${s.unidad}`;
      info.append(el('b', '', s.nombre), el('span', '', precio));
      const ctl = el('div', 'h-res-q');
      const menos = el('button', '', '−') as HTMLButtonElement, mas = el('button', '', '+') as HTMLButtonElement;
      menos.type = mas.type = 'button';
      const out = el('output');
      const etiqueta = () => s.tipo === 'hora' ? (p.cant ? `${p.horas} h` : '0 h') : s.tipo === 'unidad' ? `${p.cant} ${s.unidad}` : String(p.cant);
      const pintar = () => { out.textContent = etiqueta(); li.classList.toggle('on', p.cant > 0); menos.disabled = p.cant === 0; };
      const maxH = Math.floor((HOR.hasta - HOR.desde) / 60);
      if (s.tipo === 'hora') {
        mas.addEventListener('click', () => { if (!p.cant) { p.cant = 1; p.horas = s.minHoras; } else p.horas = Math.min(maxH, p.horas + 1); pintar(); cambio(); });
        menos.addEventListener('click', () => { if (p.horas > s.minHoras) p.horas--; else p.cant = 0; pintar(); cambio(); });
        menos.setAttribute('aria-label', 'Menos horas de ' + s.nombre); mas.setAttribute('aria-label', 'Más horas de ' + s.nombre);
      } else {
        const tope = s.cantidad;
        mas.addEventListener('click', () => { p.cant = Math.min(tope, p.cant + 1); pintar(); cambio(); });
        menos.addEventListener('click', () => { p.cant = Math.max(0, p.cant - 1); pintar(); cambio(); });
        menos.setAttribute('aria-label', 'Quitar ' + s.nombre); mas.setAttribute('aria-label', 'Agregar ' + s.nombre);
      }
      ctl.append(menos, out, mas); li.append(info, ctl);
      if (s.tipo === 'unidad' && s.cantidad > 20) {
        const n = el('input', 'h-res-num') as HTMLInputElement; n.type = 'number'; n.min = '0'; n.max = String(s.cantidad); n.inputMode = 'numeric'; n.placeholder = 'Escribe la cantidad';
        n.addEventListener('input', () => { p.cant = Math.max(0, Math.min(s.cantidad, Math.round(Number(n.value) || 0))); pintar(); cambio(); });
        li.append(n);
      }
      pintar(); ul.append(li);
    }
  }

  function pintarMetodos() {
    const box = $('#r-metodos'); box.replaceChildren();
    const ops: [string, string][] = [];
    if (A.pago.pagoMovil) ops.push(['pagomovil', 'Pago Móvil']);
    if (A.pago.binance) ops.push(['binance', 'Binance']);
    ops.push(['despues', 'Coordinar el pago por WhatsApp']);
    for (const [v, t] of ops) {
      const l = el('label', 'h-res-m'); const r = el('input') as HTMLInputElement; r.type = 'radio'; r.name = 'metodo'; r.value = v;
      r.addEventListener('change', () => { metodo = v; pintarPago(); }); l.append(r, document.createTextNode(' ' + t)); box.append(l);
    }
    if (A.pago.nota) box.append(el('p', 'h-res-fine', A.pago.nota));
  }
  function copiaBtn(valor: string) {
    const b = el('button', 'h-res-copy', 'Copiar') as HTMLButtonElement; b.type = 'button';
    b.addEventListener('click', async () => { try { await navigator.clipboard.writeText(valor); b.textContent = 'Copiado ✓'; setTimeout(() => (b.textContent = 'Copiar'), 1500); } catch {} });
    return b;
  }
  function fila(k: string, v: string) { const p = el('p'); p.append(el('span', '', k), el('b', '', v), copiaBtn(v)); return p; }
  function pintarPago() {
    const p = $('#r-pago'), comp = $('#r-comp');
    p.replaceChildren(); p.hidden = metodo === 'despues' || !metodo; comp.hidden = p.hidden;
    if (metodo === 'pagomovil') { const pm = A.pago.pagoMovil; p.append(el('h3', '', `Paga ${usd(total())} por Pago Móvil a ${A.nombre}`), fila('Banco', pm.banco), fila('Teléfono', pm.telefono), fila('Cédula / RIF', pm.cedula), el('p', 'h-res-fine', 'Calcula los bolívares con la tasa del día que te indique el aliado.')); }
    if (metodo === 'binance') { p.append(el('h3', '', `Paga ${usd(total())} en USDT por Binance a ${A.nombre}`), fila('Binance Pay ID / correo', A.pago.binance.id)); }
  }
  function modoConsulta() {
    const c = consulta();
    $('#r-pagoset').hidden = c;
    $<HTMLButtonElement>('.h-res-go').textContent = c ? 'Enviar consulta por WhatsApp' : 'Enviar reserva por WhatsApp';
    $('#r-fine').textContent = c ? `No apartamos nada: le preguntas directo a ${A.nombre} y ustedes se coordinan por WhatsApp.` : A.calendario ? 'Al enviar, apartamos la hora 24 horas mientras el aliado verifica tu pago.' : 'El aliado te confirmará la disponibilidad por WhatsApp.';
    pintarHoras();
  }
  $<HTMLInputElement>('#r-consulta').addEventListener('change', modoConsulta);

  async function achicar(f: File): Promise<Blob> {
    const img = await createImageBitmap(f); const k = Math.min(1, 1600 / Math.max(img.width, img.height));
    const c = document.createElement('canvas'); c.width = Math.round(img.width * k); c.height = Math.round(img.height * k);
    c.getContext('2d')!.drawImage(img, 0, 0, c.width, c.height);
    return await new Promise((ok) => c.toBlob((b) => ok(b!), 'image/jpeg', 0.82));
  }
  $<HTMLInputElement>('#r-file').addEventListener('change', async (e) => {
    const f = (e.target as HTMLInputElement).files?.[0]; const st = $('#r-fileok'); captura = '';
    if (!f) { st.hidden = true; return; }
    st.hidden = false; st.textContent = 'Subiendo captura…';
    try {
      const b = await achicar(f); const r = await fetch('/api/foto', { method: 'POST', headers: { 'content-type': 'image/jpeg' }, body: b });
      const d = await r.json(); if (!r.ok) throw new Error(d.error);
      captura = d.url; st.textContent = '✓ Captura lista';
    } catch { st.textContent = 'No pudimos subir la captura. Intenta con otra imagen.'; }
  });

  document.querySelectorAll<HTMLButtonElement>('.h-cal-nav').forEach((b) => b.addEventListener('click', async () => {
    const [y, m] = mes.split('-').map(Number); const d = new Date(Date.UTC(y, m - 1 + Number(b.dataset.d), 1));
    await cargarMes(d.toISOString().slice(0, 7)); pintarCal();
  }));
  $<HTMLInputElement>('#r-fecha-libre input').addEventListener('change', (e) => { fecha = (e.target as HTMLInputElement).value; hora = null; pintarHoras(); });

  $<HTMLFormElement>('#r-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const f = e.target as HTMLFormElement, fd = new FormData(f), err = f.querySelector<HTMLElement>('.h-form-err')!;
    const c = consulta();
    const items = pedido().map((p) => ({ id: p.id, cant: p.cant, horas: p.horas }));
    const esLugar = (A.categorias || []).includes('lugares');
    const falta: string[] = [];
    if (!items.length) falta.push('elegir qué necesitas');
    if (!fecha) falta.push('elegir el día');
    if (!c && hora == null) falta.push('elegir la hora');
    if (!String(fd.get('nombre') || '').trim()) falta.push('tu nombre');
    if (String(fd.get('whatsapp') || '').replace(/\D/g, '').length < 10) falta.push('tu WhatsApp');
    if (!esLugar && !String(fd.get('direccion') || '').trim()) falta.push('la dirección de la fiesta');
    if (!c && !metodo) falta.push('elegir cómo pagas');
    if (falta.length) { err.textContent = 'Falta ' + falta.join(', ') + '.'; err.hidden = false; return; }
    err.hidden = true;
    const btn = f.querySelector<HTMLButtonElement>('.h-res-go')!; btn.disabled = true; btn.textContent = c ? 'Preparando tu mensaje…' : 'Apartando la hora…';
    try {
      const r = await fetch(`/api/aliados/${encodeURIComponent(id)}/reserva`, { method: 'POST', headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ fecha, hora, consulta: c, items, nombre: fd.get('nombre'), whatsapp: fd.get('whatsapp'), direccion: fd.get('direccion'), invitados: fd.get('invitados'), nota: fd.get('nota'), metodo, referencia: fd.get('referencia'), captura, empresa: fd.get('empresa') }) });
      const d = await r.json(); if (!r.ok) throw new Error(d.error || 'No pudimos apartar la hora.');
      $('#r-ok b').textContent = c ? '¡Listo! Tu consulta está preparada' : '¡Listo! Tu solicitud está apartada 🎉';
      $('#r-ok-txt').textContent = c
        ? `Envíale el mensaje a ${A.nombre} (código ${d.id}). Él te responde por WhatsApp si puede hacer la hora extra.`
        : d.apartadaHasta
          ? `Apartamos la hora por 24 horas (código ${d.id}). Envíale la solicitud a ${A.nombre}: cuando verifique tu pago, la reserva queda confirmada y te escribe.`
          : `Envíale la solicitud a ${A.nombre} (código ${d.id}). Te responderá por WhatsApp para confirmar.`;
      const wa = $<HTMLAnchorElement>('#r-ok-wa'); wa.href = d.wa;
      f.hidden = true; $('#r-ok').hidden = false; $('#r-ok').scrollIntoView({ block: 'center' });
      if (matchMedia('(pointer: coarse)').matches) location.href = d.wa; else window.open(d.wa, '_blank', 'noopener');
    } catch (x) { err.textContent = (x as Error).message; err.hidden = false; await cargarMes(mes); pintarCal(); pintarHoras(); }
    btn.disabled = false; btn.textContent = c ? 'Enviar consulta por WhatsApp' : 'Enviar reserva por WhatsApp';
  });

  (async () => {
    try { await cargarMes(new Date(Date.now() - 4 * 3600e3).toISOString().slice(0, 7)); }
    catch { $('#res-load').hidden = true; $('#res-404').hidden = false; return; }
    document.title = `Reservar con ${A.nombre} · Celebra`;
    $('#r-nombre').textContent = A.nombre; $('#r-desc').textContent = A.descripcion; $('#r-zona').textContent = A.zona ? '📍 ' + A.zona : '';
    $('#r-cat').textContent = 'Aliado de Celebra';
    const fotos = $('#r-fotos'); for (const u of A.fotos) { const i = el('img') as HTMLImageElement; i.src = u; i.alt = A.nombre; i.loading = 'lazy'; fotos.append(i); }
    if (!A.fotos.length) fotos.hidden = true;
    if ((A.categorias || []).includes('lugares')) $('#r-dir').hidden = true;
    pintarServicios(); pintarMetodos();
    if (A.calendario) { $('#r-cal').hidden = false; pintarCal(); } else { $('#r-fecha-libre').hidden = false; const inp = $<HTMLInputElement>('#r-fecha-libre input'); inp.min = hoy; }
    modoConsulta();
    $('#res-load').hidden = true; $('#res-app').hidden = false;
  })();
</script>
