---
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';
import HomeNav from '../components/HomeNav.astro';
import '../styles/home.css';
import { site } from '../config/site';
const c = site.contact;
const loc = site.location;
const cid = new URL(c.googleMaps).searchParams.get('cid');
const mapa = loc.mapsEmbedUrl || `https://maps.google.com/maps?cid=${cid}&hl=es&z=16&output=embed`;
---

<Base image="/img/og-celebra.jpg" title="Contacto y quiénes somos · Celebra" description="Escríbenos o visita el taller Celebra en Caripe, Monagas. Conoce quiénes hacen tus piñatas, chupeteras y decoración.">
  <div class="home">
    <HomeNav />
    <main>
      <section class="h-wrap h-top">
        <div class="h-top-head rv">
          <span class="h-kicker">Contacto</span>
          <h1>¿En qué te <em>ayudamos?</em></h1>
          <p class="h-lead">Escríbenos por el formulario y te responderemos a tu correo. Si es urgente, háblanos por WhatsApp o visítanos en el taller.</p>
        </div>
      </section>

      <section class="h-wrap h-contact">
        <form class="h-form rv" id="contacto-form" novalidate>
          <label>Tu nombre<input type="text" name="nombre" autocomplete="name" required /></label>
          <div class="h-form-2">
            <label>Correo<input type="email" name="correo" autocomplete="email" inputmode="email" required /></label>
            <label>Teléfono<input type="tel" name="telefono" autocomplete="tel" inputmode="tel" placeholder="+58 414…" /></label>
          </div>
          <label>¿En qué podemos ayudarte?<textarea name="mensaje" rows="5" required placeholder="Cuéntanos qué necesitas"></textarea></label>
          <input type="text" name="empresa" tabindex="-1" autocomplete="off" aria-hidden="true" class="h-hp" />
          <button class="h-btn" type="submit">Enviar mensaje</button>
          <p class="h-form-err" role="alert" hidden></p>
          <div class="h-form-ok" role="status" hidden><b>¡Gracias! Recibimos tu mensaje.</b><span>Te responderemos a tu correo lo antes posible.</span></div>
        </form>

        <div class="h-contact-info">
          <div class="h-vbox rv" style="--d:60ms">
            <h3>Taller Celebra</h3>
            <p>Caripe, estado Monagas, Venezuela.</p>
            <p><b>Solo retiro en el local.</b> No hacemos envíos a domicilio.</p>
            <dl>{loc.hours.map((h) => (<><dt>{h.days}</dt><dd>{h.time}</dd></>))}</dl>
          </div>
          <div class="h-vbox rv" style="--d:120ms">
            <h3>Escríbenos directo</h3>
            <a class="h-link" href={`https://wa.me/${c.localWhatsapp}`} target="_blank" rel="noopener">WhatsApp {c.localWhatsappDisplay}</a>
            <a class="h-link" href={`mailto:${site.brand.email}`}>{site.brand.email}</a>
            <a class="h-link" href={c.instagram} target="_blank" rel="noopener">Instagram {c.instagramHandle}</a>
          </div>
        </div>
      </section>

      <section class="h-sec h-wrap" aria-labelledby="t-mapa">
        <div class="h-head rv"><span class="h-kicker">Cómo llegar</span><h2 id="t-mapa">Encuéntranos en Caripe</h2></div>
        <div class="h-map rv">
          <iframe src={mapa} title="Ubicación del taller Celebra en Google Maps" loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
        </div>
        <p class="h-fine rv"><a class="h-link" href={c.googleMaps} target="_blank" rel="noopener">Abrir en Google Maps →</a></p>
      </section>

      <section class="h-sec h-wrap" id="quienes" aria-labelledby="t-quienes">
        <div class="h-about rv">
          <img src="/img/marca/regalo.webp" alt="" width="520" height="405" loading="lazy" />
          <div>
            <span class="h-kicker">Quiénes somos</span>
            <h2 id="t-quienes">Tus aliadas en cada momento especial</h2>
            <p>Estamos muy emocionadas de abrir nuestras puertas digitales para acompañarte en cada celebración. Nuestra misión es simple: transformar tus ideas en celebraciones inolvidables. 👑🎊</p>
            <p>Desde los detalles más pequeños hasta las decoraciones más espectaculares, en nuestro taller de Caripe creamos todo lo que necesitas para que tu evento brille con luz propia. Nuestra pasión es ponerle color, brillo y mucha alegría a tus días especiales. 🌈💎</p>
            <p>¡Síguenos y prepárate para celebrar la vida con nosotras! También escribimos <a class="h-link" href="/libro/">Fiestas que se recuerdan</a>, nuestra guía para organizar la fiesta en casa gastando menos.</p>
            <ul class="h-trust">
              <li>Hecho a mano en Caripe</li>
              <li>Precio final por escrito</li>
              <li>Retiro en el local</li>
            </ul>
          </div>
        </div>
      </section>
    </main>
    <Footer />
  </div>
</Base>

<script>
  const f = document.getElementById('contacto-form') as HTMLFormElement;
  const t0 = Date.now();
  const btn = f.querySelector<HTMLButtonElement>('button[type="submit"]')!;
  f.addEventListener('submit', async (e) => {
    e.preventDefault();
    const d = Object.fromEntries(new FormData(f)) as Record<string, string>;
    const err = f.querySelector<HTMLElement>('.h-form-err')!;
    const ok = f.querySelector<HTMLElement>('.h-form-ok')!;
    const falta: string[] = [];
    if (!(d.nombre || '').trim()) falta.push('tu nombre');
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test((d.correo || '').trim())) falta.push('un correo válido');
    if (!(d.mensaje || '').trim()) falta.push('tu mensaje');
    if (falta.length) { err.textContent = 'Falta ' + falta.join(', ') + '.'; err.hidden = false; return; }
    err.hidden = true; ok.hidden = true;
    btn.disabled = true; btn.textContent = 'Enviando…';
    try {
      const r = await fetch('/api/contacto', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ ...d, t: t0 }) });
      const out = await r.json().catch(() => ({}));
      if (!r.ok) throw new Error(out.error || 'No pudimos enviarlo ahora. Inténtalo de nuevo.');
      f.reset();
      ok.hidden = false;
    } catch (x) {
      err.textContent = (x as Error).message; err.hidden = false;
    }
    btn.disabled = false; btn.textContent = 'Enviar mensaje';
  });
</script>
