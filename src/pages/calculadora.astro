---
import Base from '../layouts/Base.astro';
import { site } from '../config/site';
import Footer from '../components/Footer.astro';
import HomeNav from '../components/HomeNav.astro';
import '../styles/home.css';
---

<Base image="/img/og-celebra.jpg" title="Calculadora de presupuesto para fiestas · Celebra" description="Reparte el presupuesto de tu fiesta infantil por rubro, anota lo que ya cotizaste y mira cuánto te queda. Gratis, de Celebra.">
  <div class="home">
    <HomeNav />
    <div class="calc-page">
<main class="wrap">
<h1>¿Cuánto cuesta tu fiesta?</h1>
<p class="lead">Escribe cuánto puedes gastar y cuántos niños invitas. Te repartimos el total con la guía del taller Celebra. Cuando ya sepas el precio de algo, anótalo y te mostramos cuánto te queda para lo demás.</p>

<div class="calc">
  <div class="side">
    <form class="calc-in" id="calc-form" novalidate>
      <div class="fld">
        <label for="calc-total">¿Cuánto vas a gastar en total?</label>
        <div class="money"><select id="calc-cur" aria-label="Moneda"><option value="USD">USD</option><option value="Bs">Bs</option><option value="CLP">CLP</option></select><input id="calc-total" type="number" inputmode="decimal" min="0" step="any"></div>
      </div>
      <div class="fld">
        <label for="calc-kids">¿Cuántos niños invitas?</label>
        <input id="calc-kids" type="number" inputmode="numeric" min="1" step="1">
      </div>
    </form>
    <div class="kpis" aria-live="polite">
      <div class="kpi big" id="k-left-box"><span class="k-l" id="k-left-l">Te queda por gastar</span><b class="k-v" id="k-left">—</b><span class="k-s" id="k-left-s"></span><div class="bar" aria-hidden="true"><i id="k-bar"></i></div></div>
      <div class="kpi"><span class="k-l">Ya cotizado</span><b class="k-v" id="k-known">—</b></div>
      <div class="kpi"><span class="k-l">Por niño</span><b class="k-v" id="k-kid">—</b></div>
      <div class="kpi"><span class="k-l">Cada bolsita</span><b class="k-v" id="k-bag">—</b></div>
      <div class="kpi"><span class="k-l">Imprevistos</span><b class="k-v" id="k-buf">—</b></div>
    </div>
    <div class="actions">
      <button type="button" class="btn-sec" data-share>Enviar por WhatsApp</button>
      <button type="button" class="btn-sec" id="calc-copy">Copiar</button>
      <button type="button" class="btn-sec" id="calc-reset">Empezar de nuevo</button>
      <span class="copied" id="calc-copied" role="status"></span>
    </div>
  </div>

  <div class="list">
    <div class="list-head">
      <h2>Tu presupuesto por rubro</h2>
      <p>El sugerido se recalcula solo: lo que ya cotizaste se descuenta y el resto se reparte entre lo que falta.</p>
    </div>
    <div id="groups"></div>
    <form class="add" id="add-form" novalidate>
      <div class="fld"><label for="add-name">Agregar otro gasto</label><input id="add-name" type="text" placeholder="Ej. Fotógrafo, inflable, payaso" maxlength="40"></div>
      <div class="fld"><label for="add-price">Precio (si lo sabes)</label><input id="add-price" type="number" inputmode="decimal" min="0" step="any" placeholder="0"></div>
      <button type="submit" class="btn btn-add">+ Agregar</button>
    </form>
    <p class="note" id="calc-note"></p>
    <div class="actions-end"><button type="button" class="btn btn-wa" data-share>Enviar mi presupuesto por WhatsApp</button></div>
  </div>
</div>

{site.capituloGratis && <div class="cta">
  <img src="/img/marca/regalo.webp" alt="" width="520" height="405" loading="lazy" />
  <div class="cta-txt">
    <span class="cta-k">Gratis · en PDF</span>
    <b>¿Prefieres tu presupuesto en papel?</b>
    <p>Esta calculadora sale del capítulo 2 de nuestro libro <i>Fiestas que se recuerdan</i>. Te lo regalamos para que lo tengas a mano: trae una <b>hoja de presupuesto para imprimir</b> y anotar a lápiz, y un <b>ejemplo resuelto de una fiesta para 15 niños</b>, con cuánto se gastó en cada cosa.</p>
    <p class="cta-s">Solo dejas tu correo y te llega en un minuto.</p>
  </div>
  <a href="/libro/regalo/">Quiero el capítulo gratis</a>
</div>}
</main>
    </div>
<div class="calc-dock" id="calc-dock" aria-hidden="true">
  <div class="d-txt"><span class="d-l" id="d-l">Te queda</span><span class="d-v" id="d-v">—</span></div>
  <button type="button" class="btn btn-wa" data-share tabindex="-1">Enviar por WhatsApp</button>
</div>
    <Footer />
  </div>
</Base>

<style is:global>

/* Colores tomados del logo de Celebra: magenta, celeste, azul, lila y amarillo. */
:root{--ink:#16171a;--muted:#5c6070;--line:#e3e5ea;--panel:#f4f5f7;--accent:#6043e1;--lila:#f3eefd;--lila-line:#ded3f7;--lila-ink:#4b2a86;--cielo:#e8f4fc;--cielo-ink:#14466f;--ok:#1a7f4b;--bad:#b42318;--bad-soft:#fdecea;--body:'Figtree',system-ui,-apple-system,'Segoe UI',sans-serif}
*{box-sizing:border-box}
.calc-page{color:var(--ink);font:16px/1.55 var(--body);-webkit-font-smoothing:antialiased}
[hidden]{display:none!important}
.calc-page .wrap{max-width:1040px;margin:0 auto;padding:40px max(20px,env(safe-area-inset-right,0px)) 56px max(20px,env(safe-area-inset-left,0px));display:flex;flex-direction:column;gap:22px}
.calc-page h1{margin:0;font-weight:800;letter-spacing:-0.025em;font-size:clamp(32px,5vw,48px);line-height:1.08;text-wrap:balance}
.calc-page h2{margin:0;font-weight:800;letter-spacing:-0.02em;font-size:20px}
.lead{margin:0;color:var(--muted);font-size:18px;max-width:62ch}
.calc{display:grid;grid-template-columns:minmax(0,4fr) minmax(0,8fr);gap:20px;align-items:start}
.side{display:flex;flex-direction:column;gap:14px;position:sticky;top:16px}
.calc-in{background:var(--lila);border-radius:18px;padding:20px;display:flex;flex-direction:column;gap:14px}
.fld{display:flex;flex-direction:column;gap:6px}.fld label{font-weight:700;font-size:14px}
.calc-page input,.calc-page select{height:52px;border-radius:12px;border:1.5px solid var(--lila-line);background:#fff;color:var(--ink);padding:0 13px;font:500 16px var(--body);width:100%;min-width:0}
.calc-page input:focus,.calc-page select:focus{outline:none;border-color:var(--accent);box-shadow:0 0 0 4px rgba(96,67,225,.15)}
.money{display:grid;grid-template-columns:92px minmax(0,1fr);gap:8px}
.kpis{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.kpi{background:#fff;border:1.5px solid var(--line);border-radius:14px;padding:12px 14px;display:flex;flex-direction:column;min-width:0}
.kpi.big{grid-column:span 2;background:var(--cielo);border-color:transparent}
.kpi.big.bad{background:var(--bad-soft)}
.k-l{font-size:12px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;color:var(--muted)}
.k-v{font-size:20px;font-weight:800;font-variant-numeric:tabular-nums;overflow-wrap:anywhere}
.kpi.big .k-v{font-size:28px;color:var(--cielo-ink)}
.kpi.big.bad .k-v{color:var(--bad)}
.k-s{font-size:13px;color:var(--muted)}
.bar{height:10px;border-radius:999px;background:#fff;overflow:hidden;margin-top:8px}
.bar i{display:block;height:100%;width:0;border-radius:999px;background:linear-gradient(90deg,#db3978,#6043e1);transition:width .25s ease}
.kpi.big.bad .bar i{background:var(--bad)}
.list{display:flex;flex-direction:column;gap:18px;min-width:0}
.list-head{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:end;gap:10px}
.list-head p{margin:0;color:var(--muted);font-size:14px;max-width:52ch}
.grp{border:1.5px solid var(--line);border-radius:16px;overflow:hidden;background:#fff}
.grp-h{display:flex;justify-content:space-between;gap:12px;padding:12px 16px;background:var(--panel);font-weight:800;font-size:15px}
.grp-h span:last-child{font-variant-numeric:tabular-nums;color:var(--muted);font-weight:700}
.cols{display:grid;grid-template-columns:minmax(0,1fr) 120px 150px 40px;gap:10px;padding:8px 16px 0;font-size:12px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;color:var(--muted)}
.row{display:grid;grid-template-columns:minmax(0,1fr) 120px 150px 40px;gap:10px;align-items:center;padding:10px 16px;border-top:1px solid var(--line)}
.cols + .row{border-top:0}
.r-name{min-width:0}
.r-name b{display:block;font-weight:600;font-size:15px}
.r-name span{display:block;font-size:13px;color:var(--muted)}
.r-name input{height:40px;font-weight:600}
.r-sug{text-align:right;font-variant-numeric:tabular-nums;font-weight:600}
.r-sug small{display:block;font-size:12px;color:var(--muted);font-weight:500}
.r-real input{height:44px;text-align:right;font-variant-numeric:tabular-nums}
.r-real input.has{border-color:#9fd3b6;background:#f2faf5}
.del{width:40px;height:40px;border-radius:10px;border:1.5px solid var(--line);background:#fff;color:var(--muted);display:grid;place-items:center;cursor:pointer}
.del:hover{color:var(--bad);border-color:var(--bad)}
.ico{width:18px;height:18px;stroke:currentColor;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
.add{display:grid;grid-template-columns:minmax(0,1fr) 150px auto;gap:10px;padding:14px 16px;background:var(--cielo);border-radius:16px;align-items:end}
.add .fld label{color:var(--cielo-ink)}
.add input{border-color:#c5e0f3}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:52px;padding:0 20px;border-radius:12px;border:0;background:var(--accent);color:#fff;font:800 16px var(--body);cursor:pointer;text-decoration:none;white-space:nowrap}
.btn:hover{filter:brightness(1.06);color:#fff}
.btn-sec{min-height:44px;padding:0 16px;border-radius:10px;border:1.5px solid var(--line);background:#fff;font:700 15px var(--body);cursor:pointer;color:var(--ink)}
.btn-sec:hover{border-color:var(--ink)}
.actions{display:flex;flex-wrap:wrap;gap:10px;align-items:center}
.copied{color:var(--ok);font-weight:700;font-size:14px}
.note{margin:0;color:var(--muted);font-size:14px}
.btn:focus-visible,.btn-sec:focus-visible,.del:focus-visible,.cta a:focus-visible{outline:3px solid var(--accent);outline-offset:2px}
.cta{display:flex;gap:24px;align-items:center;padding:28px;border-radius:20px;background:#fbe6ee;color:#3d3554;margin-top:8px}
.cta img{width:110px;height:auto;flex:none}
.cta-txt{display:flex;flex-direction:column;gap:8px;flex:1;min-width:0}
.cta-k{font-size:12px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;color:#b8285f}
.cta-txt>b{font-size:22px;font-weight:800;letter-spacing:-.01em;color:#2b1d5c;line-height:1.15}
.cta-txt p{margin:0;font-size:16px}
.cta-txt p b{color:#2b1d5c}
.cta-s{font-size:14px!important;color:var(--muted)}
.btn-add{background:#fff;color:var(--accent);box-shadow:inset 0 0 0 2px var(--accent)}
.btn-add:hover{color:var(--accent);background:#f7f3ff}
.btn-wa{background:#1a7f4b}
.btn-wa:hover{background:#156b3f}
.cta>a{flex:none;background:#b8285f;color:#fff;text-decoration:none;font-weight:800;padding:16px 22px;border-radius:12px}
@media (max-width:760px){.cta{flex-direction:column;align-items:flex-start;padding:24px 20px;gap:14px}.cta img{width:80px}.cta>a{width:100%;text-align:center}}
@media (max-width:860px){.calc{grid-template-columns:1fr}.side{position:static}}
@media (max-width:620px){
  .cols{display:none}
  .row{grid-template-columns:minmax(0,1fr) 40px;grid-template-areas:"n d" "s s" "p p";row-gap:8px}
  .r-name{grid-area:n}.del{grid-area:d}
  .r-sug{grid-area:s;text-align:left;display:flex;align-items:baseline}
  .r-sug small{display:inline;margin-left:auto;margin-right:10px}
  .r-sug::before{content:"Sugerido";font-size:13px;color:var(--muted);font-weight:500}
  .r-real{grid-area:p;display:grid;grid-template-columns:auto minmax(0,1fr);align-items:center;gap:10px}
  .r-real::before{content:"Precio real";font-size:13px;color:var(--muted)}
  .add{grid-template-columns:1fr}
}
@media (prefers-reduced-motion:reduce){.bar i{transition:none}}

/* Barra fija en el celular: cuánto queda + compartir */
.calc-dock{display:none}
.actions-end{display:flex;flex-wrap:wrap;gap:10px;margin-top:4px}
@media (max-width:860px){
  .calc-dock{display:flex;position:fixed;left:0;right:0;bottom:0;z-index:40;align-items:center;gap:12px;padding:10px max(16px,env(safe-area-inset-right,0px)) calc(10px + env(safe-area-inset-bottom,0px)) max(16px,env(safe-area-inset-left,0px));background:rgba(255,255,255,.96);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);border-top:1px solid var(--line);box-shadow:0 -10px 24px -18px rgba(43,29,92,.5);transform:translateY(110%);transition:transform .25s ease}
  .calc-dock.on{transform:none}
  .calc-dock .d-l{display:block;font-size:11px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;color:var(--muted)}
  .calc-dock .d-v{display:block;font-size:22px;font-weight:800;font-variant-numeric:tabular-nums;color:var(--cielo-ink);line-height:1.1}
  .calc-dock.bad .d-v{color:var(--bad)}
  .calc-dock .d-txt{flex:1;min-width:0}
  .calc-dock .btn{min-height:48px;padding:0 16px;font-size:15px}
  .calc-page{padding-bottom:84px}
  .h-wa{display:none}
}
@media (prefers-reduced-motion:reduce){.calc-dock{transition:none}}

</style>

<script is:inline>

(function () {
  // Reparto del libro (capítulo 2): los mismos 11 rubros y porcentajes que las páginas 6 a 8.
  const DEFAULTS = [
    { g: 'Comida y bebidas', items: [['Comida (con platos, vasos y servilletas)', 22], ['Bebidas', 8]] },
    { g: 'Torta', items: [['Torta', 15]] },
    { g: 'Decoración', items: [['Decoración con elementos (banderines, manteles, centros)', 6], ['Decoración con globos', 6]] },
    { g: 'Piñata', items: [['Piñata', 7], ['Relleno de la piñata', 5]] },
    { g: 'Mesa dulce y cotillón', items: [['Mesa dulce', 7], ['Cotillón (gorritos, pitos, matracas)', 4]] },
    { g: 'Recuerdos', items: [['Recuerdos (bolsitas)', 10, 'bolsitas']] },
    { g: 'Lugar y extras', items: [['Lugar (si alquilas)', 0]] },
    { g: 'Imprevistos', items: [['Imprevistos', 10, 'buffer']] },
  ];
  const BASE = { USD: 130, Bs: 0, CLP: 150000 };
  const KEY = 'celebra-calc-v3';
  const $ = (id) => document.getElementById(id);
  const esc = (s) => String(s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]);
  let uid = 0;
  const fresh = () => DEFAULTS.flatMap((grp) => grp.items.map(([name, pct, tag]) => ({ id: ++uid, g: grp.g, name, pct, tag: tag || '', real: null, custom: false })));

  let state = { cur: 'USD', total: 130, kids: 15, rows: fresh() };
  try {
    const saved = JSON.parse(localStorage.getItem(KEY) || 'null');
    if (saved && Array.isArray(saved.rows)) { state = saved; uid = Math.max(0, ...state.rows.map((r) => r.id)); }
  } catch (e) { /* sin almacenamiento: empezamos con los valores del libro */ }
  const save = () => { try { localStorage.setItem(KEY, JSON.stringify(state)); } catch (e) { /* solo esta visita */ } };

  const fmt = (n, cur) => {
    const dec = cur === 'CLP' ? 0 : 2;
    return cur + ' ' + new Intl.NumberFormat('es-VE', { minimumFractionDigits: dec, maximumFractionDigits: dec }).format(n || 0);
  };
  const num = (v) => { const n = parseFloat(String(v).replace(',', '.')); return isFinite(n) && n >= 0 ? n : null; };

  function compute() {
    const T = state.total;
    const known = state.rows.reduce((s, r) => s + (r.real != null ? r.real : 0), 0);
    const freePct = state.rows.reduce((s, r) => s + (r.real == null ? r.pct : 0), 0);
    const pool = Math.max(0, T - known);
    state.rows.forEach((r) => { r.sug = r.real != null ? r.real : (freePct > 0 ? pool * r.pct / freePct : 0); });
    return { T, known, left: T - known };
  }

  function renderRows() {
    const groups = [];
    state.rows.forEach((r) => {
      let g = groups.find((x) => x.name === r.g);
      if (!g) groups.push(g = { name: r.g, rows: [] });
      g.rows.push(r);
    });
    $('groups').innerHTML = groups.map((g) => `
      <section class="grp" aria-label="${esc(g.name)}" style="margin-bottom:14px">
        <div class="grp-h"><span>${esc(g.name)}</span><span data-gsum="${esc(g.name)}"></span></div>
        <div class="cols" aria-hidden="true"><span>Gasto</span><span style="text-align:right">Sugerido</span><span style="text-align:right">Precio real</span><span></span></div>
        ${g.rows.map((r) => `
          <div class="row" data-id="${r.id}">
            <div class="r-name">${r.custom
              ? `<input type="text" value="${esc(r.name)}" data-name="${r.id}" aria-label="Nombre del gasto" maxlength="40">`
              : `<b>${esc(r.name)}</b>${r.tag === 'bolsitas' ? '<span data-bagnote></span>' : ''}`}</div>
            <div class="r-sug"><small data-pct="${r.id}"></small><span data-sug="${r.id}"></span></div>
            <div class="r-real"><input type="number" inputmode="decimal" min="0" step="any" placeholder="¿Ya lo sabes?" data-real="${r.id}" aria-label="Precio real de ${esc(r.name)}" value="${r.real != null ? r.real : ''}" class="${r.real != null ? 'has' : ''}"></div>
            <button type="button" class="del" data-del="${r.id}" aria-label="Quitar ${esc(r.name)}"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg></button>
          </div>`).join('')}
      </section>`).join('');
    update();
  }

  function update() {
    const cur = state.cur;
    const { T, known, left } = compute();
    state.rows.forEach((r) => {
      const s = document.querySelector(`[data-sug="${r.id}"]`);
      const p = document.querySelector(`[data-pct="${r.id}"]`);
      if (s) s.textContent = r.real != null ? fmt(r.real, cur) : (r.pct > 0 ? fmt(r.sug, cur) : '—');
      if (p) p.textContent = r.real != null ? 'real' : (r.pct > 0 ? r.pct + '%' : '');
    });
    document.querySelectorAll('[data-gsum]').forEach((el) => {
      const sum = state.rows.filter((r) => r.g === el.dataset.gsum).reduce((s, r) => s + r.sug, 0);
      el.textContent = fmt(sum, cur);
    });
    const kids = Math.max(1, state.kids);
    const bags = kids + 2;
    const bagRow = state.rows.find((r) => r.tag === 'bolsitas');
    const bufRow = state.rows.find((r) => r.tag === 'buffer');
    document.querySelectorAll('[data-bagnote]').forEach((el) => (el.textContent = `${bags} bolsitas: ${kids} niños y 2 de repuesto`));
    const over = left < 0;
    $('k-left-box').classList.toggle('bad', over);
    $('k-left-l').textContent = over ? 'Te pasaste por' : 'Te queda por gastar';
    $('k-left').textContent = fmt(Math.abs(left), cur);
    $('k-left-s').textContent = over ? 'Baja algún precio, quita invitados o sube el presupuesto.' : `De ${fmt(T, cur)} en total`;
    $('k-bar').style.width = (T > 0 ? Math.min(100, (known / T) * 100) : 0) + '%';
    $('k-known').textContent = fmt(known, cur);
    $('k-kid').textContent = fmt(T / kids, cur);
    $('k-bag').textContent = bagRow ? fmt(bagRow.sug / bags, cur) : '—';
    $('k-buf').textContent = bufRow ? fmt(bufRow.sug, cur) : '—';
    $('d-l').textContent = over ? 'Te pasaste por' : 'Te queda';
    $('d-v').textContent = fmt(Math.abs(left), cur);
    $('calc-dock').classList.toggle('bad', over);
    $('calc-note').textContent = 'Los porcentajes son la guía del libro y sirven de punto de partida: cambia lo que quieras. Si el monto por niño te parece alto, baja invitados o haz más cosas en casa; no recortes la comida.';
    save();
  }

  function syncInputs() {
    $('calc-cur').value = state.cur;
    $('calc-total').value = state.total;
    $('calc-kids').value = state.kids;
  }

  $('calc-cur').addEventListener('change', () => {
    const prev = state.cur;
    state.cur = $('calc-cur').value;
    // Si la persona no tocó el total de ejemplo, ponemos el ejemplo de esa moneda.
    if (state.total === BASE[prev] && BASE[state.cur]) { state.total = BASE[state.cur]; $('calc-total').value = state.total; }
    update();
  });
  $('calc-total').addEventListener('input', () => { state.total = num($('calc-total').value) || 0; update(); });
  $('calc-kids').addEventListener('input', () => { state.kids = Math.max(1, Math.round(num($('calc-kids').value) || 1)); update(); });
  $('calc-form').addEventListener('submit', (e) => e.preventDefault());

  $('groups').addEventListener('input', (e) => {
    const t = e.target;
    if (t.dataset.real) {
      const r = state.rows.find((x) => x.id === +t.dataset.real);
      r.real = t.value === '' ? null : num(t.value);
      t.classList.toggle('has', r.real != null);
      update();
    } else if (t.dataset.name) {
      state.rows.find((x) => x.id === +t.dataset.name).name = t.value;
      save();
    }
  });
  $('groups').addEventListener('click', (e) => {
    const b = e.target.closest('[data-del]');
    if (!b) return;
    state.rows = state.rows.filter((x) => x.id !== +b.dataset.del);
    renderRows();
  });

  $('add-form').addEventListener('submit', (e) => {
    e.preventDefault();
    const name = $('add-name').value.trim();
    if (!name) { $('add-name').focus(); return; }
    const price = $('add-price').value === '' ? null : num($('add-price').value);
    state.rows.push({ id: ++uid, g: 'Lugar y extras', name, pct: 0, tag: '', real: price, custom: true });
    $('add-name').value = ''; $('add-price').value = '';
    renderRows();
    $('add-name').focus();
  });

  $('calc-reset').addEventListener('click', () => {
    state = { cur: state.cur, total: BASE[state.cur] || state.total, kids: 15, rows: fresh() };
    syncInputs();
    renderRows();
  });

  const resumen = () => {
    const cur = state.cur;
    const { T, known, left } = compute();
    const lines = state.rows.filter((r) => r.sug > 0).map((r) => '• ' + r.name + ': ' + fmt(r.sug, cur) + (r.real != null ? ' ✓' : ''));
    const text = 'Mi presupuesto para la fiesta (' + state.kids + ' niños)\n' + lines.join('\n') +
      '\nTotal: ' + fmt(T, cur) + '\nYa cotizado: ' + fmt(known, cur) + '\n' + (left < 0 ? 'Me pasé por: ' : 'Me queda: ') + fmt(Math.abs(left), cur) +
      '\n(✓ = precio real)\nCalculado con la guía de Celebra: ' + location.origin + '/calculadora/';
    return text;
  };
  document.querySelectorAll('[data-share]').forEach((b) => b.addEventListener('click', () => {
    const url = 'https://wa.me/?text=' + encodeURIComponent(resumen());
    if (matchMedia('(pointer: coarse)').matches) location.href = url; else window.open(url, '_blank', 'noopener');
  }));
  $('calc-copy').addEventListener('click', () => {
    const text = resumen();
    const done = () => { $('calc-copied').textContent = 'Copiado'; setTimeout(() => { $('calc-copied').textContent = ''; }, 1800); };
    const fallback = () => { $('calc-copied').textContent = 'No se pudo copiar'; };
    try { navigator.clipboard.writeText(text).then(done, fallback); } catch (e) { fallback(); }
  });

  syncInputs();
  renderRows();

  // Moneda sugerida según el país (Cloudflare), solo si la persona no tiene un presupuesto guardado.
  let hadSaved = false;
  try { hadSaved = !!localStorage.getItem(KEY + '-touched'); } catch (e) {}
  if (!hadSaved) {
    fetch('/api/pais').then((r) => r.json()).then(({ pais }) => {
      if (pais === 'CL' && state.cur === 'USD' && state.total === BASE.USD) { state.cur = 'CLP'; state.total = BASE.CLP; syncInputs(); update(); }
    }).catch(() => {});
  }
  document.addEventListener('input', () => { try { localStorage.setItem(KEY + '-touched', '1'); } catch (e) {} }, { once: true });
})();

// La barra de abajo aparece cuando el resumen de arriba ya no se ve.
(function () {
  const dock = document.getElementById('calc-dock');
  const box = document.getElementById('k-left-box');
  if (!dock || !box || !('IntersectionObserver' in window)) return;
  new IntersectionObserver(([en]) => dock.classList.toggle('on', !en.isIntersecting && en.boundingClientRect.top < 0)).observe(box);
})();

</script>
