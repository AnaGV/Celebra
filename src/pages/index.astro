---
import Base from '../layouts/Base.astro';
import Checkout from '../components/Checkout.astro';
import Footer from '../components/Footer.astro';
import { site } from '../config/site';
import { products, mainProduct } from '../config/products';

const ebook = mainProduct;
const print = products.find((p) => p.kind === 'fisico')!;
const pe = `USD ${ebook.priceUsd}`;
const pp = `USD ${print.priceUsd}`;
const c = site.contact;

const IC = {
  card: 'M3 6h18v12H3zM3 10h18M7 15h4',
  phone: 'M8 2h8a1 1 0 011 1v18a1 1 0 01-1 1H8a1 1 0 01-1-1V3a1 1 0 011-1zM11 18h2',
  coin: 'M12 3a9 9 0 100 18 9 9 0 000-18zM9 9h4.5a2 2 0 010 4H9h5a2 2 0 010 4H9M11 7v2M11 17v2',
  wallet: 'M3 7h16a2 2 0 012 2v8a2 2 0 01-2 2H3zM3 7l12-3v3M16 13h2',
  tap: 'M7 3h10a1 1 0 011 1v16a1 1 0 01-1 1H7a1 1 0 01-1-1V4a1 1 0 011-1zM9 9a4 4 0 016 0M10.5 11a2 2 0 013 0',
  store: 'M4 10h16v10H4zM3 10l2-5h14l2 5M10 20v-5h4v5',
};
const M = {
  pm: { name: 'Pago Móvil', note: 'En bolívares, a la tasa del día', icon: IC.phone, bg: '#e7f1fb', fg: '#1d4ed8' },
  bn: { name: 'Binance Pay', note: 'En USDT, desde tu app de Binance', icon: IC.coin, bg: '#f9eeda', fg: '#9a6a00' },
  cd: { name: 'Tarjeta Visa o Mastercard', note: 'Crédito o débito habilitada para compras internacionales', icon: IC.card, bg: '#efedff', fg: '#5b3fd1' },
  ap: { name: 'Apple Pay o Google Pay', note: 'Desde tu celular, si lo tienes activado', icon: IC.tap, bg: '#f0efec', fg: '#16171a' },
  pp: { name: 'PayPal', note: 'Con tu cuenta o tarjeta guardada', icon: IC.wallet, bg: '#e7f1fb', fg: '#0b4fa3' },
  lc: { name: 'Pago en el local', note: 'Solo libro impreso, al retirarlo en Caripe', icon: IC.store, bg: '#fdeaf2', fg: '#c2185b' },
};
type K = keyof typeof M;
const byCountry: Record<'VE' | 'CL' | 'OTRO', { methods: K[]; hero: string[]; announce: string; t: string; s: string; d: string }> = {
  VE: { methods: ['pm', 'bn', 'cd', 'pp', 'lc'], hero: ['Pago Móvil', 'Binance', 'Tarjeta', 'PayPal'], announce: 'En Venezuela pagas con Pago Móvil, Binance o tarjeta. El ebook llega a tu email.', t: 'Pagas en bolívares o USDT', s: 'Pago Móvil, Binance o tarjeta', d: 'Al confirmar tu pago' },
  CL: { methods: ['cd', 'ap', 'pp', 'bn'], hero: ['Tarjeta', 'Apple Pay', 'PayPal', 'Binance'], announce: 'Recibe el ebook en tu email al instante. Pagas con tarjeta, PayPal o Binance.', t: 'Pagas con tu tarjeta', s: 'Visa, Mastercard o PayPal', d: 'Al instante tras pagar' },
  OTRO: { methods: ['cd', 'ap', 'pp', 'bn'], hero: ['Tarjeta', 'Apple Pay', 'PayPal', 'Binance'], announce: 'Recibe el ebook en tu email al instante, estés donde estés.', t: 'Pagas con tarjeta o PayPal', s: 'También con Binance (USDT)', d: 'Al instante tras pagar' },
};
const paises = ['VE', 'CL', 'OTRO'] as const;
const nombrePais = { VE: 'Venezuela', CL: 'Chile', OTRO: 'Otro país' };

const faqs = [
  ['¿Cómo recibo el ebook?', 'Apenas se confirma el pago te llega un email con el botón de descarga y tu recibo. Con Binance o Pago Móvil lo enviamos al verificar el pago, normalmente en menos de 2 horas en horario laboral.'],
  ['No me llegó el email, ¿qué hago?', 'Revisa spam o promociones. Si no está, escríbenos por WhatsApp con tu código de pedido y te lo reenviamos.'],
  ['¿Puedo pagar desde Venezuela?', 'Sí. Puedes pagar con Pago Móvil en bolívares, con Binance Pay (USDT) o con tarjeta internacional y PayPal.'],
  ['¿Y desde Chile u otro país?', 'Sí. Pagas con tarjeta Visa o Mastercard, Apple Pay, Google Pay, PayPal o Binance Pay. La página te muestra solo los métodos de tu país.'],
  ['¿En qué formato viene?', 'En PDF. Lo lees en el celular, la tablet o el computador, y puedes imprimir las hojas de listas y plantillas.'],
  ['¿Hacen envíos del libro impreso?', 'No. El libro impreso se retira en nuestro local de Caripe. Puedes reservarlo online y pagar al retirarlo.'],
  ['¿Puedo pedir un reembolso?', 'Como es un libro digital que recibes al instante, no hacemos devoluciones una vez entregado. Si no te llega o el archivo no abre, te ayudamos por WhatsApp; y si no logramos entregártelo, te devolvemos el dinero.'],
];

const toc = [
  ['1', 'Tu idea primero'], ['2', 'Presupuesto real'], ['3', 'Diseño, colores y temática'], ['4', 'La invitación'],
  ['5', 'Proveedores: qué reservar y qué no'], ['6', 'Lo mínimo de una fiesta'], ['7', 'El plan de 6 semanas'],
  ['8', 'El día antes y el día hora por hora'], ['+', 'Guía visual: piñata, globos, mesa, recuerdos e impresiones en grande'], ['+', 'Lista de compras para imprimir'],
];
const check = 'M20 6L9 17l-5-5';
const star = 'M12 3v3M12 18v3M3 12h3M18 12h3M5.6 5.6l2.1 2.1M16.3 16.3l2.1 2.1M5.6 18.4l2.1-2.1M16.3 7.7l2.1-2.1';
---

<Base
  title="Fiestas que se recuerdan · Haz tú misma la fiesta de tu hijo y gasta menos"
  description="La guía del taller Celebra para organizar el cumpleaños paso a paso: presupuesto, piñata, decoración y el día hora por hora. Ebook en PDF desde USD 7."
>
  <div class="pg">
    <div class="announce">{paises.map((p) => <span data-solo={p}>{byCountry[p].announce}</span>)}</div>

    <header class="nav">
      <div class="wrap nav-in">
        <a class="brand" href="#inicio" aria-label="Celebra, inicio">
          <span class="mark" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2.2" stroke-linecap="round"><path d={star}></path></svg></span>
          Celebra
        </a>
        <nav class="nav-links" aria-label="Secciones">
          <a href="#libro">El libro</a>
          <a href="#muestra">Capítulo gratis</a>
          <a href="#preguntas">Preguntas</a>
          <a href="#local">Local en Caripe</a>
        </nav>
        <button type="button" class="btn btn-sm" data-buy={ebook.id}>Comprar</button>
      </div>
    </header>

    <main id="inicio">
      <div class="wrap">
        <section class="hero" aria-label="Producto">
          <div class="gallery">
            <div class="stage" data-view="0">
              <img class="cover-img js-cover" data-v="0" src="/img/portada-a.jpg" width="900" height="1355" alt="Portada del libro Fiestas que se recuerdan: piñata estrella arcoíris hecha en casa" fetchpriority="high" />
              <div class="devices" data-v="1" hidden role="img" aria-label="Páginas reales del libro en una tablet y un celular">
                <div class="tablet"><img src="/img/libro-ejemplo.jpg" alt="Página del ejemplo resuelto: cumpleaños para 15 niños" loading="lazy" /></div>
                <div class="phone"><img src="/img/libro-pinata.jpg" alt="Página del paso a paso de la piñata estrella" loading="lazy" /></div>
              </div>
              <div class="sheet" data-v="2" hidden><img src="/img/libro-plantilla.jpg" alt="Plantilla de presupuesto para imprimir y pegar en la nevera" loading="lazy" /></div>
              <div class="real" data-v="3" hidden>
                <img src="/img/pinata-real.jpg" alt="Estructura real de la piñata estrella hecha en el taller Celebra" loading="lazy" />
                <span>Así queda la estructura de la piñata estrella antes de forrarla. El paso a paso está en el libro.</span>
              </div>
            </div>
            <div class="thumbs" role="group" aria-label="Vistas del libro">
              {[['Portada', 'portada-a'], ['Interior', 'interior'], ['Imprimibles', 'imprimibles'], ['Piñata', 'pinata']].map(([l, img], i) => (
                <button type="button" class:list={['thumb', { on: i === 0 }]} data-pick-view={i} aria-pressed={i === 0 ? 'true' : 'false'}>
                  <img class:list={[{ 'js-cover-th': i === 0 }]} src={`/img/th-${img}.jpg`} width="320" height="320" alt="" loading="lazy" />
                  <span>{l}</span>
                </button>
              ))}
            </div>
          </div>

          <div class="buy" data-fmt="ebook">
            <div class="buy-head">
              <span class="book-name">Fiestas que se recuerdan · ebook</span>
              <h1>Haz tú misma la fiesta de tu hijo y gasta menos</h1>
              <p class="lead">La guía de nuestro taller para organizar el cumpleaños paso a paso: el presupuesto, la piñata, la decoración y el día hora por hora.</p>
            </div>
            <div class="price">
              <b class="num" data-fmt-solo="ebook">{pe}</b><span class="muted" data-fmt-solo="ebook">Pago único, sin suscripción</span>
              <b class="num" data-fmt-solo="print" hidden>{pp}</b><span class="muted" data-fmt-solo="print" hidden>Pagas online o al retirar</span>
            </div>
            <p class="incl"><b>30 páginas en PDF</b> · plantillas para imprimir · molde de la piñata incluido</p>

            <div class="opts" role="radiogroup" aria-label="Formato" data-solo="VE">
              <span class="opt-label">Formato</span>
              <button type="button" role="radio" aria-checked="true" class="opt on" data-pick-fmt="ebook">
                <span class="dot" aria-hidden="true"></span>
                <span><span class="opt-t">Ebook</span><span class="opt-s">PDF de 30 páginas, llega a tu email</span></span>
                <span class="opt-p num">{pe}</span>
              </button>
              <button type="button" role="radio" aria-checked="false" class="opt" data-pick-fmt="print">
                <span class="dot" aria-hidden="true"></span>
                <span><span class="opt-t">Libro impreso</span><span class="opt-s">Solo retiro en nuestro local de Caripe. Sin envíos a domicilio</span></span>
                <span class="opt-p num">{pp}</span>
              </button>
            </div>

            <div class="buy-actions">
              <button type="button" class="btn js-main-buy" data-buy={ebook.id}><span data-fmt-solo="ebook">Quiero mi libro</span><span data-fmt-solo="print" hidden>Reservar libro impreso</span></button>
              <a class="link" href="#muestra">Leer el capítulo 2 gratis</a>
            </div>

            <div class="ship">
              <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d={check}></path></svg>
              <span><span data-fmt-solo="ebook">Llega a tu email apenas se confirma el pago, con tu recibo.</span><span data-fmt-solo="print" hidden><b>Solo retiro en nuestro local de Caripe. No hacemos envíos a domicilio.</b> Apartamos tu libro por 3 días.</span></span>
            </div>

            <div class="pays">
              <span>Paga con</span>
              {paises.map((p) => <span class="pays-set" data-solo={p}>{byCountry[p].hero.map((m) => <span class="pill">{m}</span>)}</span>)}
            </div>
          </div>
        </section>

        <section class="trust" aria-label="Cómo funciona la compra">
          <div class="trust-i"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16v12H4z"></path><path d="M4 7l8 6 8-6"></path></svg><div><b>Llega a tu email</b>{paises.map((p) => <span data-solo={p}>{byCountry[p].d}</span>)}</div></div>
          <div class="trust-i"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 3h12v18l-3-2-3 2-3-2-3 2z"></path><path d="M9 8h6M9 12h6"></path></svg><div><b>Recibo de compra</b><span>Con tu número de pedido, por email</span></div></div>
          <div class="trust-i"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7h18v10H3z"></path><path d="M3 10h18"></path><path d="M7 14h4"></path></svg><div>{paises.map((p) => <span class="trust-pay" data-solo={p}><b>{byCountry[p].t}</b><span>{byCountry[p].s}</span></span>)}</div></div>
          <div class="trust-i"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12a8 8 0 0116 0v4a2 2 0 01-2 2h-2v-6h4M4 12v4a2 2 0 002 2h2v-6H4"></path></svg><div><b>Soporte por WhatsApp</b><span>Si no te llega o no abre, lo resolvemos</span></div></div>
        </section>

        <section class="sec" id="libro">
          <div class="sec-head">
            <h2>Un adelanto de lo que hay dentro</h2>
            <p>Estas son cuatro herramientas del libro. Cada una te ahorra dinero o tiempo antes de la fiesta.</p>
          </div>
          <div class="bento">
            <article class="tile t-a">
              <span class="in-book">Capítulo 7</span>
              <h3>Un plan de 6 semanas</h3>
              <p class="muted">Qué hacer cada semana para llegar al día de la fiesta con todo listo y sin correr. Cada semana trae su lista para ir marcando.</p>
              <div class="weeks">
                {[['6', 'La idea y el presupuesto'], ['5', 'Temática y colores'], ['4', 'Invitaciones y reservas'], ['3', 'Piñata y decoración'], ['2', 'Detalles y recuerdos'], ['1', 'Confirmar y comprar']].map(([n, t]) => (
                  <div class="wk"><b>Semana {n}</b><span>{t}</span></div>
                ))}
              </div>
            </article>
            <article class="tile t-b">
              <span class="in-book">Capítulo 2</span>
              <h3>Presupuesto antes de comprar</h3>
              <p class="muted">Decides cuánto vas a gastar y lo repartes por rubro. Así sabes desde el principio si te alcanza, y dónde ahorrar haciendo cosas en casa.</p>
              <span class="ex-tag">Ejemplo: cumpleaños para 15 niños</span>
              <div class="tpl num">
                {[['Comida, bebidas y torta', 60], ['Decoración y globos', 15], ['Piñata hecha en casa', 15], ['Mesa dulce y 17 bolsitas', 27], ['Imprevistos (10%)', 13], ['Total de la fiesta', 130]].map(([t, v]) => (
                  <div class="tpl-r"><span>{t}</span><span>USD {v}</span></div>
                ))}
              </div>
              <p class="tpl-note">Cifras de ejemplo. En el libro completas la plantilla con tus propios números.</p>
            </article>
            <article class="tile t-c">
              <div class="c-inner">
                <span class="in-book">Guía visual</span>
                <h3>La piñata estrella, paso a paso</h3>
                <p class="muted">Cómo armarla con cartón reciclado: las dos caras, los laterales, los refuerzos y los flecos. Cada paso tiene su dibujo y el enlace al video en nuestro Instagram.</p>
              </div>
              <div class="parts"><img src="/img/pinata-partes.jpg" alt="Vista con las partes de la piñata estrella: pieza frontal, laterales, pieza posterior, tiras de refuerzo y cordón" loading="lazy" /></div>
            </article>
            <article class="tile t-d">
              <span class="in-book">Para imprimir</span>
              <h3>Hojas para imprimir y pegar en la nevera</h3>
              <p class="muted">El libro trae páginas pensadas para imprimir: las imprimes, las pegas a la vista y vas marcando a medida que avanzas. Nadie de la familia se pierde.</p>
              <div class="prints">
                <div class="print"><b>Lista de compras</b><div class="chk"><span class="box done"></span>Globos</div><div class="chk"><span class="box"></span>Velas</div><div class="chk"><span class="box"></span>Bolsitas</div></div>
                <div class="print"><b>El día, hora por hora</b><div class="chk"><span class="box done"></span>15:00 llegada</div><div class="chk"><span class="box"></span>16:30 piñata</div><div class="chk"><span class="box"></span>17:00 torta</div></div>
                <div class="print"><b>Plan de la semana</b><div class="chk"><span class="box done"></span>Encargué la torta</div><div class="chk"><span class="box"></span>Armé la piñata</div><div class="chk"><span class="box"></span>Confirmé invitados</div></div>
              </div>
            </article>
          </div>
        </section>

        <section class="sec" aria-labelledby="quien">
          <div class="sec-head"><h2 id="quien">Pensado para dos tipos de lectoras</h2></div>
          <div class="who">
            <div class="who-c">
              <div class="who-ic"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><circle cx="9" cy="7" r="3"></circle><circle cx="17" cy="9" r="2.2"></circle><path d="M3 20c0-3.3 2.7-6 6-6s6 2.7 6 6M14.5 20c.2-2.4 1.5-4.2 3.5-4.2s3 1.4 3 4.2"></path></svg></div>
              <h3>Familias que organizan un cumpleaños</h3>
              <ul class="ticks">
                {['Sabes cuánto vas a gastar antes de empezar', 'Haces la piñata y la decoración en casa', 'Llegas al día de la fiesta sin carreras'].map((t) => <li><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d={check}></path></svg><span>{t}</span></li>)}
              </ul>
            </div>
            <div class="who-c">
              <div class="who-ic"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 10h16v10H4z"></path><path d="M3 10l2-5h14l2 5"></path><path d="M10 20v-5h4v5"></path></svg></div>
              <h3>Emprendedoras de decoración</h3>
              <ul class="ticks">
                {['Aprendes las técnicas que usamos en el taller', 'Calculas costos para poner precio a tus piñatas', 'Ofreces paquetes completos de fiesta a tus clientas'].map((t) => <li><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d={check}></path></svg><span>{t}</span></li>)}
              </ul>
            </div>
          </div>
        </section>

        <section class="sec" aria-labelledby="indice">
          <div class="sec-head"><h2 id="indice">8 capítulos y una guía visual</h2><p>Del primer boceto de la idea hasta que se va el último invitado.</p></div>
          <div class="toc">
            {toc.map(([n, t]) => <div class="toc-r"><span class="toc-n num">{n}</span><span class="toc-t">{t}</span></div>)}
          </div>
        </section>

        <section class="lead-band" id="muestra" aria-labelledby="gratis">
          <div class="lead-copy">
            <h2 id="gratis">Lee el capítulo de presupuesto gratis</h2>
            <p>8 páginas en PDF: la regla del taller para que el dinero alcance, un ejemplo resuelto para 15 niños y la plantilla para imprimir. Te llega al email junto con un descuento para el libro completo.</p>
          </div>
          <form class="form" id="lead-form" data-origen="landing" novalidate>
            <div class="field"><label for="lead-name">Tu nombre</label><input id="lead-name" name="nombre" class="input" type="text" autocomplete="given-name" placeholder="Ej. Daniela" /></div>
            <div class="field"><label for="lead-email">Tu email</label><input id="lead-email" name="email" class="input" type="email" autocomplete="email" inputmode="email" placeholder="tu@email.com" required /></div>
            <div class="hp" aria-hidden="true"><label>Empresa <input name="empresa" tabindex="-1" autocomplete="off" /></label></div>
            <p class="err" data-lead-error role="alert" hidden></p>
            <button type="submit" class="btn" style="width:100%">Enviarme el capítulo</button>
            <span class="form-note">Sin spam. Te das de baja con un clic. <a href="/privacidad">Privacidad</a></span>
          </form>
          <div class="lead-done" id="lead-done" hidden>
            <b>¡Listo! Revisa tu email.</b>
            <span>Te enviamos el capítulo a <b id="lead-done-email"></b>. Si no lo ves en un par de minutos, revisa promociones o spam.</span>
          </div>
        </section>

        <section class="sec" aria-labelledby="cmp" data-solo="VE" hidden>
          <div class="sec-head"><h2 id="cmp">Ebook o libro impreso</h2><p>El mismo contenido en los dos formatos. Elige cómo quieres leerlo.</p></div>
          <div class="cmp-box">
            <table class="cmp">
              <thead><tr><th scope="col"><span class="sr-only">Detalle</span></th><th scope="col">Ebook</th><th scope="col">Libro impreso</th></tr></thead>
              <tbody>
                <tr><th scope="row">Precio</th><td class="num">{pe}</td><td class="num">{pp}</td></tr>
                <tr><th scope="row">Formato</th><td>PDF de 30 páginas, para leer en el celular o imprimir</td><td>Impreso a color</td></tr>
                <tr><th scope="row">Entrega</th><td><span class="ok"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d={check}></path></svg>Al instante, por email</span></td><td><b>Solo retiro en el local de Caripe.</b> No hacemos envíos a domicilio.</td></tr>
                <tr><th scope="row">Disponible en</th><td>Todos los países</td><td>Solo Venezuela</td></tr>
                <tr><th scope="row">Pago</th><td>Pago Móvil, Binance, tarjeta o PayPal</td><td>Pago Móvil, Binance o en el local</td></tr>
                <tr><th scope="row"><span class="sr-only">Acción</span></th><td><button type="button" class="btn btn-sm" data-buy={ebook.id}>Comprar ebook</button></td><td><button type="button" class="btn btn-sm btn-line" data-buy={print.id}>Reservar impreso</button></td></tr>
              </tbody>
            </table>
          </div>
        </section>

        <section class="sec" aria-labelledby="taller">
          <div class="shop">
            <div class="shop-copy">
              <h2 id="taller">Lo escribe un taller de fiestas de verdad</h2>
              <p>En Celebra hacemos piñatas, chupeteras y decoración para cumpleaños en Caripe, estado Monagas. Este libro reúne lo que aprendimos en el taller.</p>
              <p>Puedes visitarnos, ver el trabajo y retirar ahí tu libro impreso. El impreso solo se retira en el local: no hacemos envíos a domicilio.</p>
              <a class="link" href="#local">Ver ubicación y horario</a>
            </div>
            <div class="shots">
              <div class="s1"><img src="/img/pinata-real.jpg" alt="Piñata estrella en proceso en el taller Celebra" loading="lazy" /></div>
              <div class="s2"><div class="photo">Pronto: foto del local</div></div>
              <div class="s3"><div class="photo">Pronto: una mesa dulce terminada</div></div>
            </div>
          </div>
        </section>

        <section class="sec" aria-labelledby="ops">
          <div class="sec-head">
            <h2 id="ops">Lo que dicen nuestras clientas</h2>
            <p>Publicamos solo opiniones reales, y todas están en nuestra ficha de Google Maps, donde puedes leerlas completas. Si ya leíste el libro, nos ayuda mucho que dejes la tuya.</p>
            <div class="row-btns">
              <a class="btn btn-sm" href={c.googleMaps} target="_blank" rel="noopener">Ver opiniones en Google</a>
              <a class="btn btn-sm btn-line" href={c.googleReview} target="_blank" rel="noopener">Dejar mi opinión</a>
            </div>
          </div>
        </section>

        <section class="sec" aria-labelledby="como">
          <div class="sec-head"><h2 id="como">Comprar toma un par de minutos</h2></div>
          <div class="steps">
