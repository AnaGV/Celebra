---
import Base from '../layouts/Base.astro';
import BookCover from '../components/BookCover.astro';
import Checkout from '../components/Checkout.astro';
import Footer from '../components/Footer.astro';
import { site } from '../config/site';
import { products, mainProduct } from '../config/products';

const physical = products.find((p) => p.kind === 'fisico');
const wa = `https://wa.me/${site.contact.whatsapp}?text=${encodeURIComponent('Hola, tengo una pregunta sobre el libro Fiestas que se recuerdan')}`;

const chapters = [
  { n: 1, title: 'Planificar sin estrés: la fiesta en 6 semanas', page: 9 },
  { n: 2, title: 'Presupuesto real: cuánto cuesta cada cosa', page: 27 },
  { n: 3, title: 'Temáticas que funcionan para cada edad', page: 45 },
  { n: 4, title: 'Piñatas y chupeteras hechas en casa', page: 68 },
  { n: 5, title: 'Mesa dulce y cotillón con poco dinero', page: 94 },
  { n: 6, title: 'Juegos y animación sin contratar a nadie', page: 117 },
  { n: 7, title: 'El día de la fiesta: lista minuto a minuto', page: 135 },
];

const benefits = [
  { title: 'Un plan de 6 semanas', text: 'Qué hacer cada semana para llegar al día de la fiesta con todo listo y sin correr.' },
  { title: 'Presupuesto con números reales', text: 'Plantilla para calcular invitaciones, comida, decoración y recuerdos según el número de niños.' },
  { title: 'Piñatas paso a paso', text: 'Moldes y fotos del proceso para hacer piñatas de 40, 60 y 80 cm con materiales comunes.' },
  { title: 'Listas para imprimir', text: 'Checklist de compras, cronograma del día y tarjetas de agradecimiento listas para usar.' },
];

const faqs = [
  { q: '¿Cómo recibo el ebook?', a: 'Apenas se confirma el pago te llega un email con el botón de descarga y tu recibo. Si pagas con Binance o Pago Móvil, lo enviamos al verificar el pago, normalmente en menos de 2 horas en horario laboral.' },
  { q: 'No me llegó el email, ¿qué hago?', a: 'Revisa la carpeta de spam o promociones. Si no está, escríbenos por WhatsApp con tu código de pedido y te lo reenviamos.' },
  { q: '¿Puedo pagar desde Venezuela?', a: 'Sí. Puedes pagar con Binance Pay (USDT), con Pago Móvil en bolívares o con tarjeta internacional y PayPal.' },
  { q: '¿En qué formato viene y dónde lo leo?', a: 'En PDF y EPUB. Lo puedes leer en el celular, la tablet, el computador o un lector de libros electrónicos, e imprimir las listas.' },
  { q: '¿Hay versión impresa?', a: 'Sí, el libro impreso a color se vende solo con retiro en nuestro local de Caripe, estado Monagas. Puedes reservarlo online y pagar al retirar.' },
  { q: '¿Puedo pedir un reembolso?', a: 'Como es un libro digital que recibes al instante, no hacemos devoluciones una vez entregado. Si no te llega o el archivo no abre, te ayudamos por WhatsApp; y si no logramos entregártelo, te devolvemos el dinero.' },
];
---

<Base
  title="Fiestas que se recuerdan"
  description="Guía práctica para organizar fiestas infantiles con poco presupuesto. Ebook con entrega inmediata y libro impreso con retiro en Caripe."
>
  <header class="topbar">
    <div class="wrap topbar-inner">
      <a href="#inicio" class="wordmark">{site.brand.name}</a>
      <nav aria-label="Secciones" class="topnav">
        <a href="#muestra">Muestra gratis</a>
        <a href="#preguntas">Preguntas</a>
        <a href="#local">Local</a>
      </nav>
      <button type="button" class="btn btn-small" data-buy={mainProduct.id}>Comprar</button>
    </div>
  </header>

  <main id="inicio">
    <!-- HERO -->
    <section class="hero">
      <svg class="garland" viewBox="0 0 1200 60" preserveAspectRatio="none" aria-hidden="true">
        <path d="M0 6 Q600 46 1200 6" fill="none" stroke="currentColor" stroke-width="1.5"></path>
        {Array.from({ length: 24 }, (_, i) => {
          const x = 25 + i * 50;
          const t = x / 1200;
          const y = 6 + 4 * 40 * t * (1 - t);
          const fills = ['#e8326e', '#f2b33d', '#2fa68a', '#4b6fd6'];
          return <path d={`M${x - 17} ${y} L${x + 17} ${y} L${x} ${y + 22} Z`} fill={fills[i % 4]} />;
        })}
      </svg>
      <div class="wrap hero-grid">
        <div class="hero-copy">
          <p class="eyebrow">Ebook · Libro impreso en Caripe</p>
          <h1>Organiza fiestas infantiles inolvidables sin gastar de más</h1>
          <p class="lead">
            La guía que usamos en nuestro taller para planificar cumpleaños, hacer piñatas en casa y
            calcular cada gasto antes de comprar.
          </p>

          <div class="price-row">
            <div>
              <span class="price mono">USD {mainProduct.priceUsd}</span>
              <span class="muted price-note">ebook · {mainProduct.format}</span>
            </div>
            {physical && (
              <div>
                <span class="price price-alt mono">USD {physical.priceUsd}</span>
                <span class="muted price-note">impreso · retiro en Caripe</span>
              </div>
            )}
          </div>

          <div class="hero-actions">
            <button type="button" class="btn" data-buy={mainProduct.id}>Comprar el ebook</button>
            <a href="#muestra" class="btn btn-ghost">Leer un capítulo gratis</a>
          </div>
          <ul class="trust" aria-label="Detalles de la compra">
            <li>Descarga inmediata por email</li>
            <li>Tarjeta, PayPal, Binance o Pago Móvil</li>
            <li>Recibo de cada compra</li>
          </ul>
        </div>
        <div class="hero-book">
          <BookCover class="cover" />
          <span class="stamp mono">Ejemplo de portada</span>
        </div>
      </div>
    </section>

    <!-- BENEFICIOS -->
    <section class="section">
      <div class="wrap">
        <div class="section-head">
          <p class="eyebrow">Qué vas a encontrar</p>
          <h2>Todo lo que necesitas para la próxima fiesta, en orden</h2>
        </div>
        <div class="benefits">
          {benefits.map((b) => (
            <article class="benefit">
              <svg viewBox="0 0 32 32" width="32" height="32" aria-hidden="true">
                <path d="M16 3l3.6 8.2 8.9.8-6.8 5.9 2 8.7L16 22l-7.7 4.6 2-8.7L3.5 12l8.9-.8z" fill="var(--sol)"></path>
              </svg>
              <h3>{b.title}</h3>
              <p class="muted">{b.text}</p>
            </article>
          ))}
        </div>
        <div class="for-whom">
          <p><strong>Es para ti si</strong> vas a organizar el cumpleaños de tus hijos, sobrinos o nietos y quieres que se vea bonito sin endeudarte.</p>
          <p><strong>No es para ti si</strong> buscas contratar una empresa de eventos que lo haga todo por ti.</p>
        </div>
      </div>
    </section>

    <!-- MUESTRA GRATIS -->
    <section class="section band" id="muestra">
      <div class="wrap sample-grid">
        <div class="toc">
          <p class="eyebrow">Índice</p>
          <h2>7 capítulos, 148 páginas</h2>
          <ol class="toc-list">
            {chapters.map((c) => (
              <li>
                <span class="toc-n mono">{String(c.n).padStart(2, '0')}</span>
                <span class="toc-title">{c.title}</span>
                <span class="toc-page mono">p. {c.page}</span>
              </li>
            ))}
          </ol>
        </div>
        <div class="sample-card">
          <h3>Lee el capítulo 2 gratis</h3>
          <p class="muted">Te enviamos por email el capítulo de presupuesto con la plantilla para calcular tu próxima fiesta.</p>
          <form id="lead-form" class="lead-form" novalidate>
            <div class="field">
              <label for="lead-name">Tu nombre</label>
              <input id="lead-name" class="input" name="name" autocomplete="given-name" placeholder="María" />
            </div>
            <div class="field">
              <label for="lead-email">Tu email</label>
              <input id="lead-email" class="input" type="email" name="email" autocomplete="email" inputmode="email" required placeholder="tu@email.com" />
            </div>
            <div class="hp" aria-hidden="true">
              <label for="lead-empresa">Empresa</label>
              <input id="lead-empresa" name="empresa" tabindex="-1" autocomplete="off" />
            </div>
            <button type="submit" class="btn btn-block">Enviarme el capítulo</button>
            <p id="lead-error" class="hint" role="alert" hidden></p>
            <p class="hint muted">Sin spam. Puedes darte de baja con un clic.</p>
          </form>
          <p id="lead-done" class="lead-done" hidden>Listo. Revisa tu email en unos minutos{site.demoMode ? ' (modo demo: no se envió nada)' : ''}.</p>
        </div>
      </div>
    </section>

    <!-- AUTORA -->
    <section class="section">
      <div class="wrap about">
        <figure class="portrait" aria-label="Foto de ejemplo de la autora">
          <svg viewBox="0 0 240 280" aria-hidden="true">
            <rect width="240" height="280" fill="var(--sunk)"></rect>
            <circle cx="120" cy="112" r="52" fill="var(--line)"></circle>
            <path d="M28 280c8-62 46-96 92-96s84 34 92 96z" fill="var(--line)"></path>
          </svg>
          <figcaption class="mono">Tu foto aquí</figcaption>
        </figure>
        <div class="about-copy">
          <p class="eyebrow">Quién escribe</p>
          <h2>Hola, soy {site.brand.authorName}</h2>
          <p>
            Desde nuestro taller en Caripe hacemos piñatas, chupeteras y decoración para fiestas de toda la zona.
            Después de cientos de cumpleaños aprendimos qué vale la pena comprar, qué se puede hacer en casa y
            cómo evitar las carreras del último día.
          </p>
          <p class="muted">Escribí este libro para que cualquier familia pueda organizar una fiesta bonita con lo que tiene.</p>
          <div class="socials">
            <a href={site.contact.instagram} target="_blank" rel="noopener">Instagram {site.contact.instagramHandle}</a>
            <a href={site.contact.tiktok} target="_blank" rel="noopener">TikTok</a>
            <a href={site.contact.facebook} target="_blank" rel="noopener">Facebook</a>
          </div>
        </div>
      </div>
    </section>

    <!-- OPINIONES -->
    <section class="section band">
      <div class="wrap">
        <div class="section-head">
          <p class="eyebrow">Opiniones</p>
          <h2>Lo que dicen quienes ya lo usaron</h2>
          <p class="placeholder-note mono">Ejemplos de formato: reemplazar por opiniones reales con permiso de cada persona.</p>
        </div>
        <div class="quotes">
          <blockquote class="quote">
            <p>“La plantilla de presupuesto me ayudó a ver que gastaba casi la mitad en cotillón. Este año hice los recuerdos en casa.”</p>
            <footer>Nombre Apellido · Maturín</footer>
          </blockquote>
          <blockquote class="quote">
            <p>“Hice la piñata de 60 cm siguiendo el capítulo 4 con mi hija. Quedó igualita a la foto.”</p>
            <footer>Nombre Apellido · Santiago de Chile</footer>
          </blockquote>
          <blockquote class="quote">
            <p>“El cronograma del día de la fiesta es lo mejor. Lo imprimí y lo pegué en la nevera.”</p>
            <footer>Nombre Apellido · Caripe</footer>
          </blockquote>
        </div>
      </div>
    </section>

    <!-- CÓMO COMPRAR -->
    <section class="section">
      <div class="wrap">
        <div class="section-head">
          <p class="eyebrow">Cómo comprar</p>
          <h2>Tres pasos y lo tienes en tu email</h2>
        </div>
        <ol class="steps">
          <li><span class="step-n mono">1</span><h3>Elige cómo pagar</h3><p class="muted">Te mostramos los métodos disponibles en tu país.</p></li>
          <li><span class="step-n mono">2</span><h3>Paga de forma segura</h3><p class="muted">Tarjeta y PayPal se procesan en Lemon Squeezy. Nunca vemos los datos de tu tarjeta.</p></li>
          <li><span class="step-n mono">3</span><h3>Descarga tu libro</h3><p class="muted">Recibes el ebook y tu recibo por email.</p></li>
        </ol>
        <div class="methods">
          <div><span class="method-region">En todo el mundo</span><span class="chip">Visa</span><span class="chip">Mastercard</span><span class="chip">PayPal</span><span class="chip">Apple Pay</span><span class="chip">Google Pay</span><span class="chip">Binance Pay</span></div>
          <div><span class="method-region">En Venezuela, además</span><span class="chip">Pago Móvil</span><span class="chip">Pago en el local</span></div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section band" id="preguntas">
      <div class="wrap narrow">
        <div class="section-head">
          <p class="eyebrow">Preguntas frecuentes</p>
          <h2>Antes de comprar</h2>
        </div>
        <div class="faq">
          {faqs.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
        <p class="faq-more muted">¿Otra duda? <a href={wa} target="_blank" rel="noopener">Escríbenos por WhatsApp</a> al <span class="mono">{site.contact.whatsappDisplay}</span>.</p>
      </div>
    </section>

    <!-- LOCAL -->
    <section class="section" id="local">
      <div class="wrap local">
        <div class="local-copy">
          <p class="eyebrow">Visítanos</p>
          <h2>Nuestro local en Caripe</h2>
          <p>{site.location.address}</p>
          <table class="hours">
            <caption class="sr-only">Horario de atención</caption>
            <tbody>
              {site.location.hours.map((h) => (
                <tr><th scope="row">{h.days}</th><td class="mono">{h.time}</td></tr>
              ))}
            </tbody>
          </table>
          <p class="muted">Aquí retiras el libro impreso y tus pedidos de piñatas y chupeteras.</p>
          <a class="btn btn-ghost" href={site.location.mapsUrl} target="_blank" rel="noopener">Cómo llegar en Google Maps</a>
        </div>
        <div class="local-media">
          {site.location.mapsEmbedUrl ? (
            <iframe class="map" src={site.location.mapsEmbedUrl} title="Mapa del local" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
          ) : (
            <a class="map map-placeholder" href={site.location.mapsUrl} target="_blank" rel="noopener">
              <svg viewBox="0 0 400 260" aria-hidden="true" preserveAspectRatio="xMidYMid slice">
                <rect width="400" height="260" fill="var(--sunk)"></rect>
                <path d="M0 190 C80 150 140 210 220 170 S340 120 400 150" fill="none" stroke="var(--line)" stroke-width="14"></path>
                <path d="M120 0 L170 260 M300 0 L250 260" stroke="var(--line)" stroke-width="8"></path>
                <path d="M0 90 L400 70" stroke="var(--line)" stroke-width="6"></path>
                <g transform="translate(208 108)"><path d="M0 34 C-14 16 -20 8 -20 -2 a20 20 0 0 1 40 0 c0 10 -6 18 -20 36z" fill="var(--fiesta)"></path><circle cy="-2" r="7" fill="var(--surface)"></circle></g>
              </svg>
              <span class="map-label">Abrir en Google Maps</span>
            </a>
          )}
          <div class="photos">
            <div class="photo">Foto de la fachada</div>
            <div class="photo">Foto del interior</div>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA FINAL -->
    <section class="section final">
      <div class="wrap final-inner">
        <BookCover class="final-cover" />
        <div class="final-copy">
          <h2>Tu próxima fiesta empieza con este libro</h2>
          <p class="lead">USD {mainProduct.priceUsd} · descarga inmediata · paga como prefieras</p>
          <button type="button" class="btn" data-buy={mainProduct.id}>Comprar el ebook</button>
        </div>
      </div>
    </section>
  </main>

  <Footer />

  <!-- Elementos fijos -->
  <a class="wa-float" href={wa} target="_blank" rel="noopener" aria-label="Escríbenos por WhatsApp">
    <svg viewBox="0 0 32 32" width="28" height="28" aria-hidden="true"><path fill="currentColor" d="M16 3a13 13 0 0 0-11.2 19.6L3 29l6.6-1.7A13 13 0 1 0 16 3zm0 23.6c-2 0-3.9-.5-5.6-1.5l-.4-.2-3.9 1 1-3.8-.3-.4A10.6 10.6 0 1 1 16 26.6zm5.8-7.9c-.3-.2-1.9-.9-2.2-1-.3-.1-.5-.2-.7.2l-1 1.2c-.2.2-.4.2-.7.1-1.9-.9-3.1-1.7-4.3-3.8-.3-.6.3-.5.9-1.7.1-.2 0-.4 0-.6l-1-2.4c-.3-.6-.5-.5-.7-.5h-.6c-.2 0-.6.1-.9.4-.3.3-1.2 1.2-1.2 2.9s1.2 3.4 1.4 3.6c.2.2 2.4 3.7 5.9 5.2 2.2.9 3 1 4.1.8.7-.1 1.9-.8 2.2-1.5.3-.8.3-1.4.2-1.5-.1-.1-.3-.2-.6-.4z"></path></svg>
  </a>
  <div class="buybar" aria-label="Comprar">
    <div><strong>Ebook</strong> <span class="mono">USD {mainProduct.priceUsd}</span></div>
    <button type="button" class="btn btn-small" data-buy={mainProduct.id}>Comprar</button>
  </div>

  <Checkout />
</Base>

<script>
  import { track } from '../lib/analytics';
  import { mainProduct } from '../config/products';
  import { site } from '../config/site';
  import { detectCountry } from '../lib/country';

  track('ViewContent', { content_ids: [mainProduct.id], value: mainProduct.priceUsd, currency: 'USD' });

  const form = document.getElementById('lead-form') as HTMLFormElement;
  const done = document.getElementById('lead-done')!;
  const errorEl = document.getElementById('lead-error')!;
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const email = form.querySelector<HTMLInputElement>('#lead-email')!;
    const nombre = form.querySelector<HTMLInputElement>('#lead-name')!;
    const empresa = form.querySelector<HTMLInputElement>('#lead-empresa')!;
    const valid = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email.value.trim());
    email.setAttribute('aria-invalid', valid ? 'false' : 'true');
    if (!valid) { email.focus(); return; }

    const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    btn.disabled = true;
    btn.textContent = 'Enviando…';
    errorEl.hidden = true;
    // El mismo event_id va al Pixel y a la API de conversiones (n8n), así Meta cuenta un solo Lead.
    const eventId = `lead-${crypto.randomUUID()}`;
    const params = new URLSearchParams(location.search);
    const utm = ['utm_source', 'utm_medium', 'utm_campaign'].map((k) => params.get(k) ?? '').join('|');
    try {
      if (site.demoMode) {
        await new Promise((r) => setTimeout(r, 600));
      } else {
        const res = await fetch(site.payments.leadEndpoint, {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ nombre: nombre.value.trim(), email: email.value.trim(), pais: detectCountry(), utm, event_id: eventId, empresa: empresa.value }),
        });
        const out = await res.json().catch(() => ({}));
        if (!res.ok || !out.ok) throw new Error(out.error || 'error');
      }
      track('Lead', { content_name: 'capitulo-2' }, eventId);
      form.hidden = true;
      done.hidden = false;
    } catch (err) {
      btn.disabled = false;
      btn.textContent = 'Enviarme el capítulo';
      errorEl.textContent = err instanceof Error && err.message !== 'error' ? err.message : 'No pudimos enviarlo. Inténtalo de nuevo en un momento.';
      errorEl.hidden = false;
    }
  });
</script>

<style>
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  .topbar {
    position: sticky; top: env(safe-area-inset-top, 0px); z-index: 20;
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .topbar-inner { display: flex; align-items: center; gap: 1.25rem; min-height: 64px; }
  .wordmark { font-family: var(--font-display); font-size: var(--step-1); text-decoration: none; margin-right: auto; }
  .topnav { display: none; gap: 1.25rem; }
  .topnav a { text-decoration: none; color: var(--muted); font-weight: 700; font-size: var(--step--1); }
  .topnav a:hover { color: var(--ink); }
  @media (min-width: 760px) { .topnav { display: flex; } }
  .btn-small { min-height: 42px; padding: 0.5rem 1.1rem; font-size: var(--step--1); }

  .hero { position: relative; padding-block: 3.5rem 4rem; overflow: hidden; }
  .garland { position: absolute; top: 0; left: 0; width: 100%; height: 56px; color: var(--muted); }
  .hero-grid { display: grid; gap: 2.5rem; align-items: center; }
  @media (min-width: 860px) { .hero-grid { grid-template-columns: 1.15fr 0.85fr; gap: 3.5rem; } }
  .hero-copy { display: grid; gap: 1.25rem; min-width: 0; }
  .hero h1 { font-size: var(--step-4); }
  .price-row { display: flex; flex-wrap: wrap; gap: 0.5rem 2rem; }
  .price-row > div { display: grid; }
  .price { font-size: var(--step-2); color: var(--fiesta); }
  .price-alt { color: var(--ink); }
  .price-note { font-size: 0.85rem; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .trust { display: flex; flex-wrap: wrap; gap: 0.4rem 1.2rem; margin: 0; padding: 0; list-style: none; font-size: 0.88rem; color: var(--muted); }
  .trust li { display: flex; align-items: center; gap: 0.4rem; }
  .trust li::before { content: ''; width: 7px; height: 7px; border-radius: 50%; background: var(--ok); }
  .hero-book { position: relative; justify-self: center; width: min(340px, 78vw); }
  .cover { display: block; width: 100%; height: auto; border-radius: 6px; box-shadow: var(--shadow), 18px 22px 0 -6px var(--fiesta-soft); transform: rotate(-2.5deg); }
  .stamp {
    position: absolute; right: -0.5rem; bottom: 1rem;
    background: var(--sol); color: #2b1d00; font-size: 0.72rem; padding: 0.3rem 0.6rem; border-radius: 4px; transform: rotate(4deg);
  }

  .benefits { display: grid; gap: 1.25rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 230px), 1fr)); }
  .benefit { display: grid; gap: 0.6rem; align-content: start; padding: 1.4rem; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); }
  .for-whom { margin-top: 2rem; display: grid; gap: 0.6rem; max-width: 46rem; }

  .band { background: var(--sunk); }
  .sample-grid { display: grid; gap: 2.5rem; }
  @media (min-width: 860px) { .sample-grid { grid-template-columns: 1.2fr 0.8fr; align-items: start; } }
  .toc { display: grid; gap: 1rem; min-width: 0; }
  .toc-list { list-style: none; margin: 0.5rem 0 0; padding: 0; display: grid; }
  .toc-list li { display: grid; grid-template-columns: 2.4rem 1fr auto; gap: 0.75rem; align-items: baseline; padding-block: 0.7rem; border-bottom: 1px dashed var(--line); }
  .toc-n { color: var(--fiesta); }
