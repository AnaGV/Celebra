---
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';
import HomeNav from '../components/HomeNav.astro';
import '../styles/home.css';
import { site } from '../config/site';
import { mainProduct } from '../config/products';
import { tipos, packs, servicios } from '../config/celebra';

const c = site.contact;
const loc = site.location;
const wa = (txt: string) => `https://wa.me/${c.localWhatsapp}?text=${encodeURIComponent(txt)}`;
const precio = (p: number | null) => (p == null ? 'Precio a consultar' : `Desde USD ${p}`);
const propios = servicios.filter((s) => s.kind === 'propio');
const aliados = servicios.filter((s) => s.kind === 'aliado');
const hoy = new Date().toISOString().slice(0, 10);
---

<Base
  image="/img/og-celebra.jpg"
  title="Celebra · Taller de fiestas en Caripe: piñatas, packs y decoración"
  description="Piñatas a medida, chupeteras, packs por número de invitados y decoración para cumpleaños, baby shower, bautizos y XV años en Caripe, Monagas. Reserva tu fecha por WhatsApp."
>
  <div class="home">
    <HomeNav />

    <main>
      <section class="h-slider" aria-roledescription="carrusel" aria-label="Trabajos del taller">
        <div class="h-slides">
          {[
            { bg: 'fondo-1', color: '#efe7ff', kick: 'Hechas a mano en Caripe', t: 'Piñatas a medida', d: 'Con la forma, la temática y los colores que tu peque sueña.', imgs: [['monstruo', 'Piñata de monstruo de colores'], ['corona', 'Piñata corona amarilla con flores'], ['mono', 'Piñata de selva con monito']] },
            { bg: 'fondo-2', color: '#fbe6ee', kick: 'Para la mesa dulce', t: 'Chupeteras con mucho dulce', d: 'Personajes y temáticas hechos a mano, listos para la foto.', imgs: [['chupetera-nina', 'Chupetera de niña con dulces'], ['chupetera-dino', 'Chupetera de dinosaurio con dulces']] },
            { bg: 'fondo-3', color: '#e3f5ff', kick: 'Su número, su nombre', t: 'Piñatas con número', d: 'El primer añito, el quinto o el que celebren: lo armamos con su temática.', imgs: [['numero-dino', 'Piñata número 1 con dinosaurios'], ['numero-granja', 'Piñata número 1 con animales de granja']] },
          ].map((sl, i) => (
            <div class:list={['h-slide', { on: i === 0 }]} role="group" aria-roledescription="diapositiva" aria-label={`${i + 1} de 3`} aria-hidden={i === 0 ? undefined : 'true'} style={`--c:${sl.color}`}>
              <picture class="h-slide-bg" aria-hidden="true">
                <source media="(max-width: 760px)" srcset={`/img/banner/${sl.bg}-m.webp`} />
                <img src={`/img/banner/${sl.bg}.webp`} alt="" loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : undefined} onerror="this.style.display='none'" />
              </picture>
              <div class="h-wrap h-slide-in">
                <div class="h-slide-txt">
                  <span class="h-kicker">{sl.kick}</span>
                  <p class="h-slide-t">{sl.t}</p>
                  <p class="h-slide-d">{sl.d}</p>
                  <div class="h-btns">
                    <a class="h-btn" href="#reservar" tabindex={i === 0 ? undefined : '-1'}>Cotizar el mío</a>
                    <a class="h-btn h-btn-line" href={c.instagram} target="_blank" rel="noopener" tabindex={i === 0 ? undefined : '-1'}>Ver más trabajos</a>
                  </div>
                </div>
                <div class:list={['h-slide-prods', `n${sl.imgs.length}`]}>
                  {sl.imgs.map(([f, alt]) => <img src={`/img/banner/${f}.webp`} alt={alt} loading={i === 0 ? 'eager' : 'lazy'} />)}
                </div>
              </div>
            </div>
          ))}
        </div>
        <button type="button" class="h-sl-arrow prev" aria-label="Anterior"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7"></path></svg></button>
        <button type="button" class="h-sl-arrow next" aria-label="Siguiente"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7"></path></svg></button>
        <div class="h-sl-dots" role="tablist" aria-label="Elegir diapositiva">
          {[0, 1, 2].map((i) => <button type="button" role="tab" aria-selected={i === 0 ? 'true' : 'false'} aria-label={`Diapositiva ${i + 1}`}></button>)}
        </div>
      </section>

      <section class="h-wrap h-top" id="fiestas" aria-labelledby="t-top">
        <div class="h-intro">
          <div class="h-top-head rv">
            <span class="h-kicker">Taller de fiestas · Caripe, Monagas</span>
            <h1 id="t-top">¿Qué fiesta estás <em>organizando?</em></h1>
            <p class="h-lead">Piñatas, chupeteras y decoración hechas a mano en nuestro taller. Elige tu celebración y te mostramos todo lo que podemos hacer.</p>
          </div>
        </div>
        <div class="h-banners">
          {tipos.map((t, i) => (
            <a class:list={['h-banner rv', { big: i === 0 }]} href={`/fiestas/${t.slug}/`} style={`--bg:${t.bg};--ink:${t.ink};--d:${i * 70}ms`}>
              <span class="h-banner-txt">
                <b>{t.name}</b>
                <span>{t.short}</span>
                <span class="h-banner-cta">Ver más →</span>
              </span>
              <img class="h-banner-art" src={t.img} alt="" loading="lazy" />
            </a>
          ))}
        </div>
      </section>

      <section class="h-sec h-wrap" id="servicios" aria-labelledby="t-serv">
        <div class="h-head rv">
          <span class="h-kicker">Servicios</span>
          <h2 id="t-serv">Todo para tu fiesta, en un solo lugar</h2>
          <p>Lo que hacemos en el taller y los proveedores de Caripe que trabajan con nosotras.</p>
        </div>
        <div class="h-servs">
          {[...propios, ...aliados].map((s, i) => (
            <div class="h-serv rv" style={`--d:${(i % 4) * 60}ms`}>
              <span class:list={['h-serv-ico', s.kind]}><svg viewBox="0 0 24 24" aria-hidden="true"><path d={s.icon}></path></svg></span>
              <div><b>{s.name}</b><p>{s.desc}</p>{s.kind === 'aliado' && <span class="h-badge">Proveedor aliado</span>}</div>
            </div>
          ))}
        </div>
        <div class="h-btns rv" style="margin-top:24px"><a class="h-btn h-btn-line" href="/servicios/">Ver todos los servicios</a></div>
      </section>

      <section class="h-sec h-wrap" id="reservar" aria-labelledby="t-res">
        <div class="h-res rv">
          <div class="h-res-info">
            <span class="h-kicker">Reservar</span>
            <h2 id="t-res">Cotiza y reserva la fecha de tu fiesta</h2>
            <ol class="h-res-steps">
              <li><b>Cuéntanos qué necesitas:</b> un pack completo o solo la piñata, la chupetera o el cotillón.</li>
              <li><b>Te confirmamos disponibilidad</b> el mismo día, con el precio final por escrito.</li>
              <li><b>Con un abono reservamos tu fecha</b> y empezamos a trabajar a mano.</li>
              <li><b>Retiras en el local</b> el día acordado.</li>
            </ol>
            <p class="h-fine">Pide con 2 a 3 semanas de anticipación: los fines de semana se llenan primero.</p>
          </div>
          <form class="h-form" id="res-form" novalidate>
            <label>Tipo de fiesta
              <select name="tipo">{tipos.map((t) => <option>{t.name}</option>)}<option value="otra">Otra</option></select>
            </label>
            <label class="h-cond" data-show-if="otra" hidden>¿Qué celebras?<input type="text" name="tipoOtra" placeholder="Ej. Aniversario, despedida, día del niño…" /></label>
            <div class="h-form-2">
              <label class="h-date">Fecha de la fiesta<input type="date" name="fecha" min={hoy} required /><span class="h-date-ph" aria-hidden="true">Elige el día</span></label>
              <label>Invitados<input type="number" name="invitados" min="1" inputmode="numeric" placeholder="Ej. 25" /></label>
            </div>
            <fieldset class="h-need">
              <legend>¿Qué necesitas? <span>Marca todo lo que quieras cotizar</span></legend>
              <div class="h-chk">
                {['Piñata', 'Chupetera', 'Cotillón', 'Bolsitas de recuerdo', 'Globos y decoración', 'Cartel con nombre', 'Invitación digital'].map((x) => (
                  <label><input type="checkbox" name="necesito" value={x} /><span>{x}</span></label>
                ))}
                <label><input type="checkbox" name="necesito" value="pack" data-pack-toggle /><span>Un pack completo</span></label>
                <label><input type="checkbox" name="necesito" value="otro" data-otro-toggle /><span>Otra cosa</span></label>
              </div>
            </fieldset>
            <label class="h-cond" data-pack-field hidden>¿Cuál pack?
              <select name="pack">{packs.map((p) => <option value={p.name} data-id={p.id} selected={p.destacado}>{p.name} · {p.invitados.replace(' invitados', '').toLowerCase()}</option>)}</select>
            </label>
            <label class="h-cond" data-otro-field hidden>¿Qué otra cosa necesitas?<input type="text" name="otro" placeholder="Ej. centro de mesa, fondo para fotos…" /></label>
            <label>Temática<input type="text" name="tematica" placeholder="Ej. Estrellita arcoíris, dinosaurios…" /></label>
            <div class="h-ref">
              <span class="h-ref-t">Foto de referencia <span>(opcional)</span></span>
              <label class="h-ref-box">
                <input type="file" name="foto" accept="image/jpeg,image/png,image/webp,image/heic,image/heif" />
                <span class="h-ref-empty"><svg class="h-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h3l2-3h6l2 3h3v12H4zM12 17a4 4 0 100-8 4 4 0 000 8z"></path></svg>Sube una imagen de lo que te gusta</span>
                <img class="h-ref-img" alt="Tu foto de referencia" hidden />
              </label>
              <p class="h-ref-estado" role="status" hidden></p>
              <p class="h-ref-note">Una captura de Pinterest, Instagram o una foto de otra fiesta nos ayuda a cotizar justo lo que quieres. La foto se borra apenas la vemos.</p>
            </div>
            <label>Tu nombre<input type="text" name="nombre" autocomplete="name" required /></label>
            <button class="h-btn" type="submit">
              <svg class="h-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20l1.3-4A8 8 0 1112 20a8 8 0 01-4-1.1z"></path></svg>
              Enviar por WhatsApp
            </button>
            <p class="h-form-err" role="alert" hidden></p>
            <div class="h-form-ok" role="status" hidden><b>No pudimos subir tu foto.</b> En WhatsApp, toca el clip 📎 y adjúntala antes de enviar el mensaje.</div>
          </form>
        </div>
      </section>

      <section class="h-sec h-wrap" aria-labelledby="t-sal">
        <div class="h-duo">
          <a class="h-tile rv" href="/salones/" style="--bg:#e3f5ff;--ink:#0f6fa3">
            <span class="h-kicker">Salones en Caripe</span>
            <b id="t-sal">¿Dónde hacer la fiesta?</b>
            <span>Los salones y espacios de eventos de Caripe, reunidos en un solo lugar. ¿Tienes un salón? Publícalo con nosotras.</span>
            <span class="h-banner-cta">Ver salones →</span>
          </a>
          <a class="h-tile rv" href="/calculadora/" style="--bg:#fef9dc;--ink:#866a00;--d:80ms">
            <span class="h-kicker">Cotiza gratis</span>
            <b>Calcula el presupuesto de tu fiesta</b>
            <span>Pon cuánto quieres gastar y cuántos niños vienen. La calculadora lo reparte en torta, comida, piñata, decoración y más.</span>
            <span class="h-banner-cta">Usar la calculadora →</span>
          </a>
        </div>
      </section>

      <section class="h-sec h-wrap" aria-labelledby="t-libro">
        <div class="h-book rv">
          <a class="h-book-cover" href="/libro/" tabindex="-1" aria-hidden="true"><img src="/img/portada-a.jpg" width="900" height="1355" alt="" loading="lazy" /></a>
          <div class="h-book-txt">
            <span class="h-kicker">¿Prefieres hacerla tú misma?</span>
            <h2 id="t-libro">Fiestas que se recuerdan</h2>
            <p>Nuestra guía para organizar el cumpleaños en casa y gastar menos: presupuesto, invitación, la piñata estrella paso a paso con su molde, la mesa principal y checklists para imprimir.</p>
            <p class="h-price"><b>USD {mainProduct.priceUsd}</b> · ebook en PDF, llega a tu correo</p>
            <div class="h-btns">
              <a class="h-btn" href="/libro/">Ver el libro</a>
              <a class="h-btn h-btn-line" href="/libro/regalo/">Capítulo de regalo</a>
            </div>
          </div>
        </div>
      </section>

      <section class="h-sec h-wrap" id="local" aria-labelledby="t-local">
        <div class="h-head rv">
          <span class="h-kicker">Visítanos</span>
          <h2 id="t-local">Nuestro local en Caripe</h2>
        </div>
        <div class="h-visit">
          <div class="h-vbox rv">
            <h3>Horario</h3>
            <dl>{loc.hours.map((h) => (<><dt>{h.days}</dt><dd>{h.time}</dd></>))}</dl>
          </div>
          <div class="h-vbox rv" style="--d:70ms">
            <h3>Dónde estamos</h3>
            <p>Caripe, estado Monagas, Venezuela. Solo retiro en el local, no hacemos envíos.</p>
            <a class="h-link" href={c.googleMaps} target="_blank" rel="noopener">Ver la ubicación en Google Maps →</a>
          </div>
          <div class="h-vbox rv" style="--d:140ms">
            <h3>Escríbenos</h3>
            <a class="h-link" href={wa('¡Hola Celebra!')} target="_blank" rel="noopener">WhatsApp {c.localWhatsappDisplay}</a>
            <a class="h-link" href={c.instagram} target="_blank" rel="noopener">Instagram {c.instagramHandle}</a>
            <a class="h-link" href={`mailto:${site.brand.email}`}>{site.brand.email}</a>
          </div>
        </div>
      </section>
    </main>
    <Footer />
  </div>
</Base>

<script define:vars={{ waNum: c.localWhatsapp }}>
  const f = document.getElementById('res-form');
  const $ = (q) => f.querySelector(q);
  const packToggle = $('[data-pack-toggle]');
  const otroToggle = $('[data-otro-toggle]');
  const sync = () => {
    $('[data-show-if="otra"]').hidden = $('select[name="tipo"]').value !== 'otra';
    $('[data-pack-field]').hidden = !packToggle.checked;
    $('[data-otro-field]').hidden = !otroToggle.checked;
  };
  f.addEventListener('change', sync);
  sync();

  // Selector de invitados → resalta el pack recomendado.
  const pick = (id, marcar) => {
    document.querySelectorAll('.h-guest').forEach((b) => b.setAttribute('aria-checked', String(b.dataset.pack === id)));
    document.querySelectorAll('.h-pack').forEach((c) => c.classList.toggle('on', c.dataset.packCard === id));
    const card = document.querySelector(`[data-pack-card="${id}"] h3`);
    if (card) $('select[name="pack"]').value = card.textContent;
    if (marcar) { packToggle.checked = true; sync(); }
  };
  document.querySelectorAll('.h-guest').forEach((b) => b.addEventListener('click', () => pick(b.dataset.pack, false)));
  // Viene desde /packs/ con ?pack=…: deja marcado ese pack en el formulario.
  const qp = new URLSearchParams(location.search).get('pack');
  if (qp && document.querySelector(`[data-pack-card="${qp}"]`) === null) {
    const opt = [...$('select[name="pack"]').options].find((o) => o.dataset.id === qp);
    if (opt) { $('select[name="pack"]').value = opt.value; packToggle.checked = true; sync(); }
    history.replaceState(null, '', location.pathname);
  }
  document.querySelectorAll('[data-pick]').forEach((a) => a.addEventListener('click', () => pick(a.dataset.pick, true)));

  // Foto de referencia: se achica y se sube apenas la eligen (no al enviar),
  // así el botón Enviar abre WhatsApp al instante y el celular no lo bloquea.
  const foto = $('input[name="foto"]');
  const btn = $('button[type="submit"]');
  const btnHtml = btn.innerHTML;
  const estado = $('.h-ref-estado');
  let fotoUrl = '';
  let subiendo = null;
  const achicar = async (file) => {
    const bmp = await createImageBitmap(file);
    if (bmp.width * bmp.height > 60_000_000) throw new Error('enorme');
    const k = Math.min(1, 1600 / Math.max(bmp.width, bmp.height));
    const cv = document.createElement('canvas');
    cv.width = Math.round(bmp.width * k); cv.height = Math.round(bmp.height * k);
    const cx = cv.getContext('2d'); cx.fillStyle = '#ffffff'; cx.fillRect(0, 0, cv.width, cv.height);
    cx.drawImage(bmp, 0, 0, cv.width, cv.height);
    return new Promise((ok) => cv.toBlob(ok, 'image/jpeg', 0.82));
  };
  foto.addEventListener('change', async () => {
    const file = foto.files && foto.files[0];
    const img = $('.h-ref-img');
    fotoUrl = '';
    if (!file) { img.hidden = true; $('.h-ref-empty').hidden = false; estado.hidden = true; return; }
    // Límites antes de procesar: solo imágenes y hasta 20 MB (las fotos de celular pesan 2-8 MB).
    if (!/^image\//.test(file.type) || file.size > 20 * 1024 * 1024) {
      foto.value = ''; img.hidden = true; $('.h-ref-empty').hidden = false;
      estado.hidden = false; estado.dataset.s = 'err';
      estado.textContent = !/^image\//.test(file.type) ? 'Ese archivo no es una imagen.' : 'La foto pesa más de 20 MB. Elige otra o una captura de pantalla.';
      return;
    }
    img.src = URL.createObjectURL(file); img.hidden = false; $('.h-ref-empty').hidden = true;
    estado.hidden = false; estado.textContent = 'Subiendo tu foto…'; estado.dataset.s = 'up';
    btn.disabled = true; btn.textContent = 'Subiendo tu foto…';
    const yo = (subiendo = (async () => {
      const blob = await achicar(file);
      const r = await fetch('/api/foto', { method: 'POST', headers: { 'content-type': 'image/jpeg' }, body: blob });
      if (!r.ok) throw new Error('subida');
      return (await r.json()).url;
    })());
    try {
      const url = await yo;
      if (subiendo !== yo) return; // eligieron otra foto mientras tanto
      fotoUrl = url; estado.textContent = '✓ Foto lista'; estado.dataset.s = 'ok';
    } catch {
      if (subiendo !== yo) return;
      estado.textContent = 'No pudimos subir la foto. Podrás adjuntarla en WhatsApp.'; estado.dataset.s = 'err';
    }
    btn.disabled = false; btn.innerHTML = btnHtml;
  });

  // Enviar → abre WhatsApp con el mensaje armado (sin esperas, dentro del toque).
  f.addEventListener('submit', (e) => {
    e.preventDefault();
    if (btn.disabled) return;
    const fd = new FormData(f);
    const d = Object.fromEntries(fd);
    const err = $('.h-form-err');
    const falta = [];
    if (!d.fecha) falta.push('la fecha');
    if (!String(d.nombre || '').trim()) falta.push('tu nombre');
    if (falta.length) { err.textContent = 'Falta ' + falta.join(' y ') + '.'; err.hidden = false; return; }
    err.hidden = true;
    const tipo = d.tipo === 'otra' ? (String(d.tipoOtra || '').trim() || 'Otra') : d.tipo;
    const necesito = fd.getAll('necesito').map((x) => x === 'pack' ? d.pack : x === 'otro' ? (String(d.otro || '').trim() || 'Otra cosa') : x);
    const fecha = new Date(d.fecha + 'T12:00').toLocaleDateString('es', { weekday: 'long', day: 'numeric', month: 'long' });
    const hayFoto = foto.files && foto.files.length > 0;
    const linea = fotoUrl ? `\n📷 Foto de referencia (guárdala al abrirla, se borra a los 15 min): ${fotoUrl}` : hayFoto ? '\n📷 Te mando una foto de referencia.' : '';
    const txt = `¡Hola Celebra! Quiero cotizar para una fiesta.\n• Fiesta: ${tipo}\n• Fecha: ${fecha}\n• Invitados: ${d.invitados || 'por confirmar'}\n• Necesito: ${necesito.length ? necesito.join(', ') : 'quiero que me asesoren'}\n• Temática: ${d.tematica || 'por definir'}\n• Nombre: ${d.nombre}` + linea;
    const wa = `https://wa.me/${waNum}?text=${encodeURIComponent(txt)}`;
    $('.h-form-ok').hidden = !(hayFoto && !fotoUrl);
    // En el celular, abrir en la misma pestaña es lo que hace saltar a la app de WhatsApp.
    if (matchMedia('(pointer: coarse)').matches) location.href = wa;
    else window.open(wa, '_blank', 'noopener');
  });
</script>

<script>
  // Carrusel de la portada: cambia solo cada 6 s, flechas, puntos y deslizar con el dedo.
  const root = document.querySelector<HTMLElement>('.h-slider');
  if (root) {
    const slides = [...root.querySelectorAll<HTMLElement>('.h-slide')];
    const dots = [...root.querySelectorAll<HTMLButtonElement>('.h-sl-dots button')];
    let cur = 0;
    let timer: number | undefined;
    const quieto = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const go = (n: number) => {
      cur = (n + slides.length) % slides.length;
      slides.forEach((s, i) => {
        const on = i === cur;
        s.classList.toggle('on', on);
        if (on) s.removeAttribute('aria-hidden'); else s.setAttribute('aria-hidden', 'true');
        s.querySelectorAll<HTMLElement>('a').forEach((a) => (on ? a.removeAttribute('tabindex') : a.setAttribute('tabindex', '-1')));
      });
      dots.forEach((d, i) => d.setAttribute('aria-selected', String(i === cur)));
    };
    const start = () => { if (!quieto) { clearInterval(timer); timer = window.setInterval(() => go(cur + 1), 6000); } };
    const stop = () => clearInterval(timer);
    root.querySelector('.prev')!.addEventListener('click', () => { go(cur - 1); start(); });
    root.querySelector('.next')!.addEventListener('click', () => { go(cur + 1); start(); });
    dots.forEach((d, i) => d.addEventListener('click', () => { go(i); start(); }));
    root.addEventListener('mouseenter', stop);
    root.addEventListener('mouseleave', start);
    root.addEventListener('focusin', stop);
    let x0 = 0;
    root.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; stop(); }, { passive: true });
    root.addEventListener('touchend', (e) => { const dx = e.changedTouches[0].clientX - x0; if (Math.abs(dx) > 40) go(cur + (dx < 0 ? 1 : -1)); start(); });
    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));
    start();
  }
</script>
