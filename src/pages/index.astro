---
import XmasBanner from '../components/XmasBanner.astro';
import '@fontsource/caveat/700.css';
import '@fontsource/young-serif/400.css';
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';
import HomeNav from '../components/HomeNav.astro';
import '../styles/home.css';
import { site } from '../config/site';
import { mainProduct } from '../config/products';
import { tipos, packs, servicios } from '../config/celebra';

const c = site.contact;
const wa = (txt: string) => `https://wa.me/${c.localWhatsapp}?text=${encodeURIComponent(txt)}`;
const precio = (p: number | null) => (p == null ? 'Precio a consultar' : `Desde USD ${p}`);
const propios = servicios.filter((s) => s.kind === 'propio');
const aliados = servicios.filter((s) => s.kind === 'aliado');
---

<Base
  image="/img/og-celebra.jpg"
  title="Celebra · Taller de fiestas en Caripe: piñatas, packs y decoración"
  description="Piñatas a medida, chupeteras, packs por número de invitados y decoración para cumpleaños, baby shower, bautizos y XV años en Caripe, Monagas. Reserva tu fecha por WhatsApp."
>
  <div class="home">
    <HomeNav />

    <main>
      <section class="h-slider" aria-roledescription="carrusel" aria-label="Trabajos del taller">
        <div class="h-slides">
          <div class="h-slide h-xmas-slide on" role="group" aria-roledescription="diapositiva" aria-label="1 de 4" data-xmas>
            <XmasBanner />
          </div>
          {[
            { item: 'Piñata', bg: 'fondo-1', color: '#dcc8f7', kick: 'Hechas a mano en Caripe', t: 'Piñatas a medida', d: 'Con la forma, la temática, el nombre y los colores que tu peque sueña.', imgs: [['', 'Piñatas hechas a mano: forrada rosada, de selva con monito, corona amarilla con flores y letra N con nombre']] },
            { item: 'Chupetera', bg: 'fondo-2', color: '#f7cfdf', kick: 'Para la mesa dulce', t: 'Chupeteras con mucho dulce', d: 'Personajes y temáticas hechos a mano, listos para la foto.', imgs: [['', 'Chupeteras con dulces: niña, fresita y dinosaurio']] },
            { item: 'Piñata', tematica: 'Piñata con número o letra', bg: 'fondo-3', color: '#bfe3f7', kick: 'Su número, su inicial', t: 'Piñatas con número y letra', d: 'Su edad o la inicial de su nombre, armada con la temática que elijan.', imgs: [['', 'Piñatas con número 1 de dinosaurios y de granja, y letra N con nombre']] },
          ].map((sl, i) => (
            <div class:list={['h-slide', { full: (sl as any).full }]} role="group" aria-roledescription="diapositiva" aria-label={`${i + 2} de 4`} aria-hidden="true" style={`--c:${sl.color}`}>
              <picture class="h-slide-bg">
                <source media="(max-width: 760px)" srcset={`/img/banner/slide-${i + 1}-m.webp`} />
                <img src={`/img/banner/slide-${i + 1}.webp`} alt={sl.imgs.map((x) => x[1]).join(', ')} loading="lazy" />
              </picture>
              <div class="h-wrap h-slide-in">
                <div class="h-slide-txt">
                  <span class="h-kicker">{sl.kick}</span>
                  <p class="h-slide-t">{sl.t}</p>
                  <p class="h-slide-d">{sl.d}</p>
                  <div class="h-btns">
                    <a class="h-btn" href="#reservar" data-cot-item={(sl as any).item} data-cot-tematica={(sl as any).tematica} tabindex="-1">Cotizar el mío</a>
                    <a class="h-btn h-btn-line" href={c.instagram} target="_blank" rel="noopener" tabindex="-1">Ver más trabajos</a>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
        <button type="button" class="h-sl-arrow prev" aria-label="Anterior"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7"></path></svg></button>
        <button type="button" class="h-sl-arrow next" aria-label="Siguiente"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7"></path></svg></button>
        <div class="h-sl-dots" role="tablist" aria-label="Elegir diapositiva">
          {[0, 1, 2, 3].map((i) => <button type="button" role="tab" aria-selected={i === 0 ? 'true' : 'false'} aria-label={`Diapositiva ${i + 1}`}></button>)}
        </div>
      </section>

      <section class="h-wrap h-top" id="fiestas" aria-labelledby="t-top">
        <div class="h-intro">
          <div class="h-top-head rv">
            <span class="h-kicker">Taller de fiestas · Caripe, Monagas</span>
            <h1 id="t-top">¿Qué fiesta estás <em>organizando?</em></h1>
            <p class="h-lead">Piñatas, chupeteras y decoración hechas a mano en nuestro taller. Elige tu celebración y te mostramos todo lo que podemos hacer.</p>
          </div>
        </div>
        <div class="h-banners">
          {tipos.map((t, i) => (
            <a class:list={['h-banner rv', { big: i === 0 }]} href={`/fiestas/${t.slug}/`} style={`--bg:${t.bg};--ink:${t.ink};--d:${i * 70}ms`}>
              <span class="h-banner-txt">
                <b>{t.name}</b>
                <span>{t.short}</span>
                <span class="h-banner-cta">Ver más →</span>
              </span>
              <img class="h-banner-art" src={t.img} alt="" loading="lazy" />
            </a>
          ))}
        </div>
      </section>

      <section class="h-sec h-wrap" id="servicios" aria-labelledby="t-serv">
        <div class="h-head rv">
          <span class="h-kicker">Servicios</span>
          <h2 id="t-serv">Todo para tu fiesta, en un solo lugar</h2>
          <p>Lo que hacemos en el taller y los proveedores de Caripe que trabajan con nosotras.</p>
        </div>
        <div class="h-servs">
          {[...propios, ...aliados].map((s, i) => (
            <div class="h-serv rv" style={`--d:${(i % 4) * 60}ms`}>
              <span class:list={['h-serv-ico', s.kind]}><svg viewBox="0 0 24 24" aria-hidden="true"><path d={s.icon}></path></svg></span>
              <div><b>{s.name}</b><p>{s.desc}</p>{s.kind === 'aliado' && <span class="h-badge">Proveedor aliado</span>}</div>
            </div>
          ))}
        </div>
        <div class="h-btns rv" style="margin-top:24px"><a class="h-btn h-btn-line" href="/servicios/">Ver todos los servicios</a></div>
      </section>

      <section class="h-sec h-wrap h-ig" id="instagram" aria-labelledby="t-ig" hidden>
        <div class="h-ig-top">
          <div class="h-head">
            <span class="h-kicker">En Instagram</span>
            <h2 id="t-ig">Lo último del taller</h2>
            <p>Lo que vamos haciendo y lo que nos dicen nuestras clientas.</p>
          </div>
          <div class="h-ig-nav">
            <button type="button" class="h-ig-arrow" data-dir="-1" aria-label="Anteriores"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7"></path></svg></button>
            <button type="button" class="h-ig-arrow" data-dir="1" aria-label="Siguientes"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7"></path></svg></button>
          </div>
        </div>
        <ul class="h-ig-track" aria-label="Publicaciones recientes de Instagram"></ul>
        <div class="h-btns" style="margin-top:20px"><a class="h-btn h-btn-line" href={c.instagram} target="_blank" rel="noopener">Seguir a {c.instagramHandle}</a></div>
      </section>

      <section class="h-sec h-wrap" id="reservar" aria-labelledby="t-res">
        <div class="h-res rv">
          <div class="h-res-tit">
            <div class="h-ali-top">
              <span class="h-kicker">Reservar</span>
              <button type="button" class="h-ali-info h-info-res" data-res-info aria-haspopup="dialog"><span aria-hidden="true">i</span>Cómo funciona</button>
            </div>
            <h2 id="t-res">Cotiza y reserva la fecha de tu fiesta</h2>
          </div>
          <p class="h-res-como h-res-aviso">⏰ Pide con 2 a 3 semanas de anticipación.</p>
          <div id="cot-home" class="cot-home"></div>
        </div>
        <dialog class="h-ali-dlg" id="res-dlg" aria-labelledby="res-dlg-t">
          <button type="button" class="h-ali-x" data-cerrar aria-label="Cerrar">✕</button>
          <h3 id="res-dlg-t">Cómo funciona</h3>
          <ol class="h-res-steps">
            <li><b>Cuéntanos qué necesitas:</b> un pack completo o solo la piñata, la chupetera o el cotillón.</li>
            <li><b>Te confirmamos disponibilidad</b> el mismo día, con el precio final por escrito.</li>
            <li><b>Con un abono reservamos tu fecha</b> y empezamos a trabajar a mano.</li>
            <li><b>Retiras en el local</b> el día acordado.</li>
          </ol>
          <p>Pide con 2 a 3 semanas de anticipación: los fines de semana se llenan primero.</p>
          <button type="button" class="h-btn" data-cerrar>Entendido</button>
        </dialog>
        <script>
          const dlg = document.getElementById('res-dlg') as HTMLDialogElement;
          document.querySelector('[data-res-info]')!.addEventListener('click', () => dlg.showModal());
          dlg.addEventListener('click', (e) => { const t = e.target as HTMLElement; if (t === dlg || t.closest('[data-cerrar]')) dlg.close(); });
        </script>
      </section>

      <section class="h-sec h-wrap" aria-labelledby="t-club">
        <div class="h-clubhero rv">
          <div class="h-clubhero-img">
            <div class="h-clubtag" aria-hidden="true">
              <span class="t1">Regala</span>
              <span class="t2">Momentos</span>
              <span class="t3">únicos</span>
            </div>
            <div class="h-club10"><b>10%</b><span>de descuento</span></div>
            <span class="h-clubnote" aria-hidden="true">Arreglos<br />especiales<svg viewBox="0 0 60 40"><path d="M6 4c4 16 16 28 44 30m-10-9 10 9-12 5"/></svg></span>
            <img src="/img/club/regalos-m.webp" width="900" height="626" alt="Arreglo de rosas con globo «Love you» y caja de dulces con fotos y globo «Feliz cumple mami»" loading="lazy" />
          </div>
          <div class="h-clubhero-in">
            <span class="h-kicker">Club Celebra · gratis</span>
            <h2 id="t-club">¡Que no se te olvide ningún cumpleaños!</h2>
            <p>Anota <b>3 fechas</b>: la de tu pareja, tu mamá o tus hijos. Te avisamos con tiempo y te regalamos un código de <b>10% de descuento</b> para tu próxima compra.</p>
            <form class="h-clubmini" action="/club/" method="get">
              <label class="h-clubmini-q">¿De quién es la fecha?
                <select name="rel">
                  <option value="Pareja / novia(o)">Mi pareja</option>
                  <option value="Mamá">Mi mamá</option>
                  <option value="Hijo/a">Mi hijo/a</option>
                  <option value="Otro">Otra persona</option>
                </select>
              </label>
              <label>Día<select name="dia">{Array.from({ length: 31 }, (_, i) => <option value={i + 1}>{i + 1}</option>)}</select></label>
              <label>Mes<select name="mes">{['ene', 'feb', 'mar', 'abr', 'may', 'jun', 'jul', 'ago', 'sep', 'oct', 'nov', 'dic'].map((m, i) => <option value={i + 1}>{m}</option>)}</select></label>
              <button class="h-btn" type="submit">Guardar fecha →</button>
            </form>
            <p class="h-clubmini-fine">En el siguiente paso anota 2 fechas más, déjanos tu nombre y correo, y te llevas tu 10% por registrarte. Te puedes dar de baja cuando quieras.</p>
          </div>
        </div>
      </section>

      <section class="h-sec h-wrap" aria-labelledby="t-sal">
        <div class="h-duo">
          <a class="h-tile rv" href="/directorio/" style="--bg:#e3f5ff;--ink:#0f6fa3">
            <span class="h-kicker">Directorio de Caripe</span>
            <b id="t-sal">¿Dónde y con quién hacer la fiesta?</b>
            <span>Lugares, tortas, fotografía, maquillaje y más servicios para fiestas en Caripe, en un solo lugar.</span>
            <span class="h-banner-cta">Ver el directorio →</span>
          </a>
          <a class="h-tile rv" href="/calculadora/" style="--bg:#fef9dc;--ink:#866a00;--d:80ms">
            <span class="h-kicker">Cotiza gratis</span>
            <b>Calcula el presupuesto de tu fiesta</b>
            <span>Pon cuánto quieres gastar y cuántos niños vienen. La calculadora lo reparte en torta, comida, piñata, decoración y más.</span>
            <span class="h-banner-cta">Usar la calculadora →</span>
          </a>
        </div>
      </section>

      <section class="h-sec h-wrap" aria-labelledby="t-libro">
        <div class="h-book rv">
          <a class="h-book-cover" href="/libro/" tabindex="-1" aria-hidden="true"><img src="/img/portada-a.jpg" width="900" height="1355" alt="" loading="lazy" /></a>
          <div class="h-book-txt">
            <span class="h-kicker">¿Prefieres hacerla tú misma?</span>
            <h2 id="t-libro">Fiestas que se recuerdan</h2>
            <p>Nuestra guía para organizar el cumpleaños en casa y gastar menos: presupuesto, invitación, la piñata estrella paso a paso con su molde, la mesa principal y checklists para imprimir.</p>
            <p class="h-price"><b>USD {mainProduct.priceUsd}</b> · ebook en PDF, llega a tu correo</p>
            <div class="h-btns">
              <a class="h-btn" href="/libro/">Ver el libro</a>
              <a class="h-btn h-btn-line" href="/libro/regalo/">Capítulo de regalo</a>
            </div>
          </div>
        </div>
      </section>
    </main>
    <Footer />
  </div>
</Base>


<script>
  // Carrusel de la portada: cambia solo cada 6 s, flechas, puntos y deslizar con el dedo.
  const root = document.querySelector<HTMLElement>('.h-slider');
  if (root) {
    const slides = [...root.querySelectorAll<HTMLElement>('.h-slide')];
    const dots = [...root.querySelectorAll<HTMLButtonElement>('.h-sl-dots button')];
    let cur = 0;
    let timer: number | undefined;
    const quieto = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const go = (n: number) => {
      cur = (n + slides.length) % slides.length;
      slides.forEach((s, i) => {
        const on = i === cur;
        s.classList.toggle('on', on);
        if (on) s.removeAttribute('aria-hidden'); else s.setAttribute('aria-hidden', 'true');
        s.querySelectorAll<HTMLElement>('a').forEach((a) => (on ? a.removeAttribute('tabindex') : a.setAttribute('tabindex', '-1')));
      });
      dots.forEach((d, i) => d.setAttribute('aria-selected', String(i === cur)));
      if (slides[cur].hasAttribute('data-xmas')) xmas()?.start(); else xmas()?.stop();
    };
    const xmasEl = root.querySelector<HTMLElement>('#xmas');
    const xmas = () => (xmasEl as any)?.xmas;
    let paused = false;
    const start = () => {
      paused = false; clearTimeout(timer);
      if (quieto) return;
      if (slides[cur].hasAttribute('data-xmas')) return; // avanza cuando termina su animación
      timer = window.setTimeout(() => { go(cur + 1); start(); }, 6000);
    };
    const stop = () => { paused = true; clearTimeout(timer); };
    xmasEl?.addEventListener('xmas:done', () => { if (!paused && slides[cur].hasAttribute('data-xmas')) { go(cur + 1); start(); } });
    root.querySelector('.prev')!.addEventListener('click', () => { go(cur - 1); start(); });
    root.querySelector('.next')!.addEventListener('click', () => { go(cur + 1); start(); });
    dots.forEach((d, i) => d.addEventListener('click', () => { go(i); start(); }));
    root.addEventListener('mouseenter', stop);
    root.addEventListener('mouseleave', start);
    root.addEventListener('focusin', stop);
    let x0 = 0;
    root.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; stop(); }, { passive: true });
    root.addEventListener('touchend', (e) => { const dx = e.changedTouches[0].clientX - x0; if (Math.abs(dx) > 40) go(cur + (dx < 0 ? 1 : -1)); start(); });
    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));
    go(0);
    start();
  }
</script>

<script>
  // Carrusel de Instagram: lee /api/ig/feed (publicaciones + comentarios que la dueña aprobó).
  (async () => {
    const sec = document.getElementById('instagram');
    const track = sec?.querySelector<HTMLUListElement>('.h-ig-track');
    if (!sec || !track) return;
    let posts: any[] = [];
    try { const r = await fetch('/api/ig/feed'); if (r.ok) posts = (await r.json()).posts || []; } catch { return; }
    if (!posts.length) return;
    const el = (tag: string, cls?: string, txt?: string) => { const e = document.createElement(tag); if (cls) e.className = cls; if (txt != null) e.textContent = txt; return e; };
    const fmt = new Intl.DateTimeFormat('es', { day: 'numeric', month: 'short' });
    for (const p of posts) {
      const li = el('li', 'h-ig-card');
      const a = el('a', 'h-ig-media') as HTMLAnchorElement;
      a.href = p.enlace; a.target = '_blank'; a.rel = 'noopener';
      a.setAttribute('aria-label', 'Ver en Instagram: ' + (p.texto || 'publicación').slice(0, 80));
      const img = el('img') as HTMLImageElement;
      img.src = p.img; img.alt = ''; img.loading = 'lazy'; img.width = 600; img.height = 600;
      a.append(img);
      if (p.tipo === 'VIDEO') a.append(el('span', 'h-ig-tag', 'Video'));
      if (p.tipo === 'CAROUSEL_ALBUM') a.append(el('span', 'h-ig-tag', 'Álbum'));
      li.append(a);
      const body = el('div', 'h-ig-body');
      const meta = el('div', 'h-ig-meta');
      if (p.likes != null) meta.append(el('span', '', '♥ ' + p.likes));
      meta.append(el('span', '', '💬 ' + p.nComentarios));
      if (p.fecha) meta.append(el('span', 'h-ig-date', fmt.format(new Date(p.fecha))));
      body.append(meta);
      if (p.texto) body.append(el('p', 'h-ig-txt', p.texto));
      if (p.comentarios?.length) {
        const ul = el('ul', 'h-ig-coms');
        for (const cm of p.comentarios) {
          const c = el('li');
          c.append(el('b', '', '@' + cm.usuario + ' '), document.createTextNode(cm.texto));
          ul.append(c);
        }
        body.append(ul);
      }
      li.append(body);
      track.append(li);
    }
    sec.hidden = false;
    sec.querySelectorAll<HTMLButtonElement>('.h-ig-arrow').forEach((b) => b.addEventListener('click', () => {
      track.scrollBy({ left: Number(b.dataset.dir) * track.clientWidth * 0.9, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
    }));
  })();
</script>
