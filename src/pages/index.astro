---
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';
import HomeNav from '../components/HomeNav.astro';
import '../styles/home.css';
import { site } from '../config/site';
import { mainProduct } from '../config/products';
import { tipos, packs, servicios } from '../config/celebra';

const c = site.contact;
const loc = site.location;
const wa = (txt: string) => `https://wa.me/${c.localWhatsapp}?text=${encodeURIComponent(txt)}`;
const precio = (p: number | null) => (p == null ? 'Precio a consultar' : `Desde USD ${p}`);
const propios = servicios.filter((s) => s.kind === 'propio');
const aliados = servicios.filter((s) => s.kind === 'aliado');
const hoy = new Date().toISOString().slice(0, 10);
---

<Base
  title="Celebra · Taller de fiestas en Caripe: piñatas, packs y decoración"
  description="Piñatas a medida, chupeteras, packs por número de invitados y decoración para cumpleaños, baby shower, bautizos y XV años en Caripe, Monagas. Reserva tu fecha por WhatsApp."
>
  <div class="home">
    <HomeNav />

    <main>
      <section class="h-wrap h-top" id="fiestas" aria-labelledby="t-top">
        <div class="h-top-head rv">
          <span class="h-kicker">Taller de fiestas · Caripe, Monagas</span>
          <h1 id="t-top">¿Qué fiesta estás <em>organizando?</em></h1>
          <p class="h-lead">Piñatas, chupeteras y decoración hechas a mano en nuestro taller. Elige tu celebración y te mostramos todo lo que podemos hacer.</p>
        </div>
        <div class="h-banners">
          {tipos.map((t, i) => (
            <a class:list={['h-banner rv', { big: i === 0 }]} href={`/fiestas/${t.slug}/`} style={`--bg:${t.bg};--ink:${t.ink};--d:${i * 70}ms`}>
              <span class="h-banner-txt">
                <b>{t.name}</b>
                <span>{t.short}</span>
                <span class="h-banner-cta">Ver más →</span>
              </span>
              <svg class="h-banner-art" viewBox="0 0 160 160" aria-hidden="true" set:html={t.art}></svg>
            </a>
          ))}
        </div>
      </section>

      <section class="h-sec h-wrap" id="packs" aria-labelledby="t-packs">
        <div class="h-head rv">
          <span class="h-kicker">Packs listos</span>
          <h2 id="t-packs">¿Cuántos invitados tendrás?</h2>
          <p>Elige una cantidad y te recomendamos el pack que mejor te conviene. Todos se adaptan a tu temática y se retiran en el local.</p>
        </div>
        <div class="h-guests rv" role="radiogroup" aria-label="Número de invitados">
          {packs.map((p, i) => (
            <button type="button" class="h-guest" role="radio" aria-checked={p.destacado ? 'true' : 'false'} data-pack={p.id}>{p.invitados}</button>
          ))}
        </div>
        <div class="h-packs">
          {packs.map((p, i) => (
            <article class:list={['h-pack rv', { on: p.destacado }]} data-pack-card={p.id} style={`--d:${i * 70}ms`}>
              <span class="h-pack-tag">Recomendado para ti</span>
              <h3>{p.name}</h3>
              <p class="h-pack-inv">{p.invitados}</p>
              <ul>{p.incluye.map((x) => <li>{x}</li>)}</ul>
              <p class="h-pack-price">{precio(p.priceUsd)}</p>
              <a class="h-btn h-btn-line" href="#reservar" data-pick={p.id}>Reservar este pack</a>
            </article>
          ))}
        </div>
        <p class="h-fine rv">Todos los packs son <b>solo con retiro en el local de Caripe</b>. No hacemos envíos a domicilio.</p>
      </section>

      <section class="h-sec h-wrap" id="servicios" aria-labelledby="t-serv">
        <div class="h-head rv">
          <span class="h-kicker">Servicios</span>
          <h2 id="t-serv">Todo para tu fiesta, en un solo lugar</h2>
          <p>Lo que hacemos en el taller y los proveedores de Caripe que trabajan con nosotras.</p>
        </div>
        <div class="h-servs">
          {[...propios, ...aliados].map((s, i) => (
            <div class="h-serv rv" style={`--d:${(i % 4) * 60}ms`}>
              <span class:list={['h-serv-ico', s.kind]}><svg viewBox="0 0 24 24" aria-hidden="true"><path d={s.icon}></path></svg></span>
              <div><b>{s.name}</b><p>{s.desc}</p>{s.kind === 'aliado' && <span class="h-badge">Proveedor aliado</span>}</div>
            </div>
          ))}
        </div>
        <div class="h-btns rv" style="margin-top:24px"><a class="h-btn h-btn-line" href="/servicios/">Ver todos los servicios</a></div>
      </section>

      <section class="h-sec h-wrap" id="reservar" aria-labelledby="t-res">
        <div class="h-res rv">
          <div class="h-res-info">
            <span class="h-kicker">Reservar</span>
            <h2 id="t-res">Reserva la fecha de tu fiesta</h2>
            <ol class="h-res-steps">
              <li><b>Completa los datos</b> y envíalos por WhatsApp.</li>
              <li><b>Te confirmamos disponibilidad</b> el mismo día, con el precio final por escrito.</li>
              <li><b>Con un abono reservamos tu fecha</b> y empezamos a trabajar a mano.</li>
              <li><b>Retiras en el local</b> el día acordado.</li>
            </ol>
            <p class="h-fine">Pide con 2 a 3 semanas de anticipación: los fines de semana se llenan primero.</p>
          </div>
          <form class="h-form" id="res-form" novalidate>
            <label>Tipo de fiesta
              <select name="tipo">{tipos.map((t) => <option>{t.name}</option>)}<option>Otra</option></select>
            </label>
            <div class="h-form-2">
              <label>Fecha de la fiesta<input type="date" name="fecha" min={hoy} required /></label>
              <label>Invitados<input type="number" name="invitados" min="1" inputmode="numeric" placeholder="Ej. 25" /></label>
            </div>
            <label>Pack
              <select name="pack">{packs.map((p) => <option value={p.name} selected={p.destacado}>{p.name} · {p.invitados}</option>)}<option value="Solo piñata o algo puntual">Solo piñata o algo puntual</option></select>
            </label>
            <label>Temática<input type="text" name="tematica" placeholder="Ej. Estrellita arcoíris, dinosaurios…" /></label>
            <label>Tu nombre<input type="text" name="nombre" autocomplete="name" required /></label>
            <button class="h-btn" type="submit">
              <svg class="h-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20l1.3-4A8 8 0 1112 20a8 8 0 01-4-1.1z"></path></svg>
              Enviar por WhatsApp
            </button>
            <p class="h-form-err" role="alert" hidden>Falta la fecha y tu nombre.</p>
          </form>
        </div>
      </section>

      <section class="h-sec h-wrap" aria-labelledby="t-sal">
        <div class="h-duo">
          <a class="h-tile rv" href="/salones/" style="--bg:#eaf7f0;--ink:#1a7f4b">
            <span class="h-kicker">Salones en Caripe</span>
            <b id="t-sal">¿Dónde hacer la fiesta?</b>
            <span>Los salones y espacios de eventos de Caripe, reunidos en un solo lugar. ¿Tienes un salón? Publícalo con nosotras.</span>
            <span class="h-banner-cta">Ver salones →</span>
          </a>
          <a class="h-tile rv" href="/calculadora/" style="--bg:#eef3fd;--ink:#3a5bb8;--d:80ms">
            <span class="h-kicker">Cotiza gratis</span>
            <b>Calcula el presupuesto de tu fiesta</b>
            <span>Pon cuánto quieres gastar y cuántos niños vienen. La calculadora lo reparte en torta, comida, piñata, decoración y más.</span>
            <span class="h-banner-cta">Usar la calculadora →</span>
          </a>
        </div>
      </section>

      <section class="h-sec h-wrap" aria-labelledby="t-libro">
        <div class="h-book rv">
          <a class="h-book-cover" href="/libro/" tabindex="-1" aria-hidden="true"><img src="/img/portada-a.jpg" width="900" height="1355" alt="" loading="lazy" /></a>
          <div class="h-book-txt">
            <span class="h-kicker">¿Prefieres hacerla tú misma?</span>
            <h2 id="t-libro">Fiestas que se recuerdan</h2>
            <p>Nuestra guía para organizar el cumpleaños en casa y gastar menos: presupuesto, invitación, la piñata estrella paso a paso con su molde, la mesa principal y checklists para imprimir.</p>
            <p class="h-price"><b>USD {mainProduct.priceUsd}</b> · ebook en PDF, llega a tu correo</p>
            <div class="h-btns">
              <a class="h-btn" href="/libro/">Ver el libro</a>
              <a class="h-btn h-btn-line" href="/libro/regalo/">Capítulo de regalo</a>
            </div>
          </div>
        </div>
      </section>

      <section class="h-sec h-wrap" id="local" aria-labelledby="t-local">
        <div class="h-head rv">
          <span class="h-kicker">Visítanos</span>
          <h2 id="t-local">Nuestro local en Caripe</h2>
        </div>
        <div class="h-visit">
          <div class="h-vbox rv">
            <h3>Horario</h3>
            <dl>{loc.hours.map((h) => (<><dt>{h.days}</dt><dd>{h.time}</dd></>))}</dl>
          </div>
          <div class="h-vbox rv" style="--d:70ms">
            <h3>Dónde estamos</h3>
            <p>Caripe, estado Monagas, Venezuela. Solo retiro en el local, no hacemos envíos.</p>
            <a class="h-link" href={c.googleMaps} target="_blank" rel="noopener">Ver la ubicación en Google Maps →</a>
          </div>
          <div class="h-vbox rv" style="--d:140ms">
            <h3>Escríbenos</h3>
            <a class="h-link" href={wa('¡Hola Celebra!')} target="_blank" rel="noopener">WhatsApp {c.localWhatsappDisplay}</a>
            <a class="h-link" href={c.instagram} target="_blank" rel="noopener">Instagram {c.instagramHandle}</a>
            <a class="h-link" href={`mailto:${site.brand.email}`}>{site.brand.email}</a>
          </div>
        </div>
      </section>
    </main>
    <Footer />
  </div>
</Base>

<script define:vars={{ waNum: c.localWhatsapp }}>
  // Selector de invitados → resalta el pack recomendado.
  const pick = (id) => {
    document.querySelectorAll('.h-guest').forEach((b) => b.setAttribute('aria-checked', String(b.dataset.pack === id)));
    document.querySelectorAll('.h-pack').forEach((c) => c.classList.toggle('on', c.dataset.packCard === id));
    const sel = document.querySelector('#res-form select[name="pack"]');
    const card = document.querySelector(`[data-pack-card="${id}"] h3`);
    if (sel && card) sel.value = card.textContent;
  };
  document.querySelectorAll('.h-guest').forEach((b) => b.addEventListener('click', () => pick(b.dataset.pack)));
  document.querySelectorAll('[data-pick]').forEach((a) => a.addEventListener('click', () => pick(a.dataset.pick)));

  // Reservar → abre WhatsApp con el mensaje armado.
  const f = document.getElementById('res-form');
  f.addEventListener('submit', (e) => {
    e.preventDefault();
    const d = Object.fromEntries(new FormData(f));
    const err = f.querySelector('.h-form-err');
    if (!d.fecha || !String(d.nombre).trim()) { err.hidden = false; return; }
    err.hidden = true;
    const fecha = new Date(d.fecha + 'T12:00').toLocaleDateString('es', { weekday: 'long', day: 'numeric', month: 'long' });
    const txt = `¡Hola Celebra! Quiero reservar una fecha.\n• Fiesta: ${d.tipo}\n• Fecha: ${fecha}\n• Invitados: ${d.invitados || 'por confirmar'}\n• Pack: ${d.pack}\n• Temática: ${d.tematica || 'por definir'}\n• Nombre: ${d.nombre}`;
    window.open(`https://wa.me/${waNum}?text=${encodeURIComponent(txt)}`, '_blank', 'noopener');
  });
</script>
