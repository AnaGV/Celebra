<script>
  import { track } from '../lib/analytics';
  import { products, mainProduct } from '../config/products';
  import { initPais, elegirPais } from '../lib/pais';
  import { wireLeadForm } from '../lib/lead';
  import type { CountryCode } from '../config/site';

  track('ViewContent', { content_ids: [mainProduct.id], value: mainProduct.priceUsd, currency: 'USD' });

  // Portada A/B para los anuncios: ?portada=b muestra la portada "colgada".
  const portada = new URLSearchParams(location.search).get('portada');
  if (portada === 'b') {
    document.querySelectorAll<HTMLImageElement>('.js-cover').forEach((img) => (img.src = '/img/portada-b.jpg'));
    document.querySelectorAll<HTMLImageElement>('.js-cover-th').forEach((img) => (img.src = '/img/th-portada-b.jpg'));
  }

  // País: muestra solo lo que corresponde (métodos de pago, formato impreso, avisos).
  const printId = products.find((p) => p.kind === 'fisico')!.id;
  let fmt: 'ebook' | 'print' = 'ebook';
  function applyFmt() {
    document.querySelectorAll<HTMLElement>('[data-fmt-solo]').forEach((el) => (el.hidden = el.dataset.fmtSolo !== fmt));
    document.querySelectorAll<HTMLButtonElement>('[data-pick-fmt]').forEach((b) => {
      const on = b.dataset.pickFmt === fmt;
      b.classList.toggle('on', on);
      b.setAttribute('aria-checked', on ? 'true' : 'false');
    });
    document.querySelectorAll<HTMLElement>('.js-main-buy').forEach((b) => (b.dataset.buy = fmt === 'print' ? printId : mainProduct.id));
  }
  function applyPais(p: CountryCode) {
    document.querySelectorAll<HTMLElement>('[data-solo]').forEach((el) => (el.hidden = !el.dataset.solo!.split(' ').includes(p)));
    document.querySelectorAll<HTMLButtonElement>('[data-pick-pais]').forEach((b) => {
      const on = b.dataset.pickPais === p;
      b.classList.toggle('on', on);
      b.setAttribute('aria-pressed', on ? 'true' : 'false');
    });
    if (p !== 'VE' && fmt === 'print') { fmt = 'ebook'; applyFmt(); }
  }
  window.addEventListener('celebra:pais', (e) => applyPais((e as CustomEvent<CountryCode>).detail));
  applyPais((document.documentElement.dataset.pais as CountryCode) || 'OTRO');
  initPais();

  // Al cambiar país o formato aparecen o desaparecen secciones arriba; mantenemos el botón tocado en el mismo lugar de la pantalla.
  function keepPlace(el: HTMLElement, change: () => void) {
    const before = el.getBoundingClientRect().top;
    change();
    const after = el.getBoundingClientRect().top;
    if (Math.abs(after - before) > 1) window.scrollBy({ top: after - before, behavior: 'instant' as ScrollBehavior });
  }

  document.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    const pf = t.closest<HTMLElement>('[data-pick-fmt]');
    if (pf) { keepPlace(pf, () => { fmt = pf.dataset.pickFmt as 'ebook' | 'print'; applyFmt(); }); return; }
    const pp = t.closest<HTMLElement>('[data-pick-pais]');
    if (pp) { keepPlace(pp, () => elegirPais(pp.dataset.pickPais as CountryCode)); return; }
    const pv = t.closest<HTMLElement>('[data-pick-view]');
    if (pv) {
      const v = pv.dataset.pickView!;
      document.querySelectorAll<HTMLElement>('.stage [data-v]').forEach((el) => (el.hidden = el.dataset.v !== v));
      document.querySelectorAll<HTMLElement>('[data-pick-view]').forEach((b) => {
        b.classList.toggle('on', b === pv);
        b.setAttribute('aria-pressed', b === pv ? 'true' : 'false');
      });
    }
  });

  const form = document.getElementById('lead-form') as HTMLFormElement;
  wireLeadForm(form, (email) => {
    form.hidden = true;
    document.getElementById('lead-done-email')!.textContent = email;
    document.getElementById('lead-done')!.hidden = false;
  });
</script>

