---
import Base from '../layouts/Base.astro';
import '../styles/home.css';
import TelInput from '../components/TelInput.astro';
---

<Base image="/img/og-celebra.jpg" title="Mi panel de aliado · Celebra" description="Panel privado de los aliados de Celebra.">
  <meta name="robots" content="noindex" slot="head" />
  <div class="home">
    <header class="h-pan-top"><a href="/"><img src="/img/marca/logo.webp" width="1000" height="437" alt="Celebra" /></a><span>Panel de aliado</span></header>
    <main class="h-wrap h-pan">
      <p id="p-load">Cargando tu panel…</p>
      <div id="p-err" hidden><h1>No pudimos abrir tu panel</h1><p>Abre el <b>enlace privado</b> que te mandó Celebra por WhatsApp (empieza con somoscelebrave.com/aliado/#). Después de abrirlo una vez, este teléfono lo recuerda.</p><p>¿No lo encuentras? Pídele uno nuevo a Celebra.</p></div>

      <div id="p-app" hidden>
        <h1 id="p-nombre"></h1>
        <p class="h-pan-sub">Lo que cambies aquí se ve en tu ficha en <a class="h-link" id="p-ver" target="_blank" rel="noopener">somoscelebrave.com</a>. Guarda este enlace: es tu llave privada.</p>
        <nav class="h-pan-tabs" role="tablist">
          <button role="tab" data-t="reservas" aria-selected="true">Reservas <span id="p-nres"></span></button>
          <button role="tab" data-t="calendario" aria-selected="false">Horario y calendario</button>
          <button role="tab" data-t="servicios" aria-selected="false">Servicios y precios</button>
          <button role="tab" data-t="ficha" aria-selected="false">Mi ficha y pagos</button>
        </nav>

        <section data-p="reservas">
          <p class="h-pan-help">Cuando te llegue una solicitud por WhatsApp, revisa el pago en tu banco o Binance y márcala aquí. Al confirmar, el día queda ocupado en tu calendario.</p>
          <ul class="h-pan-res" id="p-res"></ul>
          <p class="h-pan-help h-pan-capt">Las capturas de pago se borran apenas las descargas. Si no las descargas en 24 horas, se eliminan solas.</p>
        </section>

        <section data-p="calendario" hidden>
          <label class="h-pan-switch"><input type="checkbox" id="p-usacal" /> Mostrar mi disponibilidad en la página y apartar fechas</label>
          <div class="h-pan-hor">
            <h3>Tu horario de trabajo</h3>
            <p class="h-pan-help">Los clientes solo pueden elegir horas dentro de este horario. Cada día recibes reservas hasta que se llena.</p>
            <div class="h-pan-hor-r">
              <label>Desde<select id="p-desde"></select></label>
              <label>Hasta<select id="p-hasta"></select></label>
            </div>
            <p class="h-pan-lab">Días que trabajas</p>
            <div class="h-pan-dias" id="p-dias"></div>
          </div>
          <h3>Días libres o bloqueados</h3>
          <p class="h-pan-help">Toca un día para <b>bloquearlo</b> (no trabajas ese día) o desbloquearlo. El número indica cuántas reservas tiene.</p>
          <div class="h-cal h-pan-cal">
            <div class="h-cal-top"><button type="button" class="h-cal-nav" data-d="-1" aria-label="Mes anterior">‹</button><b id="p-mes"></b><button type="button" class="h-cal-nav" data-d="1" aria-label="Mes siguiente">›</button></div>
            <div class="h-cal-sem"><span>L</span><span>M</span><span>M</span><span>J</span><span>V</span><span>S</span><span>D</span></div>
            <div class="h-cal-grid" id="p-grid"></div>
            <p class="h-cal-ley"><i class="ok"></i> Libre <i class="res"></i> Con reservas <i class="no"></i> Bloqueado</p>
          </div>
        </section>

        <section data-p="servicios" hidden>
          <p class="h-pan-help">Elige <b>cómo cobras</b> cada servicio. Así el cliente ve exactamente eso: horas, evento o cantidades. Los precios son en dólares.</p>
          <div id="p-serv"></div>
          <button type="button" class="h-btn h-btn-line" id="p-addserv">+ Agregar servicio</button>
        </section>

        <section data-p="ficha" hidden>
          <form class="h-form" id="p-ficha" novalidate>
            <label>Descripción corta<textarea name="descripcion" rows="3" maxlength="400"></textarea></label>
            <div class="h-form-2">
              <TelInput name="whatsapp" label="WhatsApp donde recibes las reservas" id="p-tel" />
              <label>Zona<input name="zona" /></label>
            </div>
            <label>Instagram <small>(opcional)</small><input name="instagram" placeholder="@tunegocio" /></label>
            <h3>Pago Móvil <small>(se muestra al cliente cuando elige pagar)</small></h3>
            <div class="h-form-2"><label>Banco<input name="pm_banco" placeholder="Banesco 0134" /></label><label>Teléfono<input name="pm_tel" inputmode="tel" /></label></div>
            <label>Cédula o RIF<input name="pm_ced" /></label>
            <h3>Binance <small>(opcional)</small></h3>
            <label>Binance Pay ID o correo<input name="bi_id" /></label>
            <label>Nota de pago <small>(ej. "50% para apartar, resto el día del evento")</small><input name="pago_nota" maxlength="160" /></label>
            <h3>Fotos (máximo 2)</h3>
            <div class="h-pan-fotos" id="p-fotos"></div>
          </form>
        </section>

        <div class="h-pan-bar"><button class="h-btn" id="p-save" type="button">Guardar cambios</button><span id="p-msg" role="status"></span></div>
      </div>
    </main>
  </div>
</Base>

<script>
  import { montarTel, ponerTel } from '../lib/telefono';
  import { horaTxt, HORARIO_BASE } from '../lib/agenda';
  montarTel();
  const $ = <T extends HTMLElement>(s: string) => document.querySelector<T>(s)!;
  const MESES = ['enero', 'febrero', 'marzo', 'abril', 'mayo', 'junio', 'julio', 'agosto', 'septiembre', 'octubre', 'noviembre', 'diciembre'];
  let tok = location.hash.slice(1);
  // Se recuerda en este teléfono, así el aliado vuelve al panel desde la foto de la captura sin buscar su enlace.
  try { if (tok) { localStorage.setItem('celebra-aliado', tok); } else tok = localStorage.getItem('celebra-aliado') || sessionStorage.getItem('celebra-aliado') || ''; } catch {}
  const H = () => ({ 'x-aliado': tok, 'content-type': 'application/json' });
  let A: any, R: any[] = [], hoy = '', mes = '', sucio = false;
  const el = (t: string, c?: string, x?: string) => { const e = document.createElement(t); if (c) e.className = c; if (x != null) e.textContent = x; return e; };
  const marcar = () => { sucio = true; $('#p-msg').textContent = 'Tienes cambios sin guardar'; };

  async function cargar() {
    const r = await fetch('/api/panel', { headers: H() });
    if (!r.ok) throw new Error('401');
    const d = await r.json(); A = d.aliado; R = d.reservas; hoy = d.hoy; if (!mes) mes = hoy.slice(0, 7);
  }

  function fechaTxt(f: string) { const t = new Date(f + 'T12:00:00Z').toLocaleDateString('es-VE', { weekday: 'short', day: 'numeric', month: 'short', timeZone: 'UTC' }); return t.charAt(0).toUpperCase() + t.slice(1); }
  const waNum = (n: string) => { const d = String(n || '').replace(/\D/g, ''); const ve = /^(?:56|57)?(4(?:1[246]|2[46])\d{7})$/.exec(d); if (ve) return '58' + ve[1]; return d.length === 11 && d.startsWith('0') ? '58' + d.slice(1) : d.length === 10 && d.startsWith('4') ? '58' + d : d; };
  const cuando = (r: any) => new Date(r.fecha + 'T12:00:00Z').toLocaleDateString('es-VE', { weekday: 'long', day: 'numeric', month: 'long', timeZone: 'UTC' }) + (r.hora != null ? ' a las ' + horaTxt(r.hora) : '');
  function aviso(r: any) {
    const t = r.estado === 'confirmada' ? `Hola ${r.cliente.nombre}, soy ${A.nombre}. ¡Tu reserva para el ${cuando(r)} está confirmada! ✅ (Código ${r.id})`
      : r.estado === 'rechazada' ? `Hola ${r.cliente.nombre}, soy ${A.nombre}. No pude confirmar tu reserva del ${cuando(r)} (código ${r.id}). ¿Lo revisamos?`
      : `Hola ${r.cliente.nombre}, soy ${A.nombre}. Recibí tu mensaje por Celebra (código ${r.id}).`;
    return `https://wa.me/${waNum(r.cliente.whatsapp)}?text=${encodeURIComponent(t)}`;
  }
  function pintarReservas() {
    const ul = $('#p-res'); ul.replaceChildren();
    const pend = R.filter((r) => r.estado === 'apartada' || r.estado === 'consulta').length;
    $('#p-nres').textContent = pend ? String(pend) : '';
    const orden = { consulta: 0, apartada: 0, confirmada: 1, rechazada: 2, vencida: 3, archivada: 4 } as any;
    const lista = [...R].filter((r) => r.estado !== 'archivada' && (r.fecha >= hoy || r.estado === 'apartada' || r.estado === 'consulta')).sort((a, b) => orden[a.estado] - orden[b.estado] || a.fecha.localeCompare(b.fecha) || (a.hora ?? 0) - (b.hora ?? 0));
    if (!lista.length) { ul.append(el('li', 'h-pan-vacio', 'Todavía no tienes solicitudes. Cuando alguien reserve desde la página, aparecerá aquí.')); return; }
    for (const r of lista) {
      const li = el('li', 'h-pan-r ' + r.estado);
      const tag = { apartada: 'Por verificar el pago', confirmada: 'Confirmada', rechazada: 'Rechazada', vencida: 'Vencida (no respondiste en 24 h)', consulta: 'Pide una hora extra' }[r.estado as string]!;
      const fin = r.hora != null ? Math.max(...r.items.map((i: any) => (i.min ? r.hora + i.min : r.hora))) : null;
      li.append(el('span', 'h-pan-tag', tag), el('b', '', `${fechaTxt(r.fecha)}${r.hora != null ? ' · ' + horaTxt(r.hora) + (fin && fin > r.hora ? ' a ' + horaTxt(fin) : '') : ''} · ${r.cliente.nombre}`),
        el('p', '', r.items.map((i: any) => i.nombre + (i.horas ? ` (${i.horas} h)` : '') + (i.cant > 1 ? ' ×' + i.cant : '')).join(', ') + (r.estado === 'consulta' ? '' : ` · $${r.total}`) + (r.invitados ? ' · ' + r.invitados + ' inv.' : '')));
      li.append(el('p', '', '📱 +' + waNum(r.cliente.whatsapp)));
      if (r.direccion) li.append(el('p', '', '📍 ' + r.direccion));
      if (r.estado !== 'consulta') li.append(el('p', 'h-pan-pago', r.metodo === 'pagomovil' ? `Pago Móvil${r.referencia ? ' · Ref. ' + r.referencia : ''}` : r.metodo === 'binance' ? `Binance${r.referencia ? ' · ' + r.referencia : ''}` : 'Pago por coordinar'));
      if (r.nota) li.append(el('p', 'h-pan-nota', '“' + r.nota + '”'));
      const acc = el('div', 'h-pan-acc');
      if (r.captura) { const a = el('a', 'h-link', 'Descargar captura') as HTMLAnchorElement; a.href = r.captura + '?aliado=1'; a.target = '_blank'; a.rel = 'noopener'; acc.append(a); }
      const boton = (t: string, accion: string, cls: string) => { const b = el('button', 'h-btn ' + cls, t) as HTMLButtonElement; b.type = 'button'; b.addEventListener('click', () => accionar(r.id, accion, b)); acc.append(b); };
      const avisar = (t: string, cls = 'h-btn h-dir-wa') => {
        const w = el('a', cls, t) as HTMLAnchorElement; w.href = aviso(r); w.target = '_blank'; w.rel = 'noopener'; acc.append(w);
        if (cls.includes('h-btn')) {
          const c = el('button', 'h-link h-pan-copiar', 'Copiar mensaje') as HTMLButtonElement; c.type = 'button';
          c.addEventListener('click', async () => { const txt = decodeURIComponent(aviso(r).split('?text=')[1] || ''); try { await navigator.clipboard.writeText(txt); c.textContent = '✓ Copiado: pégalo en el chat donde te llegó la reserva'; } catch { prompt('Copia este mensaje:', txt); } });
          acc.append(c);
        }
      };
      if (r.estado === 'apartada') { boton('✅ Pago verificado', 'confirmar', 'h-dir-wa'); boton('No llegó el pago', 'rechazar', 'h-btn-line'); avisar('Escribirle', 'h-link'); }
      else if (r.estado === 'confirmada') avisar('Enviarle la confirmación por WhatsApp');
      else if (r.estado === 'rechazada') { avisar('Avisarle por WhatsApp', 'h-btn h-btn-line'); boton('Volver a apartar', 'reabrir', 'h-btn-line'); }
      else if (r.estado === 'consulta') { avisar('Responderle por WhatsApp'); boton('Ya lo atendí', 'archivar', 'h-btn-line'); }
      else boton('Volver a apartar', 'reabrir', 'h-btn-line');
      li.append(acc); ul.append(li);
    }
  }
  async function accionar(id: string, accion: string, b: HTMLButtonElement) {
    if (accion === 'rechazar' && !confirm('¿Seguro? La fecha se libera para otros clientes.')) return;
    b.disabled = true;
    const r = await fetch('/api/panel/reserva/' + id, { method: 'POST', headers: H(), body: JSON.stringify({ accion }) });
    if (!r.ok) { b.disabled = false; alert('No se pudo guardar. Revisa tu conexión.'); return; }
    await cargar(); pintarReservas(); pintarCal();
    // El botón verde "Enviarle la confirmación" queda en la tarjeta: un toque abre WhatsApp con el mensaje listo.
    const li = [...document.querySelectorAll('#p-res .h-pan-r')].find((x) => x.querySelector('a.h-dir-wa')?.getAttribute('href')?.includes(encodeURIComponent(id)));
    li?.scrollIntoView({ behavior: 'smooth', block: 'center' }); li?.classList.add('h-pan-flash');
  }

  function pintarCal() {
    const [y, m] = mes.split('-').map(Number);
    $('#p-mes').textContent = `${MESES[m - 1]} ${y}`;
    const g = $('#p-grid'); g.replaceChildren();
    const primero = (new Date(Date.UTC(y, m - 1, 1)).getUTCDay() + 6) % 7, dias = new Date(Date.UTC(y, m, 0)).getUTCDate();
    for (let i = 0; i < primero; i++) g.append(el('span'));
    for (let d = 1; d <= dias; d++) {
      const f = `${mes}-${String(d).padStart(2, '0')}`;
      const nconf = R.filter((r) => r.fecha === f && r.estado === 'confirmada').length, napar = R.filter((r) => r.fecha === f && r.estado === 'apartada').length;
      const bloq = A.bloqueados.includes(f); const nolab = !(A.horario || HORARIO_BASE).dias.includes((new Date(f + 'T12:00:00Z').getUTCDay() + 6) % 7);
      const b = el('button', `h-cal-d ${bloq || nolab ? 'no' : nconf || napar ? 'res' : 'ok'}`) as HTMLButtonElement;
      b.type = 'button'; b.append(el('span', '', String(d))); if (nconf + napar) b.append(el('small', '', String(nconf + napar)));
      b.disabled = f < hoy || nolab; b.title = nolab ? 'No trabajas este día de la semana' : bloq ? 'Bloqueado' : `${nconf} confirmada(s), ${napar} por verificar`;
      b.addEventListener('click', () => { A.bloqueados = bloq ? A.bloqueados.filter((x: string) => x !== f) : [...A.bloqueados, f]; marcar(); pintarCal(); });
      g.append(b);
    }
  }
  document.querySelectorAll<HTMLButtonElement>('.h-cal-nav').forEach((b) => b.addEventListener('click', () => {
    const [y, m] = mes.split('-').map(Number); const d = new Date(Date.UTC(y, m - 1 + Number(b.dataset.d), 1)); mes = d.toISOString().slice(0, 7); pintarCal();
  }));

  function pintarServicios() {
    const box = $('#p-serv'); box.replaceChildren();
    A.servicios.forEach((s: any, i: number) => {
      const row = el('div', 'h-pan-s2');
      const inp = (lbl: string, k: string, type = 'text', extra: Record<string, string> = {}) => {
        const l = el('label', '', lbl); const x = el('input') as HTMLInputElement; x.type = type; x.value = s[k] ?? ''; Object.assign(x, extra);
        x.addEventListener('input', () => { s[k] = type === 'number' ? Number(x.value) : x.value; marcar(); }); l.append(x); return l;
      };
      const tipo = el('label', '', 'Cómo cobras'); const sel = el('select') as HTMLSelectElement;
      for (const [v, t] of [['hora', 'Por hora'], ['evento', 'Por evento (duración fija)'], ['unidad', 'Por unidad (sillas, tortas…)']]) { const o = el('option', '', t) as HTMLOptionElement; o.value = v; sel.append(o); }
      sel.value = s.tipo || 'evento';
      sel.addEventListener('change', () => { s.tipo = sel.value; if (s.tipo === 'unidad' && (!s.unidad || s.unidad === 'hora' || s.unidad === 'evento')) s.unidad = ''; marcar(); pintarServicios(); });
      tipo.append(sel);
      const extra: HTMLElement[] = [];
      if (s.tipo === 'hora') extra.push(inp('Mínimo de horas', 'minHoras', 'number', { min: '1', max: '24' }), inp('¿Cuántos puedes atender a la vez?', 'cantidad', 'number', { min: '1' }));
      else if (s.tipo === 'unidad') extra.push(inp('¿Qué unidad? (ej. sillas, tortas)', 'unidad', 'text', { placeholder: 'sillas' }), inp('¿Cuántas tienes por día?', 'cantidad', 'number', { min: '1' }));
      else extra.push(inp('Duración del evento (horas)', 'duracion', 'number', { min: '1', max: '24' }), inp('¿Cuántos puedes atender a la vez?', 'cantidad', 'number', { min: '1' }));
      const precioLbl = s.tipo === 'hora' ? 'Precio por hora (USD)' : s.tipo === 'unidad' ? `Precio por ${s.unidad || 'unidad'} (USD)` : 'Precio por evento (USD)';
      const pie = el('div', 'h-pan-s2-pie');
      const act = el('label', 'h-pan-act'); const cb = el('input') as HTMLInputElement; cb.type = 'checkbox'; cb.checked = s.activo !== false;
      cb.addEventListener('change', () => { s.activo = cb.checked; marcar(); }); act.append(cb, document.createTextNode(' Visible en mi ficha'));
      const del = el('button', 'h-pan-del', 'Quitar servicio') as HTMLButtonElement; del.type = 'button';
      del.addEventListener('click', () => { if (confirm('¿Quitar ' + (s.nombre || 'este servicio') + '?')) { A.servicios.splice(i, 1); marcar(); pintarServicios(); } });
      pie.append(act, del);
      row.append(inp('Servicio', 'nombre'), tipo, inp(precioLbl, 'precio', 'number', { min: '0', step: '0.5' }), ...extra, pie);
      box.append(row);
    });
  }
  $('#p-addserv').addEventListener('click', () => { A.servicios.push({ nombre: '', precio: 0, tipo: 'evento', unidad: 'evento', duracion: 4, minHoras: 1, cantidad: 1, activo: true }); marcar(); pintarServicios(); });

  function pintarHorario() {
    const h = A.horario || HORARIO_BASE;
    const d = $<HTMLSelectElement>('#p-desde'), a = $<HTMLSelectElement>('#p-hasta');
    d.replaceChildren(); a.replaceChildren();
    for (let m = 6 * 60; m <= 22 * 60; m += 60) { const o = el('option', '', horaTxt(m)) as HTMLOptionElement; o.value = String(m); d.append(o); }
    for (let m = 10 * 60; m <= 30 * 60; m += 60) { const o = el('option', '', horaTxt(m)) as HTMLOptionElement; o.value = String(m); a.append(o); }
    d.value = String(h.desde); a.value = String(h.hasta);
    const sync = () => { A.horario = { ...(A.horario || HORARIO_BASE), desde: Number(d.value), hasta: Math.max(Number(a.value), Number(d.value) + 60) }; marcar(); };
    d.onchange = sync; a.onchange = sync;
    const box = $('#p-dias'); box.replaceChildren();
    ['Lun', 'Mar', 'Mié', 'Jue', 'Vie', 'Sáb', 'Dom'].forEach((t, i) => {
      const l = el('label', 'h-adm-chip'); const c = el('input') as HTMLInputElement; c.type = 'checkbox'; c.checked = h.dias.includes(i);
      c.addEventListener('change', () => { const ds = new Set<number>((A.horario || HORARIO_BASE).dias); c.checked ? ds.add(i) : ds.delete(i); A.horario = { ...(A.horario || HORARIO_BASE), dias: [...ds].sort() }; marcar(); pintarCal(); });
      l.append(c, el('span', '', t)); box.append(l);
    });
  }

  function pintarFicha() {
    const f = $<HTMLFormElement>('#p-ficha'); const v = (n: string, x: string) => ((f.elements.namedItem(n) as HTMLInputElement).value = x || '');
    v('descripcion', A.descripcion); ponerTel(document.getElementById('p-tel'), A.whatsapp); v('zona', A.zona); v('instagram', A.instagram ? '@' + A.instagram : '');
    v('pm_banco', A.pago.pagoMovil?.banco); v('pm_tel', A.pago.pagoMovil?.telefono); v('pm_ced', A.pago.pagoMovil?.cedula);
    v('bi_id', A.pago.binance?.id); v('pago_nota', A.pago.nota);
    f.addEventListener('input', marcar);
    const fotos = $('#p-fotos'); fotos.replaceChildren();
    for (const n of [1, 2]) {
      const box = el('label', 'h-pan-foto'); const img = el('img') as HTMLImageElement;
      if (A.fotos.some((u: string) => u.endsWith('/' + n))) img.src = `/api/aliados/${A.id}/foto/${n}?v=${Date.now()}`;
      const inp = el('input') as HTMLInputElement; inp.type = 'file'; inp.accept = 'image/*';
      const t = el('span', '', img.src ? 'Cambiar foto ' + n : 'Subir foto ' + n);
      inp.addEventListener('change', async () => {
        const file = inp.files?.[0]; if (!file) return; t.textContent = 'Subiendo…';
        const bm = await createImageBitmap(file); const k = Math.min(1, 1400 / Math.max(bm.width, bm.height));
        const c = document.createElement('canvas'); c.width = Math.round(bm.width * k); c.height = Math.round(bm.height * k); c.getContext('2d')!.drawImage(bm, 0, 0, c.width, c.height);
        const blob: Blob = await new Promise((ok) => c.toBlob((b) => ok(b!), 'image/jpeg', 0.84));
        const r = await fetch(`/api/panel/foto/${n}`, { method: 'POST', headers: { 'x-aliado': tok, 'content-type': 'image/jpeg' }, body: blob });
        t.textContent = r.ok ? '✓ Foto ' + n + ' guardada' : 'No se pudo subir'; if (r.ok) img.src = URL.createObjectURL(blob);
      });
      box.append(img, t, inp); fotos.append(box);
    }
  }

  $('#p-save').addEventListener('click', async () => {
    const f = $<HTMLFormElement>('#p-ficha'); const g = (n: string) => (f.elements.namedItem(n) as HTMLInputElement).value;
    const body = {
      descripcion: g('descripcion'), whatsapp: g('whatsapp'), zona: g('zona'), instagram: g('instagram'),
      calendario: $<HTMLInputElement>('#p-usacal').checked, servicios: A.servicios, bloqueados: A.bloqueados, horario: A.horario,
      pago: { pagoMovil: { banco: g('pm_banco'), telefono: g('pm_tel'), cedula: g('pm_ced') }, binance: { id: g('bi_id') }, nota: g('pago_nota') }, sigoActivo: true,
    };
    $('#p-msg').textContent = 'Guardando…';
    const r = await fetch('/api/panel', { method: 'PUT', headers: H(), body: JSON.stringify(body) });
    $('#p-msg').textContent = r.ok ? '✓ Guardado. Ya se ve en la página.' : 'No se pudo guardar. Revisa tu conexión.';
    if (r.ok) { sucio = false; await cargar(); pintarServicios(); }
  });
  addEventListener('beforeunload', (e) => { if (sucio) e.preventDefault(); });

  document.querySelectorAll<HTMLButtonElement>('.h-pan-tabs button').forEach((b) => b.addEventListener('click', () => {
    document.querySelectorAll('.h-pan-tabs button').forEach((x) => x.setAttribute('aria-selected', String(x === b)));
    document.querySelectorAll<HTMLElement>('[data-p]').forEach((s) => (s.hidden = s.dataset.p !== b.dataset.t));
  }));
  $<HTMLInputElement>('#p-usacal').addEventListener('change', marcar);

  (async () => {
    try { await cargar(); } catch { $('#p-load').hidden = true; $('#p-err').hidden = false; return; }
    $('#p-nombre').textContent = 'Hola, ' + A.nombre;
    $<HTMLAnchorElement>('#p-ver').href = '/reservar/?a=' + A.id;
    $<HTMLInputElement>('#p-usacal').checked = !!A.calendario;
    pintarReservas(); pintarCal(); pintarServicios(); pintarFicha(); pintarHorario();
    $('#p-load').hidden = true; $('#p-app').hidden = false;
  })();
</script>
