---
import Base from '../../layouts/Base.astro';
import '../../styles/home.css';
import { CATEGORIAS } from '../../config/directorio';
---

<Base image="/img/og-celebra.jpg" title="Aliados · Admin Celebra" description="Administración de aliados.">
  <meta name="robots" content="noindex" slot="head" />
  <div class="home">
    <header class="h-pan-top"><a href="/"><img src="/img/marca/logo.webp" width="1000" height="437" alt="Celebra" /></a><span>Admin · Aliados</span></header>
    <main class="h-wrap h-pan">
      <form class="h-form" id="k-form">
        <label>Clave de administración<input type="password" name="k" autocomplete="current-password" /></label>
        <button class="h-btn" type="submit">Entrar</button>
        <p class="h-form-err" role="alert" hidden></p>
      </form>

      <div id="adm" hidden>
        <div class="h-adm-intro">
          <p><b>Esta página es solo para ti.</b> Aquí creas a los aliados y los editas.</p>
          <p>Los aliados <b>no entran aquí</b>: cada uno entra a su propio panel con el enlace privado que le mandas por WhatsApp al crearlo.</p>
        </div>

        <h1>Tus aliados</h1>
        <ul class="h-adm-lista" id="a-lista"></ul>

        <h2 id="a-tit">Crear un aliado nuevo</h2>
        <form class="h-form h-adm-form" id="a-form" novalidate>
          <input type="hidden" name="id" />

          <section class="h-adm-paso">
            <h3><span>1</span> Datos del negocio</h3>
            <div class="h-form-2">
              <label>Nombre del negocio<input name="nombre" required /></label>
              <label>WhatsApp donde recibe las reservas<input name="whatsapp" inputmode="tel" placeholder="584141234567" required /></label>
            </div>
            <label>Descripción corta <small>(lo que se lee en su ficha)</small><textarea name="descripcion" rows="2" maxlength="400"></textarea></label>
            <label>Zona<input name="zona" value="Caripe" /></label>
          </section>

          <section class="h-adm-paso">
            <h3><span>2</span> ¿Qué ofrece? <small>Marca una o varias</small></h3>
            <div class="h-adm-cats">
              {CATEGORIAS.map((k) => <label class="h-adm-chip"><input type="checkbox" name="cat" value={k.id} /><span>{k.icono} {k.nombre}</span></label>)}
            </div>
          </section>

          <section class="h-adm-paso">
            <h3><span>3</span> Plan</h3>
            <div class="h-adm-planes">
              <label class="h-adm-plan"><input type="radio" name="plan" value="gratis" checked />
                <span><b>Gratis</b>El cliente llena la reserva y la envía al WhatsApp del aliado con un botón. El aliado confirma el pago en su panel.</span></label>
              <label class="h-adm-plan"><input type="radio" name="plan" value="pro" />
                <span><b>Pro <em>Próximamente</em></b>Igual que el gratis, más avisos automáticos por WhatsApp sin que el cliente toque nada. Se cobra aparte.</span></label>
            </div>
          </section>

          <section class="h-adm-paso">
            <h3><span>4</span> ¿Se muestra en el directorio?</h3>
            <label class="h-adm-vis"><input type="checkbox" name="activo" checked />
              <span class="si">✓ Visible: aparece en el Directorio y los clientes pueden reservar</span>
              <span class="no">✕ Oculto: no aparece en el Directorio (útil para pruebas o si deja de trabajar)</span></label>
          </section>

          <section class="h-adm-paso" id="a-enlace" hidden>
            <h3><span>5</span> Enlace privado del aliado</h3>
            <p class="h-adm-nota">Solo úsalo si el aliado <b>perdió su enlace</b> o si <b>alguien más lo tiene</b>. Se crea un enlace nuevo para mandarle y el viejo deja de abrir su panel.</p>
            <label class="h-adm-chip h-adm-chip-solo"><input type="checkbox" name="nuevoEnlace" /><span>Crear enlace nuevo al guardar</span></label>
          </section>

          <div class="h-adm-botones">
            <button class="h-btn" type="submit" id="a-guardar">Crear aliado</button>
            <button class="h-btn h-btn-line" type="button" id="a-cancelar" hidden>Cancelar</button>
          </div>
          <p class="h-form-err" role="alert" hidden></p>
        </form>
        <div class="h-form-ok" id="a-ok" hidden>
          <b>✓ Aliado guardado</b>
          <span id="a-ok-txt"></span>
          <a class="h-btn h-dir-wa" id="a-ok-wa" target="_blank" rel="noopener" hidden>Enviarle su enlace por WhatsApp</a>
        </div>
      </div>
    </main>
  </div>
</Base>

<script>
  const $ = <T extends HTMLElement>(s: string) => document.querySelector<T>(s)!;
  let K = ''; try { K = sessionStorage.getItem('celebra-admin') || ''; } catch {}
  let lista: any[] = [];
  const H = () => ({ 'x-celebra-key': K, 'content-type': 'application/json' });
  const el = (t: string, c?: string, x?: string) => { const e = document.createElement(t); if (c) e.className = c; if (x != null) e.textContent = x; return e; };

  async function cargar() {
    const r = await fetch('/api/admin/aliados', { headers: H() });
    if (!r.ok) throw new Error('Clave incorrecta');
    lista = (await r.json()).aliados;
    const ul = $('#a-lista'); ul.replaceChildren();
    if (!lista.length) ul.append(el('li', '', 'Aún no hay aliados.'));
    for (const a of lista) {
      const li = el('li', a.activo ? '' : 'oculto');
      const info = el('div', 'h-adm-info'); info.append(el('b', '', a.nombre));
      const tags = el('div', 'h-adm-tags');
      tags.append(el('span', 'h-adm-t ' + (a.plan === 'pro' ? 'pro' : 'gratis'), a.plan === 'pro' ? '★ Pro' : 'Gratis'));
      tags.append(el('span', 'h-adm-t ' + (a.activo ? 'vis' : 'ocu'), a.activo ? '✓ Visible' : '✕ Oculto del directorio'));
      if (!a.confirmadoActivo) tags.append(el('span', 'h-adm-t pend', 'Aún no entra a su panel'));
      info.append(tags); li.append(info);
      const ver = el('a', 'h-adm-ver', 'Ver su ficha') as HTMLAnchorElement; ver.href = '/reservar/?a=' + a.id; ver.target = '_blank'; li.append(ver);
      const ed = el('button', 'h-btn h-btn-line', 'Editar') as HTMLButtonElement; ed.type = 'button';
      ed.addEventListener('click', () => editar(a)); li.append(ed); ul.append(li);
    }
  }
  function editar(a: any) {
    const f = $<HTMLFormElement>('#a-form'); f.reset();
    (f.elements.namedItem('id') as HTMLInputElement).value = a.id;
    (f.elements.namedItem('nombre') as HTMLInputElement).value = a.nombre;
    (f.elements.namedItem('whatsapp') as HTMLInputElement).value = a.whatsapp;
    f.querySelectorAll<HTMLInputElement>('input[name=plan]').forEach((c) => (c.checked = c.value === (a.plan || 'gratis')));
    if (a.descripcion) (f.elements.namedItem('descripcion') as HTMLTextAreaElement).value = a.descripcion;
    if (a.zona) (f.elements.namedItem('zona') as HTMLInputElement).value = a.zona;
    (f.elements.namedItem('activo') as HTMLInputElement).checked = a.activo;
    f.querySelectorAll<HTMLInputElement>('input[name=cat]').forEach((c) => (c.checked = a.categorias.includes(c.value)));
    $('#a-tit').textContent = 'Editar: ' + a.nombre; modo(true); $('#a-ok').hidden = true; f.scrollIntoView({ behavior: 'smooth' });
  }
  function modo(editando: boolean) {
    $('#a-enlace').hidden = !editando; $('#a-cancelar').hidden = !editando;
    $('#a-guardar').textContent = editando ? 'Guardar cambios' : 'Crear aliado';
    if (!editando) $('#a-tit').textContent = 'Crear un aliado nuevo';
  }
  $('#a-cancelar').addEventListener('click', () => { $<HTMLFormElement>('#a-form').reset(); (($('#a-form') as HTMLFormElement).elements.namedItem('id') as HTMLInputElement).value = ''; modo(false); });

  $<HTMLFormElement>('#k-form').addEventListener('submit', async (e) => {
    e.preventDefault(); K = String(new FormData(e.target as HTMLFormElement).get('k') || '');
    try { await cargar(); try { sessionStorage.setItem('celebra-admin', K); } catch {} $('#k-form').hidden = true; $('#adm').hidden = false; }
    catch (x) { const er = $('#k-form .h-form-err'); er.textContent = (x as Error).message; er.hidden = false; }
  });

  $<HTMLFormElement>('#a-form').addEventListener('submit', async (e) => {
    e.preventDefault(); const f = e.target as HTMLFormElement, fd = new FormData(f), er = f.querySelector<HTMLElement>('.h-form-err')!;
    const body: any = { id: fd.get('id') || undefined, nombre: fd.get('nombre'), whatsapp: fd.get('whatsapp'), categorias: fd.getAll('cat'),
      plan: fd.get('plan'), activo: !!fd.get('activo'), nuevoEnlace: !!fd.get('nuevoEnlace') };
    if (String(fd.get('descripcion') || '')) body.descripcion = fd.get('descripcion');
    if (String(fd.get('zona') || '')) body.zona = fd.get('zona');
    const r = await fetch('/api/admin/aliados', { method: 'POST', headers: H(), body: JSON.stringify(body) });
    const d = await r.json(); if (!r.ok) { er.textContent = d.error; er.hidden = false; return; }
    er.hidden = true; $('#a-ok').hidden = false;
    const wa = $<HTMLAnchorElement>('#a-ok-wa');
    if (d.enlace) {
      $('#a-ok-txt').textContent = 'Enlace privado: ' + d.enlace;
      const msg = `¡Hola! Ya eres aliado de Celebra 🎉 Este es tu panel privado para cargar tus servicios, precios, fotos y días disponibles, y ver tus reservas:\n${d.enlace}\n\nGuárdalo y no lo compartas: es tu llave.`;
      wa.href = `https://wa.me/${String(fd.get('whatsapp')).replace(/\D/g, '')}?text=${encodeURIComponent(msg)}`; wa.hidden = false;
    } else { $('#a-ok-txt').textContent = 'Cambios guardados (el enlace privado sigue siendo el mismo).'; wa.hidden = true; }
    f.reset(); (f.elements.namedItem('id') as HTMLInputElement).value = ''; modo(false); $('#a-ok').scrollIntoView({ behavior: 'smooth', block: 'center' }); await cargar();
  });

  if (K) cargar().then(() => { $('#k-form').hidden = true; $('#adm').hidden = false; }).catch(() => {});
</script>
